            let output: List<T> = []
            for row in rows:
                output.append(RowType.parse(row))
            return output
        catch error:
            throw sqliteFailure(error, "raw.all")

    async def prepare(sql: string) -> Statement:
        try:
            return Statement(await self.native.prepare(sql))
        catch error:
            throw sqliteFailure(error, "prepare")

    override async def close():
        try:
            await self.native.close()
        catch error:
            throw sqliteFailure(error, "close")

export type Database = SqliteDatabase

export async def open(path: string, options: SqliteOptions = {}) -> SqliteDatabase:
    try:
        return SqliteDatabase(await openNative(path, options))
    catch error:
        throw sqliteFailure(error, "open")
