export class SqliteError extends DatabaseError:
    const sqliteCode: string?

    constructor(message: string = "SQLite operation failed", sqliteCode: string? = null, operation: string = "unknown", retryable: bool = false):
        super(message, sqliteCode ?? "SQLITE_ERROR", operation, retryable)
        self.sqliteCode = sqliteCode

export class SqliteBackpressureError extends DatabaseBackpressureError:
    constructor(message: string = "SQLite queue is full", operation: string = "queue"):
        super(message, operation)

export class SqliteConcurrencyError extends DatabaseConcurrencyError:
    constructor(message: string = "SQLite handle is already executing", operation: string = "concurrency"):
        super(message, operation)

def sqliteFailure(error: Error, operation: string) -> DatabaseError:
    if error is NativeBackpressureError:
        return SqliteBackpressureError(error.message, error.operation)
    if error is NativeConcurrencyError:
        return SqliteConcurrencyError(error.message, error.operation)
    if error is NativeSqliteError:
        return SqliteError(error.message, error.sqliteCode, error.operation, error.retryable)
    return SqliteError(error.message, null, operation)

export class Statement:
    private const native: NativeStatement

    constructor(native: NativeStatement):
        self.native = native

    async def execute(params: List<unknown> = []) -> number:
        try:
            return await self.native.rawExecute(params)
        catch error:
            throw sqliteFailure(error, "statement.execute")

    async def one<T>(params: List<unknown>, RowType: Type<T>) -> T?:
        try:
            const row = await self.native.rawOne(params)
            if row == null:
                return null
            return RowType.parse(row)
        catch error:
            throw sqliteFailure(error, "statement.one")

    async def all<T>(params: List<unknown>, RowType: Type<T>) -> List<T>:
        try:
            const rows = await self.native.rawAll(params)
            let output: List<T> = []
            for row in rows:
                output.append(RowType.parse(row))
            return output
        catch error:
            throw sqliteFailure(error, "statement.all")

    async def close():
        try:
            await self.native.close()
        catch error:
            throw sqliteFailure(error, "statement.close")

    @dispose:
        await self.close()

export class Transaction extends DatabaseTransactionContract:
    private const native: NativeTransaction

    constructor(native: NativeTransaction):
        super()
        self.native = native

    override async def executeQuery(plan: readonly DatabaseQueryPlan) -> List<unknown>:
        try:
            return await self.native.executeQuery(plan)
        catch error:
            throw sqliteFailure(error, "query")

    override async def streamQuery(plan: readonly DatabaseQueryPlan, consume: (unknown) -> Promise<null>):
        try:
            await self.native.streamQuery(plan, consume)
        catch error:
            throw sqliteFailure(error, "stream")

    override async def executeMutation(plan: readonly DatabaseMutationPlan) -> DatabaseMutationResult:
        try:
            return await self.native.executeMutation(plan)
        catch error:
            throw sqliteFailure(error, "mutation")

    async def execute(sql: string, params: List<unknown> = []) -> number:
        try:
            return await self.native.rawExecute(sql, params)
        catch error:
            throw sqliteFailure(error, "raw.execute")

    async def one<T>(sql: string, params: List<unknown>, RowType: Type<T>) -> T?:
        try:
            const row = await self.native.rawOne(sql, params)
            if row == null:
                return null
            return RowType.parse(row)
        catch error:
            throw sqliteFailure(error, "raw.one")

    async def all<T>(sql: string, params: List<unknown>, RowType: Type<T>) -> List<T>:
        try:
            const rows = await self.native.rawAll(sql, params)
            let output: List<T> = []
            for row in rows:
                output.append(RowType.parse(row))
            return output
        catch error:
            throw sqliteFailure(error, "raw.all")

    async def prepare(sql: string) -> Statement:
        try:
            return Statement(await self.native.prepare(sql))
        catch error:
            throw sqliteFailure(error, "prepare")

    override async def commit():
        try:
            await self.native.commit()
        catch error:
            throw sqliteFailure(error, "commit")

    override async def rollback():
        try:
            await self.native.rollback()
        catch error:
            throw sqliteFailure(error, "rollback")

export class SqliteDatabase extends DatabaseContract:
    private const native: NativeDatabase
    private const sqliteCapabilities: DatabaseCapabilities = {
