import {Database as DatabaseContract, DatabaseBackpressureError, DatabaseCapabilities, DatabaseConcurrencyError, DatabaseError, DatabaseMigrationResult, DatabaseMutationPlan, DatabaseMutationResult, DatabaseQueryPlan, DatabaseSchema, DatabaseTransaction as DatabaseTransactionContract} from "@velarscript/database"

/// Per-connection memory, queue, and statement-cache budgets.
export type SqliteOptions:
    busyTimeout: number?
    queueCapacity: number?
    maxRows: number?
    maxResultBytes: number?
    streamBatchRows: number?
    maxRowBytes: number?
    statementCacheCapacity: number?

extern js()`
    import { Worker } from "node:worker_threads";

    const TOKEN = Object.freeze({});
    const databaseStates = new WeakMap();
    const statementStates = new WeakMap();
    const transactionStates = new WeakMap();

    export class NativeSqliteError extends Error {
      constructor(message = "SQLite operation failed", sqliteCode = null, operation = "unknown", retryable = false) {
        super(message);
        this.name = "NativeSqliteError";
        this.sqliteCode = sqliteCode;
        this.operation = operation;
        this.retryable = retryable;
      }
    }

    export class NativeBackpressureError extends NativeSqliteError {
      constructor(message = "SQLite queue is full", operation = "queue") {
        super(message, "SQLITE_BACKPRESSURE", operation, true);
        this.name = "NativeBackpressureError";
      }
    }

    export class NativeConcurrencyError extends NativeSqliteError {
      constructor(message = "SQLite handle is already executing", operation = "concurrency") {
        super(message, "SQLITE_CONCURRENCY", operation, true);
        this.name = "NativeConcurrencyError";
      }
    }

    function workerMain() {
      const { createHash } = require("node:crypto");
      const { parentPort, workerData } = require("node:worker_threads");
      const { DatabaseSync } = require("node:sqlite");
      const database = new DatabaseSync(workerData.path, { timeout: workerData.busyTimeout });
      database.exec("PRAGMA foreign_keys = ON");
      const statements = new Map();
      const cache = new Map();
      const acknowledgements = new Map();
      let nextStatement = 1;
      let transaction = 0;
      let closed = false;
      let tail = Promise.resolve();

      function fail(message, code = "SQLITE_ERROR", operation = "unknown", retryable = false) {
        const error = new Error(message);
        error.code = code;
        error.operation = operation;
        error.retryable = retryable;
        return error;
      }

      function integer(value, minimum, maximum, label) {
        if (!Number.isSafeInteger(value) || value < minimum || value > maximum) throw fail(label + " must be an integer from " + minimum + " through " + maximum, "SQLITE_INPUT", label);
        return value;
      }

      function identifier(value, label) {
        if (typeof value !== "string" || !/^[A-Za-z_][A-Za-z0-9_]{0,127}$/.test(value) || value.startsWith("__velar_")) throw fail(label + " is not a portable database identifier", "SQLITE_INPUT", label);
        return value;
      }

      function quote(value, label) {
        return "\"" + identifier(value, label).replaceAll("\"", "\"\"") + "\"";
      }

      function ownRecord(value, label, maximum = 1000000) {
        if (value === null || typeof value !== "object" || Array.isArray(value) || Object.getPrototypeOf(value) !== Object.prototype && Object.getPrototypeOf(value) !== null) throw fail(label + " must be a plain record", "SQLITE_INPUT", label);
        const keys = Object.keys(value);
        if (keys.length > maximum) throw fail(label + " exceeds its field limit", "SQLITE_INPUT", label);
        return keys;
      }

      function modelDefinition(value) {
        ownRecord(value, "model", 3);
        const name = identifier(value.name, "model name");
        const fieldNames = ownRecord(value.fields, "model fields", 1024);
        if (fieldNames.length === 0) throw fail("A model requires at least one field", "SQLITE_INPUT", "model");
        for (const fieldName of fieldNames) {
          identifier(fieldName, "field name");
          fieldDefinition(value.fields[fieldName]);
        }
        if (!Array.isArray(value.indexes) || value.indexes.length > 128) throw fail("model indexes must be a bounded List", "SQLITE_INPUT", "model");
        return { value, name, fieldNames };
      }

      function fieldDefinition(value) {
        ownRecord(value, "field", 7);
        if (!["text", "integer", "real", "boolean", "bytes", "json"].includes(value.kind)) throw fail("Unknown database field kind", "SQLITE_INPUT", "field");
        for (const name of ["nullable", "primary", "unique", "generated"]) if (typeof value[name] !== "boolean") throw fail("Database field " + name + " must be bool", "SQLITE_INPUT", "field");
        if (value.primary && value.nullable) throw fail("A primary field cannot be nullable", "SQLITE_INPUT", "field");
        if (value.generated && (value.kind !== "integer" || !value.primary)) throw fail("A generated field must be an integer primary field", "SQLITE_INPUT", "field");
        return value;
      }

      function fieldOf(model, name) {
        identifier(name, "field name");
        if (!Object.hasOwn(model.value.fields, name)) throw fail("Model '" + model.name + "' has no field '" + name + "'", "SQLITE_INPUT", "field");
        return model.value.fields[name];
      }

      function sql(value) {
        if (typeof value !== "string" || value.length === 0 || value.length > 1024 * 1024) throw fail("SQLite SQL must be non-empty text no longer than 1 MiB", "SQLITE_INPUT", "sql");
        return value;
      }

      function params(value) {
        if (!Array.isArray(value) || value.length > workerData.maxParameters) throw fail("SQLite parameters must be a bounded List", "SQLITE_INPUT", "params");
        return value;
      }

      function encodeValue(field, value) {
        if (value === null) {
          if (!field.nullable && !field.generated) throw fail("A non-null database field received null", "SQLITE_INPUT", "value");
          return null;
        }
        if (field.kind === "text") {
          if (typeof value !== "string") throw fail("A text database field requires string", "SQLITE_INPUT", "value");
          return value;
        }
        if (field.kind === "integer") {
          if (!Number.isSafeInteger(value)) throw fail("An integer database field requires a safe integer", "SQLITE_INPUT", "value");
          return value;
        }
        if (field.kind === "real") {
          if (typeof value !== "number" || !Number.isFinite(value)) throw fail("A real database field requires a finite number", "SQLITE_INPUT", "value");
          return value;
        }
        if (field.kind === "boolean") {
          if (typeof value !== "boolean") throw fail("A boolean database field requires bool", "SQLITE_INPUT", "value");
          return value ? 1 : 0;
        }
        if (field.kind === "bytes") {
          if (!(value instanceof Uint8Array)) throw fail("A bytes database field requires Bytes", "SQLITE_INPUT", "value");
          return value;
        }
        if (field.kind === "json") return JSON.stringify(value);
        throw fail("Unknown database field kind", "SQLITE_INPUT", "value");
      }

      function decodeValue(field, value) {
        if (value === null) return null;
        if (field.kind === "boolean") {
          if (value !== 0 && value !== 1) throw fail("SQLite returned a non-boolean stored value", "SQLITE_RESULT", "decode");
          return value === 1;
        }
        if (field.kind === "json") {
          if (typeof value !== "string") throw fail("SQLite returned a non-text JSON value", "SQLITE_RESULT", "decode");
          return JSON.parse(value);
        }
        if (field.kind === "bytes") {
          if (!(value instanceof Uint8Array)) throw fail("SQLite returned a non-bytes BLOB value", "SQLITE_RESULT", "decode");
          return value;
        }
        if (field.kind === "integer" && !Number.isSafeInteger(value)) throw fail("SQLite returned an unsafe integer", "SQLITE_RESULT", "decode");
        if (field.kind === "real" && (typeof value !== "number" || !Number.isFinite(value))) throw fail("SQLite returned a non-finite real", "SQLITE_RESULT", "decode");
        if (field.kind === "text" && typeof value !== "string") throw fail("SQLite returned a non-text value", "SQLITE_RESULT", "decode");
        return value;
      }

      function decodeRow(model, row) {
        if (row === null) return null;
        ownRecord(row, "row", 1024);
        const output = Object.create(null);
        for (const name of model.fieldNames) output[name] = decodeValue(model.value.fields[name], row[name] ?? null);
        return output;
      }

      function escapeLike(value) {
        if (typeof value !== "string") throw fail("A text filter requires string", "SQLITE_INPUT", "filter");
        return value.replaceAll("\\", "\\\\").replaceAll("%", "\\%").replaceAll("_", "\\_");
      }

      function compileFilter(model, filter, output, depth = 0, counter = { value: 0 }) {
        if (depth > 64 || ++counter.value > 1000) throw fail("Database filter exceeds its structural limit", "SQLITE_INPUT", "filter");
        ownRecord(filter, "filter", 6);
        if (filter.model !== model.name) throw fail("Database filter belongs to another model", "SQLITE_INPUT", "filter");
        const kind = filter.kind;
        if (kind === "all" || kind === "any" || kind === "not") {
          if (!Array.isArray(filter.filters) || filter.filters.length === 0 || filter.filters.length > 1000) throw fail("Grouped filter must contain a bounded non-empty List", "SQLITE_INPUT", "filter");
          if (kind === "not" && filter.filters.length !== 1) throw fail("not filter requires exactly one child", "SQLITE_INPUT", "filter");
          const compiled = filter.filters.map(item => compileFilter(model, item, output, depth + 1, counter));
          if (kind === "not") return "(NOT " + compiled[0] + ")";
          return "(" + compiled.join(kind === "all" ? " AND " : " OR ") + ")";
        }
        const name = filter.field;
        const field = fieldOf(model, name);
        const column = quote(name, "field name");
        if (kind === "isNull") return column + " IS NULL";
        if (kind === "isNotNull") return column + " IS NOT NULL";
        if (kind === "oneOf") {
          if (!Array.isArray(filter.values) || filter.values.length === 0 || filter.values.length > workerData.maxParameters) throw fail("oneOf filter exceeds the SQLite parameter limit", "SQLITE_INPUT", "filter");
          for (const value of filter.values) output.push(encodeValue(field, value));
          return column + " IN (" + filter.values.map(() => "?").join(", ") + ")";
        }
        const value = filter.value;
        if (kind === "equal" && value === null) return column + " IS NULL";
        if (kind === "notEqual" && value === null) return column + " IS NOT NULL";
        if (["contains", "startsWith", "endsWith"].includes(kind)) {
          const escaped = escapeLike(value);
          output.push(kind === "contains" ? "%" + escaped + "%" : kind === "startsWith" ? escaped + "%" : "%" + escaped);
          return column + " LIKE ? ESCAPE '\\'";
        }
        const operators = { equal: "=", notEqual: "!=", lessThan: "<", lessOrEqual: "<=", greaterThan: ">", greaterOrEqual: ">=" };
        const operator = operators[kind];
        if (!operator) throw fail("Unknown database filter operation", "SQLITE_INPUT", "filter");
        output.push(encodeValue(field, value));
        return column + " " + operator + " ?";
      }

      function selectPlan(plan, streaming) {
        ownRecord(plan, "query plan", 5);
        const model = modelDefinition(plan.model);
        const values = [];
        let text = "SELECT " + model.fieldNames.map(name => quote(name, "field name")).join(", ") + " FROM " + quote(model.name, "model name");
        if (plan.where !== null && plan.where !== undefined) text += " WHERE " + compileFilter(model, plan.where, values);
        if (!Array.isArray(plan.orderBy) || plan.orderBy.length > 64) throw fail("query orderBy must be a bounded List", "SQLITE_INPUT", "query");
        if (plan.orderBy.length > 0) {
          const order = plan.orderBy.map(item => {
            ownRecord(item, "query order", 3);
            if (item.model !== model.name) throw fail("Query order belongs to another model", "SQLITE_INPUT", "query");
            fieldOf(model, item.field);
            if (item.direction !== "ascending" && item.direction !== "descending") throw fail("Unknown query order direction", "SQLITE_INPUT", "query");
            return quote(item.field, "field name") + (item.direction === "ascending" ? " ASC" : " DESC");
          });
          text += " ORDER BY " + order.join(", ");
        }
        const offset = integer(plan.offset ?? 0, 0, 1000000000, "query offset");
        if (plan.limit !== null && plan.limit !== undefined) {
          const maximum = streaming ? 1000000 : workerData.maxRows;
          const limit = integer(plan.limit, 0, maximum, "query limit");
          text += " LIMIT " + limit;
        } else if (!streaming) text += " LIMIT " + (workerData.maxRows + 1);
        else if (offset > 0) text += " LIMIT -1";
        if (offset > 0) text += " OFFSET " + offset;
        if (values.length > workerData.maxParameters) throw fail("Query exceeds the SQLite parameter limit", "SQLITE_INPUT", "query");
        return { sql: text, values, model };
      }

      function mutationPlan(plan) {
        ownRecord(plan, "mutation plan", 5);
        const model = modelDefinition(plan.model);
        if (plan.kind === "insert") {
          ownRecord(plan.value, "insert value", 1024);
          const names = [];
          const values = [];
          for (const name of model.fieldNames) {
            const field = model.value.fields[name];
            if (field.generated && !Object.hasOwn(plan.value, name)) continue;
            if (!Object.hasOwn(plan.value, name)) {
              if (field.defaultValue !== null && field.defaultValue !== undefined) continue;
              if (field.nullable) continue;
              throw fail("Insert is missing field '" + name + "'", "SQLITE_INPUT", "insert");
            }
            names.push(name);
            values.push(encodeValue(field, plan.value[name]));
          }
          if (values.length > workerData.maxParameters) throw fail("Insert exceeds the SQLite parameter limit", "SQLITE_INPUT", "insert");
          if (names.length === 0) return { sql: "INSERT INTO " + quote(model.name, "model name") + " DEFAULT VALUES", values };
          return { sql: "INSERT INTO " + quote(model.name, "model name") + " (" + names.map(name => quote(name, "field name")).join(", ") + ") VALUES (" + names.map(() => "?").join(", ") + ")", values };
        }
        if (plan.kind === "update") {
          const names = ownRecord(plan.changes, "update changes", 1024);
          if (names.length === 0) throw fail("Update requires at least one field", "SQLITE_INPUT", "update");
          const values = [];
          const assignments = names.map(name => {
            const field = fieldOf(model, name);
            if (field.generated || field.primary) throw fail("Update cannot change generated or primary field '" + name + "'", "SQLITE_INPUT", "update");
            values.push(encodeValue(field, plan.changes[name]));
            return quote(name, "field name") + " = ?";
          });
          if (plan.where === null || plan.where === undefined) throw fail("Update requires an explicit filter", "SQLITE_INPUT", "update");
          const where = compileFilter(model, plan.where, values);
          if (values.length > workerData.maxParameters) throw fail("Update exceeds the SQLite parameter limit", "SQLITE_INPUT", "update");
          return { sql: "UPDATE " + quote(model.name, "model name") + " SET " + assignments.join(", ") + " WHERE " + where, values };
        }
        if (plan.kind === "delete") {
          if (plan.where === null || plan.where === undefined) throw fail("Delete requires an explicit filter", "SQLITE_INPUT", "delete");
          const values = [];
          const where = compileFilter(model, plan.where, values);
          if (values.length > workerData.maxParameters) throw fail("Delete exceeds the SQLite parameter limit", "SQLITE_INPUT", "delete");
          return { sql: "DELETE FROM " + quote(model.name, "model name") + " WHERE " + where, values };
        }
        throw fail("Unknown database mutation", "SQLITE_INPUT", "mutation");
      }

      function sqlLiteral(field, value) {
        const encoded = encodeValue({ ...field, nullable: true }, value);
        if (encoded === null) return "NULL";
        if (typeof encoded === "number") return String(encoded);
        if (typeof encoded === "string") return "'" + encoded.replaceAll("'", "''") + "'";
        if (encoded instanceof Uint8Array) return "X'" + Buffer.from(encoded).toString("hex") + "'";
        throw fail("Unsupported migration default value", "SQLITE_INPUT", "migration");
      }

      function referenceSql(reference) {
        if (reference === null || reference === undefined) return "";
        ownRecord(reference, "reference", 4);
        const actions = { restrict: "RESTRICT", cascade: "CASCADE", setNull: "SET NULL" };
        const onDelete = actions[reference.onDelete];
        const onUpdate = actions[reference.onUpdate];
        if (!onDelete || !onUpdate) throw fail("Unknown reference action", "SQLITE_INPUT", "migration");
        return " REFERENCES " + quote(reference.model, "referenced model") + " (" + quote(reference.field, "referenced field") + ") ON DELETE " + onDelete + " ON UPDATE " + onUpdate;
      }

      function columnSql(name, field) {
        fieldDefinition(field);
        const storage = { text: "TEXT", integer: "INTEGER", real: "REAL", boolean: "INTEGER", bytes: "BLOB", json: "TEXT" }[field.kind];
        let text = quote(name, "field name") + " " + storage;
        if (field.generated) text += " PRIMARY KEY AUTOINCREMENT";
        else {
          if (field.primary) text += " PRIMARY KEY";
          if (!field.nullable) text += " NOT NULL";
        }
        if (field.unique && !field.primary) text += " UNIQUE";
        if (field.defaultValue !== null && field.defaultValue !== undefined) text += " DEFAULT " + sqlLiteral(field, field.defaultValue);
        return text + referenceSql(field.reference);
      }

      function indexSql(modelName, value) {
        ownRecord(value, "index", 3);
        identifier(value.name, "index name");
        if (!Array.isArray(value.fields) || value.fields.length === 0 || value.fields.length > 32) throw fail("Index fields must be a bounded non-empty List", "SQLITE_INPUT", "migration");
        return "CREATE " + (value.unique ? "UNIQUE " : "") + "INDEX " + quote(value.name, "index name") + " ON " + quote(modelName, "model name") + " (" + value.fields.map(name => quote(name, "index field")).join(", ") + ")";
      }

      function applyStep(step) {
        ownRecord(step, "migration step", 7);
        if (step.kind === "createModel") {
          const model = modelDefinition(step.model);
          database.exec("CREATE TABLE " + quote(model.name, "model name") + " (" + model.fieldNames.map(name => columnSql(name, model.value.fields[name])).join(", ") + ")");
          for (const item of model.value.indexes) database.exec(indexSql(model.name, item));
          return;
        }
        if (step.kind === "dropModel") {
          if (step.destructive !== true) throw fail("Dropping a model requires destructive=true", "SQLITE_INPUT", "migration");
          database.exec("DROP TABLE " + quote(step.modelName, "model name"));
          return;
        }
        if (step.kind === "addField") {
          database.exec("ALTER TABLE " + quote(step.modelName, "model name") + " ADD COLUMN " + columnSql(step.fieldName, step.field));
          return;
        }
        if (step.kind === "dropField") {
          if (step.destructive !== true) throw fail("Dropping a field requires destructive=true", "SQLITE_INPUT", "migration");
          database.exec("ALTER TABLE " + quote(step.modelName, "model name") + " DROP COLUMN " + quote(step.fieldName, "field name"));
          return;
        }
        if (step.kind === "createIndex") {
          database.exec(indexSql(step.modelName, step.index));
          return;
        }
        if (step.kind === "dropIndex") {
          database.exec("DROP INDEX " + quote(step.index.name, "index name"));
          return;
        }
        throw fail("Unknown migration step", "SQLITE_INPUT", "migration");
      }

      function canonical(value) {
        if (value === null || typeof value !== "object") return JSON.stringify(value);
        if (value instanceof Uint8Array) return JSON.stringify(Array.from(value));
        if (Array.isArray(value)) return "[" + value.map(canonical).join(",") + "]";
        return "{" + Object.keys(value).sort().map(key => JSON.stringify(key) + ":" + canonical(value[key])).join(",") + "}";
      }

      function fingerprint(value) {
        return createHash("sha256").update(canonical(value)).digest("hex");
      }

      function migrate(schema) {
        ownRecord(schema, "schema", 4);
        identifier(schema.name, "schema name");
        integer(schema.version, 0, 1000000, "schema version");
        if (!Array.isArray(schema.migrations) || schema.migrations.length !== schema.version) throw fail("Schema migrations must be contiguous", "SQLITE_INPUT", "migration");
        database.exec("BEGIN IMMEDIATE");
        try {
          database.exec("CREATE TABLE IF NOT EXISTS \"__velar_migrations\" (\"schema_name\" TEXT NOT NULL, \"version\" INTEGER NOT NULL, \"fingerprint\" TEXT NOT NULL, PRIMARY KEY (\"schema_name\", \"version\"))");
          const applied = database.prepare("SELECT version, fingerprint FROM \"__velar_migrations\" WHERE schema_name = ? ORDER BY version").all(schema.name);
          const previousVersion = applied.length === 0 ? 0 : Number(applied[applied.length - 1].version);
          if (previousVersion > schema.version) throw fail("Database schema is newer than the application", "SQLITE_SCHEMA_NEWER", "migration");
          for (let index = 0; index < applied.length; index += 1) {
            const row = applied[index];
            const migration = schema.migrations[Number(row.version) - 1];
            if (!migration || Number(row.version) !== index + 1 || row.fingerprint !== fingerprint(migration)) throw fail("Applied database migration history does not match the application", "SQLITE_MIGRATION_DRIFT", "migration");
          }
          const insert = database.prepare("INSERT INTO \"__velar_migrations\" (schema_name, version, fingerprint) VALUES (?, ?, ?)");
          let count = 0;
          for (let version = previousVersion + 1; version <= schema.version; version += 1) {
            const migration = schema.migrations[version - 1];
            if (!migration || migration.version !== version || !Array.isArray(migration.steps) || migration.steps.length === 0 || migration.steps.length > 1000) throw fail("Schema migration " + version + " is invalid", "SQLITE_INPUT", "migration");
            for (const step of migration.steps) applyStep(step);
            insert.run(schema.name, version, fingerprint(migration));
            count += 1;
          }
          database.exec("COMMIT");
          return { previousVersion, version: schema.version, applied: count };
        } catch (error) {
          try { database.exec("ROLLBACK"); } catch {}
          throw error;
        }
      }

      function statement(id, transactionId) {
        const item = statements.get(id);
        if (!item) throw fail("SQLite statement is closed", "SQLITE_CLOSED", "statement");
        if (item.transaction !== transactionId) throw fail("SQLite statement belongs to another transaction", "SQLITE_TRANSACTION", "statement");
        return item.statement;
      }

      function cached(sqlText) {
        const found = cache.get(sqlText);
        if (found) {
          cache.delete(sqlText);
          cache.set(sqlText, found);
          return found;
        }
        const prepared = database.prepare(sqlText);
        cache.set(sqlText, prepared);
        if (cache.size > workerData.statementCacheCapacity) cache.delete(cache.keys().next().value);
        return prepared;
      }

      function transactionId(value) {
        if (value === 0) {
          if (transaction !== 0) throw fail("Use the active Transaction while a transaction is open", "SQLITE_TRANSACTION", "transaction");
          return;
        }
        if (value !== transaction) throw fail("SQLite transaction is no longer active", "SQLITE_TRANSACTION", "transaction");
      }

      function normalize(value, transfers, seen = new WeakSet()) {
        if (value === null || typeof value === "string" || typeof value === "boolean" || typeof value === "number") return value;
        if (typeof value === "bigint") {
          const number = Number(value);
          if (!Number.isSafeInteger(number)) throw fail("SQLite returned an integer outside VelarScript's safe range", "SQLITE_RESULT", "decode");
          return number;
        }
        if (value instanceof Uint8Array) {
          const bytes = new Uint8Array(value.byteLength);
          bytes.set(value);
          transfers.push(bytes.buffer);
          return bytes;
        }
        if (typeof value !== "object") throw fail("SQLite returned unsupported data", "SQLITE_RESULT", "decode");
        if (seen.has(value)) throw fail("SQLite returned cyclic data", "SQLITE_RESULT", "decode");
        seen.add(value);
        if (Array.isArray(value)) return value.map(item => normalize(item, transfers, seen));
        const output = Object.create(null);
        for (const key of Object.keys(value)) output[key] = normalize(value[key], transfers, seen);
        return output;
      }

      function resultSize(value, seen = new WeakSet()) {
        if (value === null) return 4;
        if (typeof value === "string") return Buffer.byteLength(value, "utf8");
        if (typeof value === "number" || typeof value === "boolean") return 8;
        if (value instanceof Uint8Array) return value.byteLength;
        if (typeof value !== "object" || seen.has(value)) return 0;
        seen.add(value);
        if (Array.isArray(value)) return value.reduce((sum, item) => sum + resultSize(item, seen), 0);
        return Object.entries(value).reduce((sum, pair) => sum + Buffer.byteLength(pair[0], "utf8") + resultSize(pair[1], seen), 0);
      }

      function boundedOne(value) {
        if (value === null || value === undefined) return value;
        const bytes = resultSize(value);
        if (bytes > workerData.maxRowBytes) throw fail("SQLite row exceeds maxRowBytes", "SQLITE_RESULT_LIMIT", "query");
        if (bytes > workerData.maxResultBytes) throw fail("SQLite result exceeds maxResultBytes", "SQLITE_RESULT_LIMIT", "query");
        return value;
      }

      function collectRows(target, values, decode) {
        const rows = [];
        let bytes = 0;
        for (const row of target.iterate(...values)) {
          if (rows.length >= workerData.maxRows) throw fail("SQLite result exceeds maxRows", "SQLITE_RESULT_LIMIT", "query");
          const decoded = decode(row);
          const rowBytes = resultSize(decoded);
          if (rowBytes > workerData.maxRowBytes) throw fail("SQLite row exceeds maxRowBytes", "SQLITE_RESULT_LIMIT", "query");
          if (bytes + rowBytes > workerData.maxResultBytes) throw fail("SQLite result exceeds maxResultBytes", "SQLITE_RESULT_LIMIT", "query");
          rows.push(decoded);
          bytes += rowBytes;
        }
        return rows;
      }

      function acknowledge(id, rows, transfers) {
        return new Promise((resolve, reject) => {
          acknowledgements.set(id, { resolve, reject });
          parentPort.postMessage({ id, stream: true, rows }, transfers);
        });
      }

      async function streamRows(message, target, values, decode) {
        let batch = [];
        let batchBytes = 0;
        for (const row of target.iterate(...values)) {
          const decoded = decode(row);
          const bytes = resultSize(decoded);
