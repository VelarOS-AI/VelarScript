        return self.sqliteCapabilities

    override async def executeQuery(plan: readonly DatabaseQueryPlan) -> List<unknown>:
        try:
            return await self.native.executeQuery(plan)
        catch error:
            throw sqliteFailure(error, "query")

    override async def streamQuery(plan: readonly DatabaseQueryPlan, consume: (unknown) -> Promise<null>):
        try:
            await self.native.streamQuery(plan, consume)
        catch error:
            throw sqliteFailure(error, "stream")

    override async def executeMutation(plan: readonly DatabaseMutationPlan) -> DatabaseMutationResult:
        try:
            return await self.native.executeMutation(plan)
        catch error:
            throw sqliteFailure(error, "mutation")

