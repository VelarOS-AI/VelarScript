            const normalized = normalize(batch, transfers);
            const keepGoing = await acknowledge(message.id, normalized, transfers);
            if (!keepGoing) return;
            batch = [];
            batchBytes = 0;
          }
          batch.push(decoded);
          batchBytes += bytes;
          if (batch.length >= workerData.streamBatchRows || batchBytes >= workerData.maxRowBytes) {
            const transfers = [];
            const normalized = normalize(batch, transfers);
            const keepGoing = await acknowledge(message.id, normalized, transfers);
            if (!keepGoing) return;
            batch = [];
            batchBytes = 0;
          }
        }
        if (batch.length > 0) {
          const transfers = [];
          const normalized = normalize(batch, transfers);
          await acknowledge(message.id, normalized, transfers);
