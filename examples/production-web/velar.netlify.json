{
  "formatVersion": 1,
  "entry": "src/main.vel",
  "outDir": "dist-netlify",
  "publicDir": "public",
  "web": {
    "title": "Velar Release Studio",
    "base": "/",
    "publicConfig": {
      "apiBase": "/api",
      "releaseChannel": "preview",
      "canonicalUrl": "https://velar.example/",
      "socialImage": "/share.svg",
      "features": {
        "recovery": true
      }
    },
    "build": {
      "sourceMaps": false
    },
    "security": {
      "contentSecurityPolicy": true,
      "connectSources": [],
      "imageSources": []
    },
    "deployment": {
      "spaFallback": true,
      "adapter": "netlify"
    }
  }
}
