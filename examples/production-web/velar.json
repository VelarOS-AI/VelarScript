{
  "formatVersion": 2,
  "entry": "src/main.vel",
  "outDir": "dist",
  "publicDir": "public",
  "extensions": ["@velarscript/web"],
  "web": {
    "title": "Velar Release Studio",
    "base": "/app/",
    "publicConfig": {
      "apiBase": "/api",
      "releaseChannel": "preview",
      "canonicalUrl": "https://velar.example/app/",
      "socialImage": "/app/share.svg",
      "features": {
        "recovery": true
      }
    },
    "build": {
      "sourceMaps": true
    },
    "security": {
      "contentSecurityPolicy": true,
      "connectSources": [],
      "imageSources": []
    },
    "deployment": {
      "spaFallback": true
    }
  }
}
