import {expect} from "velar/test"
import {dark, setTheme, theme} from "./store.vel"

test "theme store":
    setTheme("dark")
    expect(theme).toBe("dark")
    expect(dark()).toBe(true)
    expect({theme: theme, values: [1, 2]}).toEqual({theme: "dark", values: [1, 2]})
    expect([theme, "light"]).toContain("dark")
    expect("VelarScript 0.10").toMatch("0\\.10")
    expect([1, 2]).toHaveLength(2)
