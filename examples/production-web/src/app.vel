import {NavLink, RouteContext, Router, lazy, route} from "velar/web"
import {Home} from "./pages/home.vel"
import {ConstructionFailure} from "./pages/construction-failure.vel"

component RouteLoading:
    return <main aria-busy="true"><p>Loading page…</p></main>

component RouteFailed(error: Error):
    return <main role="alert"><h1>Page unavailable</h1><p>{error.message}</p></main>

component RouteNotFound(route: RouteContext):
    return <main data-route-not-found><h1>Page not found</h1><p>No Release Studio page matches {route.path}.</p></main>

const About = lazy(() => import("./pages/about.vel"), "About", RouteLoading, RouteFailed)
const Broken = lazy(() => import("./pages/broken.vel"), "Broken", RouteLoading, RouteFailed)

const routes = [
    route("/", Home),
    route("/about", About),
    route("/construction-failure", ConstructionFailure),
    route("/lazy-failure", Broken),
]

export component App:
    style global:
        :root {
            color-scheme: light dark;
            font-family: Inter, ui-sans-serif, system-ui, sans-serif;
            background: #0b1020;
            color: #e8ecff;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
        }

        button, input {
            font: inherit;
        }

        [data-release-primary] {
            display: flex;
            gap: 8px;
            width: min(1040px, calc(100% - 32px));
            margin: 0 auto;
            padding-top: 18px;
        }

        [data-release-primary] a {
            padding: 7px 10px;
            border-radius: 8px;
            color: #bdc7ff;
            text-decoration: none;
        }

        [data-release-primary] a[aria-current="page"] {
            color: #fff;
            background: #28356f;
        }

    style:
        .shell {
            min-height: 100vh;
            background: radial-gradient(circle at top right, #28356f 0, transparent 34rem), #0b1020;
        }

    return <div class="shell"><nav data-release-primary aria-label="Application pages"><NavLink to="/" exact={true}>Home</NavLink><NavLink to="/about" exact={true}>About</NavLink><NavLink to="/construction-failure" exact={true}>Failure probe</NavLink></nav><Router routes={routes} fallback={RouteNotFound} /></div>
