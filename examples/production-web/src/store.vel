import {storage} from "velar/storage"

export type Preferences:
    theme: string

export state theme = "system"
export const dark = computed(() => theme == "dark")

export def setTheme(next: string) -> null:
    theme = next

export def saveTheme(next: string) -> null:
    setTheme(next)
    storage.set("preferences", {theme: next})

export def toggleTheme() -> null:
    if theme == "dark":
        setTheme("light")
    else:
        setTheme("dark")
