import {alpha, border, color} from "velar/look"

const panelLook = look:
    display = "grid"
    gap = 12px
    padding = 20px
    border = border(1px, alpha(color("currentColor"), 0.2))
    borderRadius = 14px

const panelTitleLook = look:
    margin = 0
    fontSize = 1.1rem

export component Panel(title: string, children: WebNode):
    return <section class="panel" look={panelLook}>
        <h2 class="panel-title" look={panelTitleLook}>{title}</h2>
        {children}
    </section>

export component StatusBadge(theme: string):
    return <strong class="status-badge">Theme: {theme}</strong>
