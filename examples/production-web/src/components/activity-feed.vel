import {http} from "velar/http"

type ActivityPayload:
    message: string

const activityLook = look:
    display = flex
    alignItems = center
    justifyContent = spaceBetween
    gap = 16px
    padding = space(14px, 16px)
    radius = 12px
    background = rgb(17, 24, 46)

const buttonLook = look:
    padding = space(8px, 12px)
    border = line(0px, transparent)
    radius = 9px
    color = rgb(8, 16, 34)
    background = rgb(157, 172, 255)
    cursor = pointer

export component ActivityFeed:
    state message = "Activity has not been refreshed"

    action refresh():
        const activity = await http.get("data/activity.json").parse(ActivityPayload)
        message = activity.message

    computed failure = refresh.error

    return <section class="activity" look={activityLook} aria-live="polite">
        <span data-activity>{failure ? failure.message : message}</span>
        <button look={buttonLook} type="button" disabled={refresh.pending} on:click={refresh}>Refresh activity</button>
    </section>
