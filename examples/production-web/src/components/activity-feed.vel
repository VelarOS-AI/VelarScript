import {http} from "velar/http"

type ActivityPayload:
    message: string

const activityLook = look:
    display = "flex"
    alignItems = "center"
    justifyContent = "space-between"
    gap = 16px
    padding = Look.spacing(14px, 16px)
    borderRadius = 12px
    background = Look.rgb(17, 24, 46)

const buttonLook = look:
    padding = Look.spacing(8px, 12px)
    border = Look.border(0px, Look.color("transparent"))
    borderRadius = 9px
    color = Look.rgb(8, 16, 34)
    background = Look.rgb(157, 172, 255)
    cursor = "pointer"
export component ActivityFeed:
    state message = "Activity has not been refreshed"

    action refresh() -> null:
        const activity = await http.get("data/activity.json").parse(ActivityPayload)
        message = activity.message

    const failure = computed(() => refresh.error)

    def activityMessage() -> string:
        const current = failure()
        return current != null ? current.message : message

    return <section class="activity" look={activityLook} aria-live="polite">
        <span data-activity>{activityMessage()}</span>
        <button look={buttonLook} type="button" disabled={refresh.pending} on:click={refresh}>Refresh activity</button>
    </section>
