const metricLook = look:
    display = "grid"
    gap = 6px
    padding = 18px
    border = Look.border(1px, Look.rgb(66, 82, 143))
    borderRadius = 14px
    background = Look.rgb(21, 28, 54)

const labelLook = look:
    color = Look.rgb(170, 181, 222)
    fontSize = 0.82rem
    textTransform = "uppercase"
    letterSpacing = 0.08em

const valueLook = look:
    fontSize = 1.6rem
    fontWeight = 720

const metricsLook = look:
    display = "grid"
    gridTemplateColumns = Look.repeat(3, Look.minmax(0px, 1fr))
    gap = 14px

    if viewport.width <= 640px:
        gridTemplateColumns = Look.tracks(1fr)

export component MetricCard(label: string, value: string):
    return <article class="metric" look={metricLook}>
        <span class="label" look={labelLook}>{label}</span>
        <strong class="value" look={valueLook}>{value}</strong>
    </article>

export component Metrics(projects: number):
    return <section class="metrics" look={metricsLook} aria-label="Project metrics">
        <MetricCard label="Projects" value={str(projects)} />
        <MetricCard label="Browser engines" value="3" />
        <MetricCard label="Web API" value="0.10" />
    </section>
