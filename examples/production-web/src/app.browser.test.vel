import {expect} from "velar/test"
import {browser, localStorage, sessionStorage} from "velar/web-test"

async def test_browser_storage_controls_raw_state_without_product_seams() -> null:
    await browser.open("/")
    await localStorage.set("velar-test:malformed", "{oops")
    await sessionStorage.set("velar-test:draft", "half-written")
    expect(await localStorage.get("velar-test:malformed")).toBe("{oops")
    expect(await sessionStorage.get("velar-test:draft")).toBe("half-written")
    await localStorage.remove("velar-test:malformed")
    expect(await localStorage.get("velar-test:malformed")).toBe(null)
    await sessionStorage.clear()
    expect(await sessionStorage.get("velar-test:draft")).toBe(null)

async def test_release_studio_recovery() -> null:
    await browser.open("/")
    expect(await browser.text("h1")).toBe("VelarScript Release Studio")
    expect(await browser.attribute(`[data-release-primary] a[href="/app/"]`, "aria-current")).toBe("page")
    expect(await browser.attribute(`[data-release-primary] a[href="/app/about"]`, "aria-current")).toBe(null)
    await browser.waitForText("[data-database]", "database-ready")
    await browser.waitForText("[data-session]", "session-ready")
    expect(await browser.text("[data-config]")).toBe("/api:preview:recovery")
    expect(await browser.text("[data-set]")).toBe("4:set-ready")
    expect(await browser.text(`[data-project="parser"] strong`)).toBe("Parser")
    expect(await browser.text(`[data-project="velar-integration"] strong`)).toBe("VelarScript Integration")
    expect(await browser.text(".metrics .metric:first-child .value")).toBe("8")
    await browser.waitForText("[data-timer]", "after-ready:every-ready")
    await browser.waitForText("[data-resource]", "Resource recovery ready")
    expect(await browser.text("[data-runtime-error]")).toBe("resource:Resource recovery ready")
    await browser.click("[data-resource-retry]")
    await browser.waitForText("[data-resource]", "resource-ready")
    await browser.click("[data-action-retry]")
    await browser.waitForText("[data-action]", "Action recovery ready")
    expect(await browser.text("[data-runtime-error]")).toBe("action:Action recovery ready")
    await browser.click("[data-action-retry]")
    await browser.waitForText("[data-action]", "action-ready")
    await browser.click("[data-test-event]")
    await browser.waitForText("[data-runtime-error]", "event:Event recovery ready")
    await browser.click("[data-test-render]")
    await browser.waitForText("[data-runtime-error]", "render:Render recovery ready")
    expect(await browser.text("[data-render-stable]")).toBe("render-stable")

async def test_checked_keyframes_create_a_running_rotation() -> null:
    await browser.open("/")
    const animation = await browser.animation("[data-animation-probe]")
    expect(animation.count).toBe(1)
    expect(animation.name.startsWith("velar-kf-")).toBe(true)
    expect(animation.rotating).toBe(true)
    const toggle = await browser.animation("[data-animation-toggle-probe]")
    expect(toggle.count).toBe(1)
    await browser.click("[data-animation-toggle]")
    const removed = await browser.animation("[data-animation-toggle-probe]")
    expect(removed.count).toBe(0)

async def test_native_event_fields_cross_the_real_browser_boundary() -> null:
    await browser.open("/")
    const navigation = await browser.timings()
    expect(navigation.domContentLoadedMs >= 0).toBe(true)
    expect(navigation.loadMs >= navigation.domContentLoadedMs).toBe(true)
    const timing = await browser.measurePress("[data-event-input]", "K")
    expect(timing.inputDelayMs >= 0).toBe(true)
    expect(timing.processingDurationMs >= 0).toBe(true)
    expect(timing.nextFrameMs >= timing.inputDelayMs + timing.processingDurationMs).toBe(true)
    await browser.waitForText("[data-keyboard-event]", "K")
    await browser.waitForText("[data-input-event]", "insertText")
    await browser.click("[data-pointer-probe]")
    await browser.waitForText("[data-pointer-event]", "mouse")

async def test_repeated_route_cleanup() -> null:
    await browser.open("/")
    for index in range(8):
        await browser.click(`[data-release-primary] a[href="/app/about"]`)
        await browser.waitForText("h1", "About")
        expect(await browser.currentPath()).toBe("/about")
        expect(await browser.attribute(`[data-release-primary] a[href="/app/about"]`, "aria-current")).toBe("page")
        expect(await browser.attribute(`[data-release-primary] a[href="/app/"]`, "aria-current")).toBe(null)
        await browser.click(`[data-release-primary] a[href="/app/"]`)
        await browser.waitForText("h1", "VelarScript Release Studio")
        expect(await browser.currentPath()).toBe("/")
        expect(await browser.attribute(`[data-release-primary] a[href="/app/"]`, "aria-current")).toBe("page")

async def test_lazy_route_failure_fallback_and_retry() -> null:
    await browser.open("/lazy-failure")
    await browser.waitForText("h1", "Page unavailable")
    expect(await browser.text(`[role="alert"] p`)).toBe("Lazy route failed")
    await browser.open("/")
    await browser.waitForText("h1", "VelarScript Release Studio")
    await browser.open("/lazy-failure")
    await browser.waitForText("h1", "Page unavailable")
    expect(await browser.text(`[role="alert"] p`)).toBe("Lazy route failed")

async def test_route_construction_failure_keeps_current_page() -> null:
    await browser.open("/")
    await browser.waitForText("h1", "VelarScript Release Studio")
    await browser.click(`[data-release-primary] a[href="/app/construction-failure"]`)
    expect(await browser.currentPath()).toBe("/construction-failure")
    expect(await browser.text("h1")).toBe("VelarScript Release Studio")
    await browser.waitForText("[data-runtime-error]", "render:Route construction failed")
    await browser.click(`[data-release-primary] a[href="/app/"]`)
    await browser.waitForText("h1", "VelarScript Release Studio")
    expect(await browser.currentPath()).toBe("/")

async def test_unknown_route_renders_typed_fallback_and_recovers() -> null:
    await browser.open("/missing-release")
    await browser.waitForText("[data-route-not-found] h1", "Page not found")
    expect(await browser.text("[data-route-not-found] p")).toBe("No Release Studio page matches /missing-release.")
    expect(await browser.currentPath()).toBe("/missing-release")
    await browser.open("/%E0%A4%A")
    await browser.waitForText("[data-route-not-found] h1", "Page not found")
    expect(await browser.text("[data-route-not-found] p")).toBe("No Release Studio page matches /%E0%A4%A.")
    expect(await browser.currentPath()).toBe("/%E0%A4%A")
    await browser.click(`[data-release-primary] a[href="/app/"]`)
    await browser.waitForText("h1", "VelarScript Release Studio")
    expect(await browser.currentPath()).toBe("/")

async def test_reactive_props_update_children_in_place() -> null:
    await browser.open("/state-lab")
    // (a) A reactive bool prop flips while a half-typed draft sits in the
    // child; the child instance must survive with its state intact.
    await browser.fill("[data-draft-panel='first'] input", "half-typed draft")
    expect(await browser.text("[data-draft-panel='first'] [data-draft-busy]")).toBe("idle")
    await browser.click("[data-lab-busy]")
    await browser.waitForText("[data-draft-panel='first'] [data-draft-busy]", "busy")
    expect(await browser.text("[data-draft-panel='first'] [data-draft-value]")).toBe("half-typed draft")
    // (f) The S1 theme-toggle shape: dark={dark} as a prop must not destroy
    // the draft either.
    await browser.click("[data-lab-theme]")
    await browser.waitForText("[data-draft-panel='first'] [data-draft-dark]", "dark")
    expect(await browser.text("[data-draft-panel='first'] [data-draft-value]")).toBe("half-typed draft")
    // (c) Switching the conditional branch is a genuine unmount: the new
    // child starts fresh while still seeing the current prop values.
    await browser.click("[data-lab-branch]")
    await browser.waitFor("[data-draft-panel='second']")
    expect(await browser.count("[data-draft-panel='first']")).toBe(0)
    expect(await browser.text("[data-draft-panel='second'] [data-draft-value]")).toBe("")
    expect(await browser.text("[data-draft-panel='second'] [data-draft-busy]")).toBe("busy")
    expect(await browser.text("[data-draft-panel='second'] [data-draft-dark]")).toBe("dark")

async def test_keyed_reorder_preserves_component_instances() -> null:
    await browser.open("/state-lab")
    // (d) Per-key component state accumulates, then a reorder moves the
    // instances without resetting any of them.
    await browser.click("[data-lab-hit='beta']")
    await browser.click("[data-lab-hit='beta']")
    await browser.click("[data-lab-hit='gamma']")
    await browser.waitForText("[data-lab-count='beta']", "2")
    expect(await browser.text("[data-lab-count='gamma']")).toBe("1")
    expect(await browser.text("[data-lab-list] li:first-child button")).toBe("alpha")
    await browser.click("[data-lab-reverse]")
    await browser.waitForText("[data-lab-list] li:first-child button", "gamma")
    expect(await browser.text("[data-lab-count='gamma']")).toBe("1")
    expect(await browser.text("[data-lab-count='beta']")).toBe("2")
    expect(await browser.text("[data-lab-count='alpha']")).toBe("0")
