import {dark, toggleTheme} from "../store.vel"

type LabRow:
    id: string

state busy = false
state showFirst = true
state labRows: List<LabRow> = [{id: "alpha"}, {id: "beta"}, {id: "gamma"}]

def toggleBusy():
    busy = not busy

def swapBranch():
    showFirst = not showFirst

def reverseRows():
    labRows = labRows.reversed()

component Draft(label: string, busy: bool, dark: bool):
    state draft = ""
    return <section data-draft-panel={label}>
        <input data-draft-input aria-label="Lab draft" bind:value={draft} />
        <output data-draft-value>{draft}</output>
        <output data-draft-busy>{busy ? "busy" : "idle"}</output>
        <output data-draft-dark>{dark ? "dark" : "light"}</output>
    </section>

component LabRowView(row: LabRow):
    state hits = 0

    def recordHit():
        hits += 1

    return <li data-lab-row={row.id}>
        <button type="button" data-lab-hit={row.id} on:click={recordHit}>{row.id}</button>
        <output data-lab-count={row.id}>{hits}</output>
    </li>

export component StateLab:
    return <main data-state-lab>
        <h1>State lab</h1>
        <button type="button" data-lab-busy on:click={toggleBusy}>Toggle lab busy</button>
        <button type="button" data-lab-theme on:click={toggleTheme}>Toggle lab theme</button>
        <button type="button" data-lab-branch on:click={swapBranch}>Swap lab branch</button>
        <button type="button" data-lab-reverse on:click={reverseRows}>Reverse lab rows</button>
        {showFirst ? <Draft label="first" busy={busy} dark={dark()} /> : <Draft label="second" busy={busy} dark={dark()} />}
        <ul data-lab-list>{labRows.map(row => <LabRowView key={row.id} row={row} />)}</ul>
    </main>
