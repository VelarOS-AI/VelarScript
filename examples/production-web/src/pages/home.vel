import {Head} from "velar/web"
import {publicConfig} from "velar/config"
import {Panel, StatusBadge} from "@velarscript/demo-web-kit"
import js {NumberFormatter as PackageFormatter, formatter} from "@velarscript/demo-format/number"
import {dark, theme, toggleTheme} from "../store.vel"
import {projectCount, projects} from "../data.vel"
import {ActivityFeed} from "../components/activity-feed.vel"
import {Metrics} from "../components/metrics.vel"
import {Newsletter} from "../components/newsletter.vel"
import {ProjectList} from "../components/project-list.vel"
import {WebCapabilities} from "../components/web-capabilities.vel"

type PreviewFeatures:
    recovery: bool

type PreviewConfig:
    apiBase: string
    releaseChannel: string
    canonicalUrl: string
    socialImage: string
    features: PreviewFeatures

const previewConfig = publicConfig(PreviewConfig)

const pageLook = look:
    display = "grid"
    gap = 22px
    width = 100%
    maxWidth = 1072px
    marginInline = "auto"
    padding = spacing(40px, 16px, 64px, 16px)

const headerLook = look:
    display = "flex"
    alignItems = "center"
    justifyContent = "space-between"
    gap = 16px

const titleLook = look:
    margin = 0

const eyebrowLook = look:
    margin = 0
    color = rgb(157, 172, 255)
    fontWeight = 700

const actionsLook = look:
    display = "flex"
    alignItems = "center"
    gap = 12px

def themeButtonLook(active: bool) -> Look:
    return look:
        padding = spacing(9px, 12px)
        border = border(1px, active ? rgb(157, 172, 255) : rgb(82, 99, 165))
        borderRadius = 9px
        color = "inherit"
        background = rgb(21, 28, 54)
        cursor = "pointer"
def formattedSamples() -> string:
    let labels = []
    formatter.visit([1.5, 2.5], label => labels.append(label))
    return f"{formatter.locale}: {labels[0]} / {labels[1]}"

def classFormattedSamples() -> string:
    const packageFormatter: PackageFormatter = PackageFormatter.standard()
    packageFormatter.maximumFractionDigits = 1
    let labels = []
    packageFormatter.visit([3.5, 4.5], label => labels.append(label))
    return f"{PackageFormatter.category}/{packageFormatter.locale}: {labels[0]} / {labels[1]}"

export component Home:
    return <main class="page" look={pageLook}>
        <Head title="VelarScript Release Studio" description="VelarScript 0.10 Web platform application" canonical={previewConfig.canonicalUrl} robots="index,follow" image={previewConfig.socialImage} themeColor="#0b1020" />
        <header class="header" look={headerLook}>
            <div>
                <p class="eyebrow" look={eyebrowLook}>VelarScript 0.10 · Web API 0.10</p>
                <h1 look={titleLook}>VelarScript Release Studio</h1>
            </div>
            <nav class="actions" look={actionsLook} aria-label="Primary navigation">
                <StatusBadge theme={theme} />
                <button class={dark ? "active" : null} look={themeButtonLook(dark)} on:click={toggleTheme}>Toggle theme</button>
            </nav>
        </header>
        <Metrics projects={projectCount()} />
        <Panel title="Release readiness">
            <ProjectList items={projects} />
            <ActivityFeed />
            <WebCapabilities />
            <p data-format>Safe JS package value: {formatter.format(42, "items")} · {formattedSamples()} · class {classFormattedSamples()}</p>
            <Newsletter />
        </Panel>
    </main>
