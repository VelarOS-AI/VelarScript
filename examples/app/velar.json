{
  "formatVersion": 2,
  "kind": "application",
  "entry": "src/main.vel",
  "outDir": "dist",
  "publicDir": "public",
  "build": {
    "sourceMaps": true
  },
  "extensions": ["@velarscript/web"],
  "surfaces": {
    "core": "0.5",
    "web": "0.11"
  },
  "web": {
    "title": "Release Studio",
    "base": "/",
    "publicConfig": {
      "dataBase": "/data",
      "channel": "preview",
      "canonicalUrl": "https://releases.velar.example/",
      "socialImage": "/mark.svg"
    },
    "security": {
      "contentSecurityPolicy": true,
      "connectSources": [],
      "imageSources": []
    },
    "deployment": {
      "spaFallback": true
    }
  }
}
