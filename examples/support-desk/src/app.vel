import {Link, NavLink, Router, route} from "velar/web"
import {TicketDetail} from "./pages/ticket-detail.vel"
import {TicketsPage} from "./pages/tickets.vel"

component MissingPage:
    return <main role="alert"><h1>Page not found</h1><Link to="/">Return to inbox</Link></main>

const routes = [route("/", TicketsPage), route("/tickets/:id", TicketDetail)]

const shellLook = look:
    minHeight = 100vh
    color = Look.rgb(23, 32, 51)
    background = Look.linearGradient(145deg, Look.rgb(224, 232, 255), Look.rgb(245, 247, 251))
    fontFamily = "Inter, ui-sans-serif, system-ui, sans-serif"

const headerLook = look:
    display = "flex"
    alignItems = "center"
    justifyContent = "space-between"
    gap = 16px
    minHeight = 62px
    padding = Look.spacing(0px, 20px)
    borderBottom = Look.border(1px, Look.rgba(205, 214, 230, 0.85))
    background = Look.rgba(245, 247, 251, 0.94)
    backdropFilter = "blur(14px)"

const brandLook = look:
    marginRight = "auto"
    color = Look.rgb(23, 32, 51)
    fontWeight = 900
    letterSpacing = -0.03em
    textDecoration = "none"
const navLinkLook = look:
    padding = Look.spacing(7px, 10px)
    borderRadius = 9px
    color = Look.rgb(104, 117, 138)
    fontSize = 13px
    fontWeight = 900
    textDecoration = "none"
    if @current:
        color = Look.rgb(36, 73, 196)
        background = Look.rgb(229, 234, 255)

const contextLook = look:
    color = Look.rgb(104, 117, 138)
    fontSize = 13px
    fontWeight = 700

export component App:
    return <div class="shell" look={shellLook}>
        <header look={headerLook}>
            <Link look={brandLook} to="/">SupportDesk</Link>
            <nav data-primary aria-label="Primary navigation">
                <NavLink look={navLinkLook} to="/" exact={true}>Inbox</NavLink>
            </nav>
            <span look={contextLook}>Customer operations</span>
        </header>
        <Router routes={routes} fallback={MissingPage} />
    </div>
