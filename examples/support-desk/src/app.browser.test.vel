import {expect} from "velar/test"
import {browser} from "velar/web-test"

async def openDesk() -> null:
    await browser.open("/")
    await browser.waitForText("[data-support-desk]", "Cannot sign in after password reset")
    expect(await browser.attribute("[data-primary] a", "aria-current")).toBe("page")

async def test_dialog_cancel_restores_trigger_focus() -> null:
    await browser.open("/tickets/ticket-auth")
    await browser.waitForText("[data-ticket-detail]", "Cannot sign in after password reset")
    await browser.click("[data-resolve]")
    expect(await browser.visible("[data-resolve-dialog]")).toBe(true)
    await browser.click("[data-cancel-resolve]")
    expect(await browser.visible("[data-resolve-dialog]")).toBe(false)
    await browser.waitFor("[data-resolve]:focus")
    expect(await browser.count("[data-resolve]:focus")).toBe(1)

async def test_support_desk_http_filter_and_pagination() -> null:
    await openDesk()
    expect(await browser.count("[data-ticket]")).toBe(4)
    expect(await browser.text("[data-page]")).toBe("Page 1 of 2")
    await browser.click("[data-next]")
    await browser.waitForText("[data-page]", "Page 2 of 2")
    expect(await browser.count("[data-ticket]")).toBe(3)
    await browser.click("[data-previous]")
    await browser.fill("[data-search]", "Avery")
    await browser.waitForText("[data-result-count]", "1 tickets")
    expect(await browser.count("[data-ticket]")).toBe(1)
    await browser.fill("[data-search]", "")
    await browser.select("[data-filter]", "resolved")
    await browser.waitForText("[data-result-count]", "2 tickets")

async def test_typed_form_route_context_and_persistence() -> null:
    await openDesk()
    await browser.click("[data-create-ticket]")
    expect(await browser.attribute("[data-title]", "aria-invalid")).toBe("true")
    await browser.fill("[data-title]", "Keyboard shortcut stops working")
    await browser.fill("[data-requester]", "Jamie Park")
    await browser.fill("[data-summary]", "The command palette no longer opens after changing layouts.")
    await browser.select("[data-priority]", "high")
    await browser.fill("[data-estimate]", "40")
    await browser.click("[data-urgent]")
    await browser.click("[data-create-ticket]")
    await browser.waitForText("[data-support-desk]", "Keyboard shortcut stops working")
    expect(await browser.count("[data-ticket]")).toBe(4)
    await browser.click(`[data-ticket]:has-text("Keyboard shortcut stops working") a`)
    await browser.waitForText("[data-ticket-detail]", "Route ID:")
    expect(await browser.text("[data-detail-status]")).toBe("Status: open")
    await browser.click("[data-resolve]")
    expect(await browser.visible("[data-resolve-dialog]")).toBe(true)
    await browser.click("[data-confirm-resolve]")
    await browser.waitForText("[data-detail-status]", "Status: resolved")
    expect(await browser.visible("[data-resolve-dialog]")).toBe(false)
    expect(await browser.text("[data-dialog-result]")).toBe("resolved")
    await browser.waitFor("[data-resolve]:focus")
    expect(await browser.count("[data-resolve]:focus")).toBe(1)
    await browser.click(`[data-ticket-detail] a[href="/"]`)
    await browser.waitForText("[data-support-desk]", "Keyboard shortcut stops working")
    await browser.reload()
    await browser.waitForText("[data-support-desk]", "Keyboard shortcut stops working")

async def test_direct_detail_route_recovers_data() -> null:
    await browser.open("/tickets/ticket-auth")
    await browser.waitForText("[data-ticket-detail]", "Cannot sign in after password reset")
    expect(await browser.text("[data-route-id]")).toBe("Route ID: ticket-auth")
    expect(await browser.attribute("[data-primary] a", "aria-current")).toBe(null)
    await browser.open("/tickets/not-a-ticket")
    await browser.waitForText("[data-ticket-detail]", "Ticket not found")
    expect(await browser.count("[data-route-id]")).toBe(0)

async def test_query_page_uses_strict_optional_number_parsing() -> null:
    await browser.open("/?page=2")
    await browser.waitForText("[data-page]", "Page 2 of 2")
    expect(await browser.count("[data-ticket]")).toBe(3)
    await browser.open("/?page=12px")
    await browser.waitForText("[data-page]", "Page 1 of 2")
    expect(await browser.count("[data-ticket]")).toBe(4)
