import {Link} from "velar/web"
import {format} from "velar/time"
import {Ticket, TicketPriority, TicketStatus} from "../domain.vel"

const cardLook = look:
    display = "grid"
    gap = 10px
    padding = 16px
    border = Look.border(1px, Look.rgb(220, 227, 236))
    borderRadius = 15px
    background = Look.rgb(255, 255, 255)

const rowLook = look:
    display = "flex"
    alignItems = "center"
    justifyContent = "space-between"
    gap = 10px

const badgesLook = look:
    display = "flex"
    gap = 6px

def badgeLook(urgent: bool = false) -> Look:
    return look:
        padding = Look.spacing(4px, 7px)
        borderRadius = 9999px
        color = urgent ? Look.rgb(165, 40, 40) : Look.rgb(83, 96, 121)
        background = urgent ? Look.rgb(255, 237, 237) : Look.rgb(237, 241, 247)
        fontSize = 11px
        fontWeight = 800

const titleLook = look:
    margin = 0
    fontSize = 17px

const bodyLook = look:
    margin = 0
    color = Look.rgb(104, 117, 138)
    fontSize = 13px
    lineHeight = 1.45

const linkLook = look:
    color = Look.rgb(49, 87, 213)
    fontSize = 13px
    fontWeight = 800
    textDecoration = "none"
export component TicketCard(ticket: Ticket):
    return <article look={cardLook} data-ticket data-ticket-id={ticket.id}>
        <div class="meta" look={rowLook}>
            <div class="badges" look={badgesLook}><span class="badge" look={badgeLook()}>{ticket.status}</span><span class="badge" look={badgeLook()}>{ticket.priority}</span>{ticket.urgent ? <span class="badge urgent" look={badgeLook(true)}>Urgent</span> : null}</div>
            <span class="badge" look={badgeLook()}>{ticket.estimate} min</span>
        </div>
        <h2 look={titleLook} data-ticket-title>{ticket.title}</h2>
        <p look={bodyLook}>{ticket.summary}</p>
        <div class="footer" look={rowLook}><p look={bodyLook}>{ticket.requester} · <time>{format(ticket.updatedAt, "en-US", "UTC")}</time></p><Link look={linkLook} to={f"/tickets/{ticket.id}"}>View ticket</Link></div>
    </article>
