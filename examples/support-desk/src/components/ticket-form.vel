import {announce} from "velar/web"
import {clearErrors, errors, focusFirstError, read, reset, setError} from "velar/forms"
import {isBlank, trim} from "velar/text"
import {TicketDraft, TicketPriority} from "../domain.vel"
import {addTicket} from "../store.vel"

const formLook = look:
    display = grid
    gap = 12px
    padding = 18px
    border = line(1px, rgb(220, 227, 236))
    radius = 18px
    background = rgb(255, 255, 255)
    shadow = dropShadow(0px, 16px, 44px, rgba(42, 55, 79, 0.07))

const gridLook = look:
    display = grid
    columns = tracks(1.2fr, 1fr, 0.7fr, 0.7fr)
    gap = 10px

    if viewport.width <= 820px:
        columns = tracks(1fr)

const labelLook = look:
    display = grid
    gap = 6px
    color = rgb(80, 93, 114)
    fontSize = 12px
    fontWeight = 800

const fieldLook = look:
    minHeight = 42px
    border = line(1px, rgb(207, 216, 230))
    radius = 10px
    padding = space(9px, 11px)
    color = rgb(23, 32, 51)
    background = rgb(251, 252, 254)

const textareaLook = look:
    ...fieldLook
    minHeight = 76px

const urgentLook = look:
    display = flex
    alignItems = center
    gap = 8px

const checkboxLook = look:
    minHeight = auto

const submitLook = look:
    justifySelf = start
    border = line(0px, transparent)
    radius = 10px
    padding = space(10px, 15px)
    color = rgb(255, 255, 255)
    background = rgb(49, 87, 213)
    fontWeight = 800
    cursor = pointer

export component TicketForm:
    let form: Element? = none

    def submit():
        if form:
            clearErrors(form)
            const draft = read(form, TicketDraft)
            const title = trim(draft.title)
            const requester = trim(draft.requester)
            if isBlank(title):
                setError(form, "title", "Add a short issue title")
            if isBlank(requester):
                setError(form, "requester", "Add the requester name")
            if draft.estimate == none:
                setError(form, "estimate", "Add an estimate in minutes")
            if errors(form).size > 0:
                focusFirstError(form)
            else:
                assert draft.estimate != none, "Ticket estimate must be present after validation"
                addTicket({...draft, title, requester, summary: trim(draft.summary)})
                reset(form)
                announce("Ticket created")

    return <form look={formLook} ref={form} on:submit.prevent={submit} data-ticket-form>
        <div class="grid" look={gridLook}>
            <label look={labelLook}>Issue title<input look={fieldLook} name="title" data-title placeholder="What needs attention?" /></label>
            <label look={labelLook}>Requester<input look={fieldLook} name="requester" data-requester placeholder="Customer name" /></label>
            <label look={labelLook}>Priority<select look={fieldLook} name="priority" data-priority><option value={TicketPriority.low}>Low</option><option value={TicketPriority.normal} selected={true}>Normal</option><option value={TicketPriority.high}>High</option></select></label>
            <label look={labelLook}>Estimate<input look={fieldLook} name="estimate" data-estimate type="number" min="1" placeholder="Minutes" /></label>
        </div>
        <label look={labelLook}>Summary<textarea look={textareaLook} name="summary" data-summary placeholder="Add useful context"></textarea></label>
        <label class="urgent" look={urgentLook}><input look={checkboxLook} name="urgent" data-urgent type="checkbox" />Mark as urgent</label>
        <button look={submitLook} data-create-ticket type="submit">Create ticket</button>
    </form>
