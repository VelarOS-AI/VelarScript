import {announce} from "velar/web"
import {clearErrors, errors, focusFirstError, read, reset, setError} from "velar/forms"
import {TicketDraft, TicketPriority} from "../domain.vel"
import {addTicket} from "../store.vel"
import {border, color, rgb, rgba, shadow, spacing, tracks} from "velar/look"

const formLook = look:
    display = "grid"
    gap = 12px
    padding = 18px
    border = border(1px, rgb(220, 227, 236))
    borderRadius = 18px
    background = rgb(255, 255, 255)
    boxShadow = shadow(0px, 16px, 44px, rgba(42, 55, 79, 0.07))

const gridLook = look:
    display = "grid"
    gridTemplateColumns = tracks(1.2fr, 1fr, 0.7fr, 0.7fr)
    gap = 10px

    if viewport.width <= 820px:
        gridTemplateColumns = tracks(1fr)

const labelLook = look:
    display = "grid"
    gap = 6px
    color = rgb(80, 93, 114)
    fontSize = 12px
    fontWeight = 800

const fieldLook = look:
    minHeight = 42px
    border = border(1px, rgb(207, 216, 230))
    borderRadius = 10px
    padding = spacing(9px, 11px)
    color = rgb(23, 32, 51)
    background = rgb(251, 252, 254)

const textareaLook = look:
    ...fieldLook
    minHeight = 76px

const urgentLook = look:
    display = "flex"
    alignItems = "center"
    gap = 8px

const checkboxLook = look:
    minHeight = "auto"
const submitLook = look:
    justifySelf = "start"
    border = border(0px, color("transparent"))
    borderRadius = 10px
    padding = spacing(10px, 15px)
    color = rgb(255, 255, 255)
    background = rgb(49, 87, 213)
    fontWeight = 800
    cursor = "pointer"
export component TicketForm:
    let form: Element? = null

    def submit():
        if form != null:
            const currentForm = form
            clearErrors(currentForm)
            const draft = read(currentForm, TicketDraft)
            const title = draft.title.trim()
            const requester = draft.requester.trim()
            if title.size == 0:
                setError(currentForm, "title", "Add a short issue title")
            if requester.size == 0:
                setError(currentForm, "requester", "Add the requester name")
            if draft.estimate == null:
                setError(currentForm, "estimate", "Add an estimate in minutes")
            if errors(currentForm).size > 0:
                focusFirstError(currentForm)
            else:
                assert draft.estimate != null else "Ticket estimate must be present after validation"
                addTicket({...draft, title, requester, summary: draft.summary.trim()})
                reset(currentForm)
                announce("Ticket created")

    return <form look={formLook} ref={form} on:submit.prevent={submit} data-ticket-form>
        <div class="grid" look={gridLook}>
            <label look={labelLook}>
                Issue title
                <input look={fieldLook} name="title" data-title placeholder="What needs attention?" />
            </label>
            <label look={labelLook}>
                Requester
                <input look={fieldLook} name="requester" data-requester placeholder="Customer name" />
            </label>
            <label look={labelLook}>
                Priority
                <select look={fieldLook} name="priority" data-priority>
                    <option value={TicketPriority.low}>Low</option>
                    <option value={TicketPriority.normal} selected={true}>Normal</option>
                    <option value={TicketPriority.high}>High</option>
                </select>
            </label>
            <label look={labelLook}>
                Estimate
                <input look={fieldLook} name="estimate" data-estimate type="number" min="1" placeholder="Minutes" />
            </label>
        </div>
        <label look={labelLook}>
            Summary
            <textarea look={textareaLook} name="summary" data-summary placeholder="Add useful context"></textarea>
        </label>
        <label class="urgent" look={urgentLook}>
            <input look={checkboxLook} name="urgent" data-urgent type="checkbox" />
            Mark as urgent
        </label>
        <button look={submitLook} data-create-ticket type="submit">Create ticket</button>
    </form>
