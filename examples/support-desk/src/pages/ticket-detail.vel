import {Head, Link, RouteContext, announce} from "velar/web"
import {closeDialog, dialogResult, focus, frame, showDialog} from "velar/browser"
import {loadTickets, resolveTicket, ticketById} from "../store.vel"

const pageLook = look:
    display = grid
    gap = 18px
    width = 100%
    maxWidth = 760px
    marginInline = auto
    padding = space(44px, 16px)

const linkLook = look:
    color = rgb(49, 87, 213)
    fontWeight = 800
    textDecoration = undecorated

const surfaceLook = look:
    display = grid
    gap = 14px
    padding = 24px
    border = line(1px, rgb(220, 227, 236))
    radius = 18px
    background = rgb(255, 255, 255)

const titleLook = look:
    margin = 0

const bodyLook = look:
    margin = 0
    color = rgb(102, 115, 137)
    lineHeight = 1.6

def buttonLook(secondary: bool = false) -> Look:
    return look:
        justifySelf = start
        border = line(0px, transparent)
        radius = 10px
        padding = space(10px, 14px)
        color = secondary ? rgb(66, 80, 106) : rgb(255, 255, 255)
        background = secondary ? rgb(237, 241, 247) : rgb(49, 87, 213)
        fontWeight = 800
        cursor = pointer

const dialogLook = look:
    width = 100%
    maxWidth = 420px
    border = line(1px, rgb(211, 219, 234))
    radius = 16px
    padding = 22px
    color = rgb(23, 32, 51)
    background = rgb(255, 255, 255)
    shadow = dropShadow(0px, 24px, 80px, rgba(35, 48, 77, 0.28))

    if @open:
        display = grid
        gap = 14px

    @backdrop:
        background = rgba(20, 28, 48, 0.42)

const dialogActionsLook = look:
    display = flex
    justifyContent = end
    gap = 10px

const visuallyHiddenLook = look:
    position = absolute
    width = 1px
    height = 1px
    padding = 0
    margin = -1px
    overflow = hidden
    clip = "rect(0, 0, 0, 0)"
    whiteSpace = nowrap
    border = line(0px, transparent)

export component TicketDetail(route: RouteContext):
    const routeId = route.params.get("id")
    assert routeId != none, "Ticket detail route requires an id parameter"
    const id = routeId
    let confirmDialog: DialogElement? = none
    let resolveButton: Element? = none
    state resolution = ""
    resource catalog = loadTickets()
    computed ticket = ticketById(id)
    computed loadFailure = catalog.error

    def askResolve():
        if confirmDialog:
            showDialog(confirmDialog)

    def cancelResolve():
        if confirmDialog:
            closeDialog(confirmDialog, "cancelled")
        if resolveButton:
            focus(resolveButton, true)

    async def confirmResolve():
        resolveTicket(id)
        if confirmDialog:
            closeDialog(confirmDialog, "resolved")
            resolution = dialogResult(confirmDialog)
        announce("Ticket resolved")
        await frame()
        if resolveButton:
            focus(resolveButton, true)

    return <main class="page" look={pageLook} data-ticket-detail>
        <Link look={linkLook} to="/">← Back to inbox</Link>
        <section if={catalog.loading} class="loading" look={surfaceLook} aria-busy="true">
            <Head title="Loading ticket · SupportDesk" />
            <p look={bodyLook}>Loading ticket…</p>
        </section>
        <section else-if={loadFailure} class="missing" look={surfaceLook} role="alert">
            <Head title="Ticket unavailable · SupportDesk" />
            <h1 look={titleLook}>Ticket unavailable</h1>
            <p look={bodyLook}>{loadFailure.message}</p>
            <button look={buttonLook()} type="button" on:click={catalog.reload}>Retry</button>
        </section>
        <article else-if={ticket} look={surfaceLook}>
            <Head title={f"{ticket.title} · SupportDesk"} />
            <p look={bodyLook}>{ticket.requester} · {ticket.priority} priority</p>
            <h1 look={titleLook}>{ticket.title}</h1>
            <p look={bodyLook}>{ticket.summary}</p>
            <p look={bodyLook} data-route-id>Route ID: {id}</p>
            <p look={bodyLook} data-detail-status>Status: {ticket.status}</p>
            <button look={buttonLook()} ref={resolveButton} data-resolve type="button" on:click={askResolve}>Resolve ticket</button>
            <span class="visually-hidden" look={visuallyHiddenLook} data-dialog-result>{resolution}</span>
            <dialog look={dialogLook} ref={confirmDialog} data-resolve-dialog aria-labelledby="resolve-dialog-title">
                <h2 look={titleLook} id="resolve-dialog-title">Resolve this ticket?</h2>
                <p look={bodyLook}>The ticket remains available in the inbox after its status changes.</p>
                <div class="dialog-actions" look={dialogActionsLook}>
                    <button class="secondary" look={buttonLook(true)} data-cancel-resolve type="button" on:click={cancelResolve}>Cancel</button>
                    <button look={buttonLook()} data-confirm-resolve type="button" on:click={confirmResolve}>Resolve</button>
                </div>
            </dialog>
        </article>
        <section else class="missing" look={surfaceLook} role="alert">
            <Head title="Ticket not found · SupportDesk" />
            <h1 look={titleLook}>Ticket not found</h1>
            <p look={bodyLook}>The route parameter does not match a known ticket.</p>
        </section>
    </main>
