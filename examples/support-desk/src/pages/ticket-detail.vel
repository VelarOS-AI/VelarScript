import {Head, Link, RouteContext, announce} from "velar/web"
import {closeDialog, dialogResult, focus, frame, showDialog} from "velar/browser"
import {loadTickets, resolveTicket, ticketById} from "../store.vel"

const pageLook = look:
    display = "grid"
    gap = 18px
    width = 100%
    maxWidth = 760px
    marginInline = "auto"
    padding = Look.spacing(44px, 16px)

const linkLook = look:
    color = Look.rgb(49, 87, 213)
    fontWeight = 800
    textDecoration = "none"
const surfaceLook = look:
    display = "grid"
    gap = 14px
    padding = 24px
    border = Look.border(1px, Look.rgb(220, 227, 236))
    borderRadius = 18px
    background = Look.rgb(255, 255, 255)

const titleLook = look:
    margin = 0

const bodyLook = look:
    margin = 0
    color = Look.rgb(102, 115, 137)
    lineHeight = 1.6

def buttonLook(secondary: bool = false) -> Look:
    return look:
        justifySelf = "start"
        border = Look.border(0px, Look.color("transparent"))
        borderRadius = 10px
        padding = Look.spacing(10px, 14px)
        color = secondary ? Look.rgb(66, 80, 106) : Look.rgb(255, 255, 255)
        background = secondary ? Look.rgb(237, 241, 247) : Look.rgb(49, 87, 213)
        fontWeight = 800
        cursor = "pointer"
const dialogLook = look:
    width = 100%
    maxWidth = 420px
    border = Look.border(1px, Look.rgb(211, 219, 234))
    borderRadius = 16px
    padding = 22px
    color = Look.rgb(23, 32, 51)
    background = Look.rgb(255, 255, 255)
    boxShadow = Look.shadow(0px, 24px, 80px, Look.rgba(35, 48, 77, 0.28))

    if @open:
        display = "grid"
        gap = 14px

    @backdrop:
        background = Look.rgba(20, 28, 48, 0.42)

const dialogActionsLook = look:
    display = "flex"
    justifyContent = "end"
    gap = 10px

const visuallyHiddenLook = look:
    position = "absolute"
    width = 1px
    height = 1px
    padding = 0
    margin = -1px
    overflow = "hidden"
    clip = "rect(0, 0, 0, 0)"
    whiteSpace = "nowrap"
    border = Look.border(0px, Look.color("transparent"))

export component TicketDetail(route: RouteContext):
    const routeId = route.params.get("id")
    assert routeId != null else "Ticket detail route requires an id parameter"
    const id = routeId
    let confirmDialog: DialogElement? = null
    let resolveButton: Element? = null
    state resolution = ""
    resource catalog = loadTickets()
    const ticket = computed(() => ticketById(id))
    const loadFailure = computed(() => catalog.error)

    def askResolve() -> null:
        if confirmDialog != null:
            showDialog(confirmDialog)

    def cancelResolve() -> null:
        if confirmDialog != null:
            closeDialog(confirmDialog, "cancelled")
        if resolveButton != null:
            focus(resolveButton, true)

    async def confirmResolve() -> null:
        resolveTicket(id)
        if confirmDialog != null:
            const currentDialog = confirmDialog
            closeDialog(currentDialog, "resolved")
            resolution = dialogResult(currentDialog)
        announce("Ticket resolved")
        await frame()
        if resolveButton != null:
            focus(resolveButton, true)

    def content() -> WebNode:
        if catalog.loading:
            return <section class="loading" look={surfaceLook} aria-busy="true">
            <Head title="Loading ticket · SupportDesk" />
            <p look={bodyLook}>Loading ticket…</p>
        </section>

        const currentFailure = loadFailure()
        if currentFailure != null:
            return <section class="missing" look={surfaceLook} role="alert">
            <Head title="Ticket unavailable · SupportDesk" />
            <h1 look={titleLook}>Ticket unavailable</h1>
            <p look={bodyLook}>{currentFailure.message}</p>
            <button look={buttonLook()} type="button" on:click={catalog.reload}>Retry</button>
        </section>

        const currentTicket = ticket()
        if currentTicket != null:
            return <article look={surfaceLook}>
            <Head title={f"{currentTicket.title} · SupportDesk"} />
            <p look={bodyLook}>{currentTicket.requester} · {currentTicket.priority} priority</p>
            <h1 look={titleLook}>{currentTicket.title}</h1>
            <p look={bodyLook}>{currentTicket.summary}</p>
            <p look={bodyLook} data-route-id>Route ID: {id}</p>
            <p look={bodyLook} data-detail-status>Status: {currentTicket.status}</p>
            <button look={buttonLook()} ref={resolveButton} data-resolve type="button" on:click={askResolve}>
                Resolve ticket
            </button>
            <span class="visually-hidden" look={visuallyHiddenLook} data-dialog-result>{resolution}</span>
            <dialog look={dialogLook} ref={confirmDialog} data-resolve-dialog aria-labelledby="resolve-dialog-title">
                <h2 look={titleLook} id="resolve-dialog-title">Resolve this ticket?</h2>
                <p look={bodyLook}>The ticket remains available in the inbox after its status changes.</p>
                <div class="dialog-actions" look={dialogActionsLook}>
                    <button
                        class="secondary"
                        look={buttonLook(true)}
                        data-cancel-resolve
                        type="button"
                        on:click={cancelResolve}
                    >
                        Cancel
                    </button>
                    <button look={buttonLook()} data-confirm-resolve type="button" on:click={confirmResolve}>
                        Resolve
                    </button>
                </div>
            </dialog>
        </article>

        return <section class="missing" look={surfaceLook} role="alert">
            <Head title="Ticket not found · SupportDesk" />
            <h1 look={titleLook}>Ticket not found</h1>
            <p look={bodyLook}>The route parameter does not match a known ticket.</p>
        </section>

    return <main class="page" look={pageLook} data-ticket-detail>
        <Link look={linkLook} to="/">← Back to inbox</Link>
        {content()}
    </main>
