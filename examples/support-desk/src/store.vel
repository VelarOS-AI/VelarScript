import {http} from "velar/http"
import {storage} from "velar/storage"
import {DeskData, Ticket, TicketCatalog, TicketDraft, TicketFilter, TicketSort, createTicket, findTicket as findInList, pageTickets, resolveTicket as resolveInList, selectTickets} from "./domain.vel"

const deskStorage = storage.scope("support-desk")
const initial: DeskData = deskStorage.get("desk", DeskData, {tickets: []})
const pageSize = 4

export state tickets: List<Ticket> = initial.tickets.copy()
export state query = ""
export state filter: TicketFilter = TicketFilter.all
export state sort: TicketSort = TicketSort.recent
export state page = 1
export const selectedTickets: () -> List<Ticket> = computed(() => selectTickets(tickets, query, filter, sort))
export const visibleTickets: () -> List<Ticket> = computed(() => pageTickets(selectedTickets(), page, pageSize))
export const totalPages: () -> number = computed(() => Math.max(1, (selectedTickets().size / pageSize).ceil()))

def persist() -> null:
    deskStorage.set("desk", {tickets})

def clampPage() -> null:
    page = Math.min(Math.max(1, page), totalPages())

export async def loadTickets() -> List<Ticket>:
    if tickets.size > 0:
        return tickets
    const catalog = await http.get("/data/tickets.json", {cache: "no-store"}).parse(TicketCatalog)
    tickets = catalog.tickets.copy()
    clampPage()
    persist()
    return tickets

export def addTicket(draft: TicketDraft) -> null:
    tickets.append(createTicket(draft))
    page = 1
    persist()

export def resolveTicket(id: string) -> null:
    resolveInList(tickets, id)
    persist()

export def ticketById(id: string) -> Ticket?:
    return findInList(tickets, id)

export def nextPage() -> null:
    if page < totalPages():
        page += 1

export def previousPage() -> null:
    if page > 1:
        page -= 1

export def setPage(next: number) -> null:
    if not next.isInteger() or next < 1:
        page = 1
    else:
        page = next
        if tickets.size > 0:
            clampPage()
