import {find, sortBy} from "velar/collections"
import {uuid} from "velar/id"
import {now} from "velar/time"
import {isBlank} from "velar/text"

export enum TicketStatus:
    open
    pending
    resolved

export enum TicketPriority:
    low
    normal
    high

export enum TicketFilter:
    all
    open
    pending
    resolved

export enum TicketSort:
    recent
    oldest
    priority

export type Ticket:
    id: string
    title: string
    requester: string
    summary: string
    status: TicketStatus
    priority: TicketPriority
    urgent: bool
    estimate: number
    updatedAt: number

export type TicketCatalog:
    tickets: List<Ticket>

export type DeskData:
    tickets: List<Ticket>

export type TicketDraft:
    title: string
    requester: string
    summary: string
    priority: TicketPriority
    urgent: bool
    estimate: number?

def matchesStatus(ticket: Ticket, filter: TicketFilter) -> bool:
    match filter:
        case TicketFilter.all:
            return true
        case TicketFilter.open:
            return ticket.status == TicketStatus.open
        case TicketFilter.pending:
            return ticket.status == TicketStatus.pending
        case TicketFilter.resolved:
            return ticket.status == TicketStatus.resolved

def priorityRank(priority: TicketPriority) -> number:
    match priority:
        case TicketPriority.low:
            return 1
        case TicketPriority.normal:
            return 2
        case TicketPriority.high:
            return 3

export def selectTickets(tickets: List<Ticket>, query: string, filter: TicketFilter, sort: TicketSort) -> List<Ticket>:
    const needle = query.trim().lower()
    const filtered = tickets.filter(ticket => matchesStatus(ticket, filter) and (isBlank(needle) or needle in ticket.title.lower() or needle in ticket.requester.lower()))
    match sort:
        case TicketSort.recent:
            return sortBy(filtered, ticket => ticket.updatedAt, true)
        case TicketSort.oldest:
            return sortBy(filtered, ticket => ticket.updatedAt)
        case TicketSort.priority:
            return sortBy(filtered, ticket => priorityRank(ticket.priority), true)

export def pageTickets(tickets: List<Ticket>, page: number, pageSize: number) -> List<Ticket>:
    const start = (page - 1) * pageSize
    return tickets.slice(start, start + pageSize)

export def findTicket(tickets: List<Ticket>, id: string) -> Ticket?:
    return find(tickets, ticket => ticket.id == id)

export def createTicket(draft: TicketDraft) -> Ticket:
    const {title, requester, summary, priority, urgent, estimate} = draft
    assert estimate != null else "Ticket estimate is required"
    return {
        id: uuid(),
        title: title.trim(),
        requester: requester.trim(),
        summary: summary.trim(),
        status: TicketStatus.open,
        priority,
        urgent,
        estimate,
        updatedAt: now(),
    }

export def resolveTicket(tickets: List<Ticket>, id: string):
    const timestamp = now()
    const ticket = findTicket(tickets, id)
    if ticket:
        ticket.status = TicketStatus.resolved
        ticket.updatedAt = timestamp
