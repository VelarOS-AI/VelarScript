import {clamp} from "velar/math"

/// One plotted dashboard sample with its stable render key and x coordinate.
export type TrafficPoint:
    id: string
    label: string
    value: number
    x: number

/// Converts metric values into bounded SVG coordinates.
export class ChartScale:
    static const defaultHeight: number = 120
    const maxValue: number
    const height: number
    const baseline: number
    private const pixels: number

    constructor(maxValue: number, height: number = 120, baseline: number = 150):
        assert 0 < maxValue <= 1000000 else "Chart maximum must be between 0 and 1000000"
        assert 0 < height <= 10000 else "Chart height must be between 0 and 10000"
        self.maxValue = maxValue
        self.height = height
        self.baseline = baseline
        self.pixels = height / maxValue

    /// Returns the upper SVG boundary of the plotted value range.
    get top() -> number:
        return self.baseline - self.height

    /// Returns the visible bar height for one metric value.
    def heightFor(value: number) -> number:
        return clamp(value * self.pixels, 0, self.height)

    /// Returns the SVG y coordinate for one metric value.
    def yFor(value: number) -> number:
        return self.baseline - self.heightFor(value)

export def barHeight(value: number, maxValue: number, height: number = 120) -> number:
    return ChartScale(maxValue, height).heightFor(value)

export def barY(value: number, maxValue: number, baseline: number = 150) -> number:
    return ChartScale(maxValue, ChartScale.defaultHeight, baseline).yFor(value)
