import js {formatValue} from "@velarscript/demo-format"
import {map as mapAsync} from "velar/async"
import {flatten} from "velar/collections"
import {http} from "velar/http"
import {lazy} from "velar/web"
import {ChartScale, TrafficPoint} from "./chart.vel"

const ink = rgb(23, 32, 51)
const inkSoft = rgb(96, 112, 139)
const paper = rgb(243, 246, 251)
const surface = rgb(255, 255, 255)
const rule = rgb(219, 228, 240)
const primary = rgb(35, 87, 217)
const success = rgb(22, 134, 95)
const danger = rgb(192, 61, 83)

const TrafficBar = lazy(() => import("./components/traffic-bar.vel"), "TrafficBar")

type Metric:
    id: string
    label: string
    value: number
    trend: number

type DashboardSummary:
    updatedAt: string
    traffic: List<TrafficPoint>
    trafficMax: number
    peakLabel: string

type MetricFeed:
    metrics: List<Metric>

type DashboardData:
    updatedAt: string
    metrics: List<Metric>
    traffic: List<TrafficPoint>
    trafficMax: number
    peakLabel: string

async def loadDashboard() -> DashboardData:
    const summary = await http.get("/data/dashboard.json").parse(DashboardSummary)
    const metricGroups = await mapAsync(
        ["/data/metrics-primary.json", "/data/metrics-secondary.json"],
        async source => (await http.get(source).parse(MetricFeed)).metrics,
        2,
    )
    return {
        updatedAt: summary.updatedAt,
        metrics: flatten(metricGroups),
        traffic: summary.traffic,
        trafficMax: summary.trafficMax,
        peakLabel: summary.peakLabel,
    }

const metricLook = look:
    padding = 20px
    border = border(1px, rule)
    borderRadius = 16px
    background = surface
    boxShadow = shadow(0px, 12px, 30px, rgba(32, 48, 80, 0.05))

const metricValueLook = look:
    marginBlock = 8px
    fontSize = 32px
    fontWeight = 750

def trendLook(improving: bool) -> Look:
    return look:
        color = improving ? success : danger

component MetricCard(metric: Metric):
    computed improving = metric.trend >= 0

    return <article class="metric" look={metricLook} data-metric={metric.id}>
        <span>{metric.label}</span>
        <div class="value" look={metricValueLook}>{formatValue(metric.value)}</div>
        <div class="trend" look={trendLook(improving)}>{metric.trend >= 0 ? "+" : ""}{metric.trend}%</div>
    </article>

const chartSummaryLook = look:
    display = "grid"
    gap = 3px
    padding = spacing(8px, 10px)
    borderRadius = 8px
    color = ink
    background = rgb(234, 240, 255)
    fontFamily = "Inter, ui-sans-serif, system-ui, sans-serif"
    fontSize = 11px

component ChartSummary(peakLabel: string):
    return <foreignObject x="218" y="12" width="120" height="54">
        <div class="chart-summary" look={chartSummaryLook} data-chart-summary>
            <span>Peak traffic</span>
            <strong>{peakLabel}</strong>
        </div>
    </foreignObject>

const chartShellLook = look:
    marginTop = 22px
    padding = 22px
    border = border(1px, rule)
    borderRadius = 16px
    background = surface

const chartLook = look:
    display = "block"
    width = 100%
    height = "auto"
    minHeight = 220px

component TrafficChart(points: List<TrafficPoint>, maxValue: number, peakLabel: string):
    const scale = ChartScale(maxValue)

    return <section class="chart-shell" look={chartShellLook} aria-labelledby="traffic-heading">
        <h2 id="traffic-heading">Weekly traffic</h2>
        <svg class="chart" look={chartLook} data-trend-chart role="img" aria-labelledby="traffic-chart-title traffic-chart-description" viewBox="0 0 360 190">
            <title id="traffic-chart-title">Weekly visitor traffic</title>
            <desc id="traffic-chart-description">A bar chart of visitors from Monday through Sunday.</desc>
            <line x1="12" y1={scale.top} x2="348" y2={scale.top} stroke="#e6ecf4" />
            <line x1="12" y1={scale.baseline} x2="348" y2={scale.baseline} stroke="#cbd6e5" />
            {points.map(point => <TrafficBar key={point.id} point={point} scale={scale} />)}
            <ChartSummary peakLabel={peakLabel} />
        </svg>
    </section>

const dashboardLook = look:
    width = 100%
    minHeight = 100vh
    padding = spacing(48px, 16px)
    color = ink
    background = paper
    fontFamily = "Inter, ui-sans-serif, system-ui, sans-serif"

const dashboardInnerLook = look:
    width = 100%
    maxWidth = 980px
    marginInline = "auto"
const toolbarLook = look:
    display = "flex"
    alignItems = "center"
    justifyContent = "space-between"
    gap = 16px

const refreshLook = look:
    padding = spacing(10px, 14px)
    border = border(0px, color("transparent"))
    borderRadius = 10px
    color = surface
    background = primary
    cursor = "pointer"
    if @disabled:
        opacity = 0.55

const gridLook = look:
    display = "grid"
    gridTemplateColumns = repeat(4, minmax(0px, 1fr))
    gap = 16px
    marginTop = 22px

    if viewport.width <= 860px:
        gridTemplateColumns = repeat(2, minmax(0px, 1fr))

    if viewport.width <= 520px:
        gridTemplateColumns = tracks(1fr)

def statusLook(failed: bool) -> Look:
    return look:
        if failed:
            color = danger

component Dashboard:
    resource dashboard: DashboardData = loadDashboard()
    computed payload = dashboard.value
    computed failure = dashboard.error

    def status() -> WebNode:
        if dashboard.loading:
            return <p class="status" look={statusLook(false)} aria-busy="true">Loading dashboard...</p>
        if failure:
            return <p class="status" look={statusLook(true)} role="alert">{failure.message}</p>
        return <p class="status" look={statusLook(false)}></p>

    return <main class="dashboard" look={dashboardLook} data-dashboard><div look={dashboardInnerLook}>
        <header class="toolbar" look={toolbarLook}>
            <div>
                <h1>VelarScript Metrics</h1>
                <p>Updated: {payload ? payload.updatedAt : "not yet"}</p>
            </div>
            <button look={refreshLook} data-refresh type="button" disabled={dashboard.loading} on:click={dashboard.reload}>Refresh</button>
        </header>
        {status()}
        <section class="grid" look={gridLook} aria-label="Current metrics">
            {payload ? payload.metrics.map(metric => <MetricCard key={metric.id} metric={metric} />) : <></>}
        </section>
        {payload ? <TrafficChart points={payload.traffic} maxValue={payload.trafficMax} peakLabel={payload.peakLabel} /> : null}
    </div></main>

mount(<Dashboard />, "#app")
