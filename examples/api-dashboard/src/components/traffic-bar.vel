import {ChartScale, TrafficPoint} from "../chart.vel"
import {rgb} from "velar/look"

const barLook = look:
    fill = rgb(35, 87, 217)

const labelLook = look:
    fill = rgb(96, 112, 139)
    fontFamily = "Inter, ui-sans-serif, system-ui, sans-serif"
    fontSize = 12px

export component TrafficBar(point: TrafficPoint, scale: ChartScale):
    const height = computed(() => scale.heightFor(point.value))
    const y = computed(() => scale.yFor(point.value))

    return <g data-chart-bar={point.id}>
        <rect class="bar" look={barLook} x={point.x} y={y()} width="24" height={height()} rx="5" />
        <text class="label" look={labelLook} x={point.x + 12} y="174" text-anchor="middle">{point.label}</text>
    </g>
