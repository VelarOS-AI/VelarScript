import {border, color, rgb, spacing} from "velar/look"

def counterLook(active: bool) -> Look:
    return look:
        padding = spacing(10px, 14px)
        border = border(0px, color("transparent"))
        borderRadius = 10px

        if active:
            color = rgb(37, 99, 235)

export component Counter(start: number = 0):
    state count = start
    computed doubled = count * 2

    def increment() -> null:
        count += 1

    watch count as current, previous:
        print(f"{previous} -> {current}")

    mounted:
        print("counter mounted")

    cleanup:
        print("counter cleanup")

    return <button
        class="counter"
        look={counterLook(count > 0)}
        on:click={increment}
    >
        Count: {count}, Double: {doubled}
    </button>

mount(<Counter start={1} />, "#app")
