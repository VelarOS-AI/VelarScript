type User:
    id: string
    name: string
    avatar: string?

type Workspace:
    id: string
    labels: Record<string>

class Player:
    const name: string
    let score: number

    constructor(name: string, score: number = 0):
        self.name = name
        self.score = score

    def addScore(points: number) -> null:
        self.score += points

    def label() -> string:
        return f"{self.name}: {self.score}"

def activeNames(users: List<User>) -> List<string>:
    return users.map(user => user.name)

def labelFor(labels: Record<string>, key: string) -> string:
    return labels[key] ?? "unlabelled"

const raw = {
    id: "user-1",
    name: "Ada",
    avatar: null,
}

const user = User.parse(raw)
const {name: displayName} = user
const users = [user]
const names = activeNames(users)
const firstName = names[0]
const namedUserCount = names.map(name => name == "" ? 0 : 1).reduce((total, count) => total + count, 0)

const scores = Map()
scores.set(user.id, 10)
const savedScore = scores.get(user.id)

const labels: Record<string> = {tier: "gold"}
const workspace = Workspace.parse({id: "workspace-1", labels: labels})
print(labelFor(workspace.labels, "tier"))

const player = Player(user.name)
player.addScore(savedScore ?? 0)

if raw is User:
    print(player.label())

print(f"{displayName}: {str(namedUserCount)}")

for current in users:
    print(current.name)

for id in scores:
    print(id)

let index = 0
while index < users.size:
    print(users[index].name)
    index += 1

try:
    print(firstName)
catch error:
    print(error.message)
finally:
    print("done")
