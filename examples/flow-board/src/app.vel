import {Link, Router, lazy, route} from "velar/web"
import {Board} from "./pages/board.vel"

component RouteLoading:
    return <main aria-busy="true"><p>Loading project view…</p></main>

component RouteFailed(error: Error):
    return <main role="alert"><h1>View unavailable</h1><p>{error.message}</p></main>

const Analytics = lazy(() => import("./pages/analytics.vel"), "Analytics", RouteLoading, RouteFailed)
const routes = [route("/", Board), route("/analytics", Analytics)]

const shellLook = look:
    minHeight = 100vh
    color = Look.rgb(23, 32, 51)
    background = Look.linearGradient(145deg, Look.rgb(223, 232, 255), Look.rgb(246, 248, 252))
    fontFamily = "Inter, ui-sans-serif, system-ui, sans-serif"

const topbarLook = look:
    position = "sticky"
    zIndex = 10
    top = 0px
    display = "flex"
    alignItems = "center"
    justifyContent = "space-between"
    minHeight = 62px
    padding = Look.spacing(0px, 20px)
    borderBottom = Look.border(1px, Look.rgba(205, 214, 230, 0.8))
    background = Look.rgba(246, 248, 252, 0.94)
    backdropFilter = "blur(16px)"

const brandLook = look:
    color = Look.rgb(23, 32, 51)
    fontWeight = 900
    letterSpacing = -0.03em
    textDecoration = "none"
const navLook = look:
    display = "flex"
    gap = 8px

const navLinkLook = look:
    padding = Look.spacing(8px, 10px)
    borderRadius = 9px
    color = Look.rgb(89, 101, 122)
    fontSize = 14px
    fontWeight = 700
    textDecoration = "none"
    if @hover:
        color = Look.rgb(35, 69, 174)
        background = Look.rgb(232, 237, 250)

export component App:
    return <div class="shell" look={shellLook}>
        <header class="topbar" look={topbarLook}>
            <Link look={brandLook} to="/">FlowBoard</Link>
            <nav look={navLook} aria-label="Primary navigation">
                <Link look={navLinkLook} to="/">Board</Link>
                <Link look={navLinkLook} to="/analytics">Analytics</Link>
            </nav>
        </header>
        <Router routes={routes} />
    </div>
