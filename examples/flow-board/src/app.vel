import {Link, Router, lazy, route} from "velar/web"
import {Board} from "./pages/board.vel"

component RouteLoading:
    return <main aria-busy="true"><p>Loading project view…</p></main>

component RouteFailed(error: Error):
    return <main role="alert"><h1>View unavailable</h1><p>{error.message}</p></main>

const Analytics = lazy(() => import("./pages/analytics.vel"), "Analytics", RouteLoading, RouteFailed)
const routes = [route("/", Board), route("/analytics", Analytics)]

const shellLook = look:
    minHeight = 100vh
    color = rgb(23, 32, 51)
    background = linearGradient(145deg, rgb(223, 232, 255), rgb(246, 248, 252))
    font = "Inter, ui-sans-serif, system-ui, sans-serif"

const topbarLook = look:
    position = sticky
    zIndex = 10
    top = 0px
    display = flex
    alignItems = center
    justifyContent = spaceBetween
    minHeight = 62px
    padding = space(0px, 20px)
    borderBottom = line(1px, rgba(205, 214, 230, 0.8))
    background = rgba(246, 248, 252, 0.94)
    backdropFilter = "blur(16px)"

const brandLook = look:
    color = rgb(23, 32, 51)
    fontWeight = 900
    letterSpacing = -0.03em
    textDecoration = undecorated

const navLook = look:
    display = flex
    gap = 8px

const navLinkLook = look:
    padding = space(8px, 10px)
    radius = 9px
    color = rgb(89, 101, 122)
    fontSize = 14px
    fontWeight = 700
    textDecoration = undecorated

    if @hover:
        color = rgb(35, 69, 174)
        background = rgb(232, 237, 250)

export component App:
    return <div class="shell" look={shellLook}>
        <header class="topbar" look={topbarLook}>
            <Link look={brandLook} to="/">FlowBoard</Link>
            <nav look={navLook} aria-label="Primary navigation"><Link look={navLinkLook} to="/">Board</Link><Link look={navLinkLook} to="/analytics">Analytics</Link></nav>
        </header>
        <Router routes={routes} />
    </div>
