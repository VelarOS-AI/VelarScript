import {Link, Router, lazy, route} from "velar/web"
import {Board} from "./pages/board.vel"

component RouteLoading:
    return <main aria-busy="true"><p>Loading project view…</p></main>

component RouteFailed(error: Error):
    return <main role="alert"><h1>View unavailable</h1><p>{error.message}</p></main>

const Analytics = lazy(() => import("./pages/analytics.vel"), "Analytics", RouteLoading, RouteFailed)
const routes = [route("/", Board), route("/analytics", Analytics)]

export component App:
    style global:
        :root {
            color-scheme: light;
            font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
            color: #172033;
            background: #f6f8fc;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: radial-gradient(circle at 10% -20%, #dfe8ff 0, transparent 32rem), #f6f8fc;
        }

        button, input, select {
            font: inherit;
        }

    style:
        .shell {
            min-height: 100vh;
        }

        .topbar {
            position: sticky;
            z-index: 10;
            top: 0;
            display: flex;
            align-items: center;
            justify-content: space-between;
            min-height: 62px;
            padding: 0 max(20px, calc((100vw - 1240px) / 2));
            border-bottom: 1px solid rgba(205, 214, 230, 0.8);
            background: rgba(246, 248, 252, 0.88);
            backdrop-filter: blur(16px);
        }

        .brand {
            color: #172033;
            font-weight: 900;
            letter-spacing: -0.03em;
            text-decoration: none;
        }

        nav {
            display: flex;
            gap: 8px;
        }

        nav a {
            padding: 8px 10px;
            border-radius: 9px;
            color: #59657a;
            font-size: 14px;
            font-weight: 700;
            text-decoration: none;
        }

        nav a:hover {
            color: #2345ae;
            background: #e8edfa;
        }

    return <div class="shell">
        <header class="topbar">
            <Link to="/">FlowBoard</Link>
            <nav aria-label="Primary navigation"><Link to="/">Board</Link><Link to="/analytics">Analytics</Link></nav>
        </header>
        <Router routes={routes} />
    </div>
