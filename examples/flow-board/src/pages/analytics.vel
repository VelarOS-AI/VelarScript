import {countBy, sortBy} from "velar/collections"
import {format} from "velar/time"
import {Head, Link} from "velar/web"
import {Task} from "../domain.vel"
import {doingCount, doneCount, tasks, todoCount} from "../store.vel"

type MetricValue = string | number

def metricText(value: MetricValue) -> string:
    if value is number:
        return str(value)
    else:
        return value

def completion(total: number, done: number) -> number:
    if total == 0:
        return 0
    return (done / total * 100).round()

def progressLabel(progress: number) -> string:
    if progress == 100:
        return "Complete"
    else if progress >= 50:
        return "On track"
    else if progress > 0:
        return "Getting started"
    else:
        return "Not started"

def lastUpdated(values: List<Task>) -> string:
    if values.size == 0:
        return "No activity yet"
    const ordered = sortBy(values, task => task.updatedAt, true)
    const latest = ordered.get(0)
    assert latest != null else "A non-empty task list must have a latest task"
    return format(latest.updatedAt)

const pageLook = look:
    display = "grid"
    gap = 24px
    width = 100%
    maxWidth = 980px
    marginInline = "auto"
    padding = spacing(42px, 16px, 64px, 16px)

const backLook = look:
    color = rgb(49, 87, 213)
    fontWeight = 700
    textDecoration = "none"
const titleLook = look:
    margin = 0
    color = rgb(21, 32, 58)
    fontSize = 42px
    letterSpacing = -0.04em

const leadLook = look:
    margin = spacing(8px, 0px, 0px, 0px)
    color = rgb(110, 121, 141)

const metricsLook = look:
    display = "grid"
    gridTemplateColumns = repeat(4, 1fr)
    gap = 12px

    if viewport.width <= 720px:
        gridTemplateColumns = repeat(2, 1fr)

const surfaceLook = look:
    border = border(1px, rgb(220, 227, 239))
    borderRadius = 18px
    background = rgb(255, 255, 255)
    boxShadow = shadow(0px, 12px, 34px, rgba(35, 50, 82, 0.06))

const metricLook = look:
    ...surfaceLook
    display = "grid"
    gap = 7px
    padding = 18px

const metricValueLook = look:
    color = rgb(23, 32, 51)
    fontSize = 30px

const metricLabelLook = look:
    color = rgb(116, 128, 151)
    fontSize = 13px

const progressLook = look:
    gridColumn = "1 / -1"
    height = 9px
    overflow = "hidden"
    borderRadius = 9999px
    background = rgb(232, 237, 245)

def progressFillLook(progress: number) -> Look:
    return look:
        width = progress * 1%
        height = 100%
        borderRadius = 9999px
        background = linearGradient(90deg, rgb(49, 87, 213), rgb(92, 125, 240))

const sectionLook = look:
    ...surfaceLook
    display = "grid"
    gap = 14px
    padding = 20px

const sectionTitleLook = look:
    margin = 0

const priorityGridLook = look:
    display = "grid"
    gridTemplateColumns = repeat(3, 1fr)
    gap = 10px

const priorityLook = look:
    display = "flex"
    alignItems = "center"
    justifyContent = "space-between"
    padding = spacing(12px, 14px)
    borderRadius = 12px
    color = rgb(70, 81, 106)
    background = rgb(241, 244, 249)
    textTransform = "capitalize"
const activityListLook = look:
    display = "grid"
    gap = 10px
    margin = 0
    padding = 0
    listStyle = "none"
const activityItemLook = look:
    display = "flex"
    justifyContent = "space-between"
    gap = 16px
    paddingTop = 10px
    borderTop = border(1px, rgb(237, 240, 245))
    color = rgb(49, 60, 84)

const timeLook = look:
    color = rgb(129, 139, 157)
    fontSize = 12px

export component Analytics:
    computed progress = completion(tasks.size, doneCount)
    computed progressState = progressLabel(progress)
    computed priorityRows = countBy(tasks, task => task.priority).entries()
    const recent = sortBy(tasks, task => task.updatedAt, true)

    return <main class="page" look={pageLook} data-analytics>
        <Head title="FlowBoard analytics" description="Project flow and recent task activity" themeColor="#f6f8fc" />
        <Link look={backLook} to="/">← Back to board</Link>
        <header><h1 look={titleLook}>Project pulse</h1><p class="lead" look={leadLook}>A compact view of throughput and the work that changed most recently.</p></header>
        <section class="metrics" look={metricsLook} aria-label="Project metrics">
            <article class="metric" look={metricLook}><strong look={metricValueLook}>{metricText(tasks.size)}</strong><span look={metricLabelLook}>Total tasks</span></article>
            <article class="metric" look={metricLook}><strong look={metricValueLook}>{metricText(todoCount)}</strong><span look={metricLabelLook}>Waiting</span></article>
            <article class="metric" look={metricLook}><strong look={metricValueLook}>{metricText(doingCount)}</strong><span look={metricLabelLook}>In progress</span></article>
            <article class="metric" look={metricLook}><strong look={metricValueLook} data-completion>{metricText(f"{progress}%")}</strong><span look={metricLabelLook} data-progress-label>{progressState}</span></article>
            <div class="progress" look={progressLook} role="progressbar" aria-label="Completion" aria-valuemin="0" aria-valuemax="100" aria-valuenow={progress}><div class="fill" look={progressFillLook(progress)}></div></div>
        </section>
        <section class="activity" look={sectionLook}>
            <div><h2 look={sectionTitleLook}>Recent activity</h2><p>{lastUpdated(tasks)}</p></div>
            <ol look={activityListLook}>{recent.map(task => <li look={activityItemLook} key={task.id}><span>{task.title}</span><time look={timeLook}>{format(task.updatedAt)}</time></li>)}</ol>
        </section>
        <section class="priorities" look={sectionLook}>
            <h2 look={sectionTitleLook}>Priority mix</h2>
            <div class="priority-grid" look={priorityGridLook}>{priorityRows.map(entry => <article class="priority" look={priorityLook} key={entry.key}><span>{entry.key}</span><strong>{entry.value}</strong></article>)}</div>
        </section>
    </main>
