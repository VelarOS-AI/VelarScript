import {Head} from "velar/web"
import {TaskFilter, TaskStatus} from "../domain.vel"
import {addTask, advanceTask, changed, deleteTask, doingCount, doneCount, filter, query, resetBoard, tasks, todoCount, visibleTasks} from "../store.vel"
import {BoardColumn} from "../components/board-column.vel"
import {TaskForm} from "../components/task-form.vel"

const pageLook = look:
    display = "grid"
    gap = 20px
    width = 100%
    maxWidth = 1240px
    marginInline = "auto"
    padding = Look.spacing(26px, 16px, 56px, 16px)

const heroLook = look:
    display = "flex"
    alignItems = "end"
    justifyContent = "space-between"
    gap = 18px

    if viewport.width <= 900px:
        alignItems = "start"
        flexDirection = "column"
const eyebrowLook = look:
    margin = 0
    color = Look.rgb(49, 87, 213)
    fontSize = 12px
    fontWeight = 800
    letterSpacing = 0.12em
    textTransform = "uppercase"
const titleLook = look:
    margin = Look.spacing(5px, 0px, 0px, 0px)
    color = Look.rgb(21, 32, 58)
    fontSize = Look.clamp(32px, 5vw, 52px)
    letterSpacing = -0.045em

const introLook = look:
    maxWidth = 590px
    margin = Look.spacing(8px, 0px, 0px, 0px)
    color = Look.rgb(105, 117, 140)
    lineHeight = 1.55

const summaryLook = look:
    display = "flex"
    gap = 8px
    flexWrap = "wrap"
const summaryItemLook = look:
    padding = Look.spacing(7px, 10px)
    border = Look.border(1px, Look.rgb(219, 226, 237))
    borderRadius = 9999px
    color = Look.rgb(83, 96, 121)
    background = Look.rgb(255, 255, 255)
    fontSize = 12px
    fontWeight = 700

const toolsLook = look:
    display = "grid"
    gridTemplateColumns = Look.tracks(1fr, 180px, "auto")
    gap = 10px

    if viewport.width <= 900px:
        gridTemplateColumns = Look.tracks(1fr)

def controlLook(button: bool = false) -> Look:
    return look:
        minHeight = 42px
        border = Look.border(1px, Look.rgb(204, 213, 228))
        borderRadius = 11px
        padding = Look.spacing(0px, 12px)
        color = button ? Look.rgb(89, 101, 122) : Look.rgb(23, 32, 51)
        background = button ? "transparent" : Look.rgb(255, 255, 255)
        cursor = button ? "pointer" : "default"

const resultsLook = look:
    margin = Look.spacing(-8px, 2px, 0px, 2px)
    color = Look.rgb(122, 133, 152)
    fontSize = 13px

const boardLook = look:
    display = "grid"
    gridTemplateColumns = Look.repeat(3, Look.minmax(0px, 1fr))
    gap = 14px

    if viewport.width <= 900px:
        gridTemplateColumns = Look.tracks(1fr)

export component Board:
    return <main class="page" look={pageLook} data-board>
        <Head
            title="FlowBoard · Focused project work"
            description="A real project board built entirely with VelarScript"
            themeColor="#f6f8fc"
        />
        <section class="hero" look={heroLook}>
            <div>
                <p class="eyebrow" look={eyebrowLook}>Today’s focus</p>
                <h1 look={titleLook}>Make work flow.</h1>
                <p class="intro" look={introLook}>
                    Capture the next useful task, move it through the work, and keep the whole project visible without turning the board into another job.
                </p>
            </div>
            <div class="summary" look={summaryLook} aria-label="Board summary">
                <span look={summaryItemLook} data-board-state>{changed() ? "Modified" : "Sample"}</span>
                <span look={summaryItemLook} data-todo-count>{todoCount()} to do</span>
                <span look={summaryItemLook} data-doing-count>{doingCount()} in progress</span>
                <span look={summaryItemLook} data-done-count>{doneCount()} done</span>
            </div>
        </section>

        <TaskForm onCreate={addTask} />

        <section class="tools" look={toolsLook} aria-label="Board filters">
            <input
                look={controlLook()}
                data-search
                bind:value={query}
                aria-label="Search tasks"
                placeholder="Search title or description"
            />
            <select look={controlLook()} data-status-filter bind:value={filter} aria-label="Filter by status">
                <option value={TaskFilter.all}>All statuses</option>
                <option value={TaskFilter.todo}>To do</option>
                <option value={TaskFilter.doing}>In progress</option>
                <option value={TaskFilter.done}>Done</option>
            </select>
            <button look={controlLook(true)} data-reset-board type="button" on:click={resetBoard}>Reset sample</button>
        </section>

        <p class="results" look={resultsLook} data-results>{visibleTasks().size} of {tasks.size} tasks shown</p>
        <section class="board" look={boardLook} aria-label="Task board">
            <BoardColumn
                title="To do"
                status={TaskStatus.todo}
                tasks={visibleTasks()}
                onAdvance={advanceTask}
                onDelete={deleteTask}
            />
            <BoardColumn
                title="In progress"
                status={TaskStatus.doing}
                tasks={visibleTasks()}
                onAdvance={advanceTask}
                onDelete={deleteTask}
            />
            <BoardColumn
                title="Done"
                status={TaskStatus.done}
                tasks={visibleTasks()}
                onAdvance={advanceTask}
                onDelete={deleteTask}
            />
        </section>
    </main>
