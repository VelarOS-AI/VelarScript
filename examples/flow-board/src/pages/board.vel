import {Head} from "velar/web"
import {TaskFilter, TaskStatus} from "../domain.vel"
import {addTask, advanceTask, changed, deleteTask, doingCount, doneCount, filter, query, resetBoard, tasks, todoCount, visibleTasks} from "../store.vel"
import {BoardColumn} from "../components/board-column.vel"
import {TaskForm} from "../components/task-form.vel"

export component Board:
    style:
        .page {
            display: grid;
            gap: 20px;
            width: min(1240px, calc(100% - 32px));
            margin: 0 auto;
            padding: 26px 0 56px;
        }

        .hero {
            display: flex;
            align-items: end;
            justify-content: space-between;
            gap: 18px;
        }

        .eyebrow, h1, .intro {
            margin: 0;
        }

        .eyebrow {
            color: #3157d5;
            font-size: 12px;
            font-weight: 850;
            letter-spacing: 0.12em;
            text-transform: uppercase;
        }

        h1 {
            margin-top: 5px;
            color: #15203a;
            font-size: clamp(32px, 5vw, 52px);
            letter-spacing: -0.045em;
        }

        .intro {
            max-width: 590px;
            margin-top: 8px;
            color: #69758c;
            line-height: 1.55;
        }

        .summary {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
        }

        .summary span {
            padding: 7px 10px;
            border: 1px solid #dbe2ed;
            border-radius: 999px;
            color: #536079;
            background: #fff;
            font-size: 12px;
            font-weight: 750;
        }

        .tools {
            display: grid;
            grid-template-columns: 1fr 180px auto;
            gap: 10px;
        }

        .tools input, .tools select, .tools button {
            min-height: 42px;
            border-radius: 11px;
            font: inherit;
        }

        .tools input, .tools select {
            border: 1px solid #ccd5e4;
            padding: 0 12px;
            color: #172033;
            background: #fff;
        }

        .tools button {
            border: 1px solid #ccd5e4;
            padding: 0 13px;
            color: #59657a;
            background: transparent;
            cursor: pointer;
        }

        .board {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 14px;
        }

        .results {
            margin: -8px 2px 0;
            color: #7a8598;
            font-size: 13px;
        }

        @media (max-width: 900px) {
            .hero {
                align-items: start;
                flex-direction: column;
            }

            .tools, .board {
                grid-template-columns: 1fr;
            }
        }

    return <main class="page" data-board>
        <Head title="FlowBoard · Focused project work" description="A real project board built entirely with Velar" themeColor="#f6f8fc" />
        <section class="hero">
            <div>
                <p class="eyebrow">Today’s focus</p>
                <h1>Make work flow.</h1>
                <p class="intro">Capture the next useful task, move it through the work, and keep the whole project visible without turning the board into another job.</p>
            </div>
            <div class="summary" aria-label="Board summary">
                <span data-board-state>{changed ? "Modified" : "Sample"}</span>
                <span data-todo-count>{todoCount} to do</span>
                <span data-doing-count>{doingCount} in progress</span>
                <span data-done-count>{doneCount} done</span>
            </div>
        </section>

        <TaskForm onCreate={addTask} />

        <section class="tools" aria-label="Board filters">
            <input data-search bind:value={query} aria-label="Search tasks" placeholder="Search title or description" />
            <select data-status-filter bind:value={filter} aria-label="Filter by status">
                <option value={TaskFilter.all}>All statuses</option>
                <option value={TaskFilter.todo}>To do</option>
                <option value={TaskFilter.doing}>In progress</option>
                <option value={TaskFilter.done}>Done</option>
            </select>
            <button data-reset-board type="button" on:click={resetBoard}>Reset sample</button>
        </section>

        <p class="results" data-results>{visibleTasks.length} of {tasks.length} tasks shown</p>
        <section class="board" aria-label="Task board">
            <BoardColumn title="To do" status={TaskStatus.todo} tasks={visibleTasks} onAdvance={advanceTask} onDelete={deleteTask} />
            <BoardColumn title="In progress" status={TaskStatus.doing} tasks={visibleTasks} onAdvance={advanceTask} onDelete={deleteTask} />
            <BoardColumn title="Done" status={TaskStatus.done} tasks={visibleTasks} onAdvance={advanceTask} onDelete={deleteTask} />
        </section>
    </main>
