import {storage} from "velar/storage"
import {deepEqual} from "velar/json"
import {BoardData, Task, TaskDraft, TaskFilter, TaskStatus, countStatus, filterTasks, moveTask as moveInList, newTask, removeTask as removeFromList, seedTasks} from "./domain.vel"

const boardStorage = storage.scope("flow-board")
const baseline = seedTasks()
const initial: BoardData = {tasks: baseline}
const persisted = boardStorage.get("board", BoardData, initial)

export state tasks: List<Task> = persisted.tasks.copy()
export state query = ""
export state filter: TaskFilter = TaskFilter.all
export const visibleTasks: () -> List<Task> = computed(() => filterTasks(tasks, query, filter))
export const todoCount: () -> number = computed(() => countStatus(tasks, TaskStatus.todo))
export const doingCount: () -> number = computed(() => countStatus(tasks, TaskStatus.doing))
export const doneCount: () -> number = computed(() => countStatus(tasks, TaskStatus.done))
export const changed: () -> bool = computed(() => not deepEqual(tasks, baseline))

def persist() -> null:
    boardStorage.set("board", {tasks})

export def addTask(draft: TaskDraft) -> null:
    tasks.append(newTask(draft))
    persist()

export def advanceTask(id: string) -> null:
    moveInList(tasks, id)
    persist()

export def deleteTask(id: string) -> null:
    tasks = removeFromList(tasks, id)
    persist()

export def resetBoard() -> null:
    tasks = seedTasks()
    query = ""
    filter = TaskFilter.all
    persist()
