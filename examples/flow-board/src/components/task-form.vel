import {CreateTaskHandler, TaskPriority} from "../domain.vel"
import {border, color, minmax, rgb, rgba, shadow, spacing, tracks} from "velar/look"

const composerLook = look:
    display = "grid"
    gridTemplateColumns = tracks(minmax(180px, 1.4fr), minmax(220px, 2fr), 140px, "auto")
    gap = 10px
    padding = 14px
    border = border(1px, rgb(220, 227, 239))
    borderRadius = 18px
    background = rgba(255, 255, 255, 0.9)
    boxShadow = shadow(0px, 16px, 45px, rgba(35, 50, 82, 0.08))

    if viewport.width <= 820px:
        gridTemplateColumns = tracks(1fr)

const fieldLook = look:
    minWidth = 0px
    minHeight = 42px
    border = border(1px, rgb(207, 216, 232))
    borderRadius = 11px
    padding = spacing(0px, 12px)
    color = rgb(23, 32, 51)
    background = rgb(255, 255, 255)

const submitLook = look:
    minWidth = 0px
    minHeight = 42px
    border = border(0px, color("transparent"))
    borderRadius = 11px
    padding = spacing(0px, 18px)
    color = rgb(255, 255, 255)
    background = rgb(49, 87, 213)
    fontWeight = 700
    cursor = "pointer"
const errorLook = look:
    gridColumn = "1 / -1"
    margin = 0
    color = rgb(180, 35, 24)
    fontSize = 14px

export component TaskForm(onCreate: CreateTaskHandler):
    state title = ""
    state description = ""
    state priority: TaskPriority = TaskPriority.normal
    state error = ""

    def submit():
        if title.isBlank():
            error = "Give the task a clear title."
        else:
            onCreate({title, description, priority})
            title = ""
            description = ""
            priority = TaskPriority.normal
            error = ""

    return <form class="composer" look={composerLook} on:submit.prevent={submit} aria-label="Create task">
        <input
            look={fieldLook}
            data-title-input
            bind:value={title}
            aria-label="Task title"
            placeholder="What needs to be done?"
        />
        <input
            look={fieldLook}
            data-description-input
            bind:value={description}
            aria-label="Task description"
            placeholder="Add a useful detail"
        />
        <select look={fieldLook} data-priority-input bind:value={priority} aria-label="Priority">
            <option value={TaskPriority.low}>Low priority</option>
            <option value={TaskPriority.normal}>Normal priority</option>
            <option value={TaskPriority.high}>High priority</option>
        </select>
        <button look={submitLook} data-add-task type="submit">Add task</button>
        {error != "" ? <p class="error" look={errorLook} role="alert">{error}</p> : <></>}
    </form>
