import {format} from "velar/time"

import {Task, TaskIdHandler, TaskPriority, TaskStatus} from "../domain.vel"

def statusAction(status: TaskStatus) -> string:
    match status:
        case TaskStatus.todo:
            return "Start"
        case TaskStatus.doing:
            return "Complete"
        case TaskStatus.done:
            return "Reopen"

def cardLook(high: bool, done: bool) -> Look:
    return look:
        display = "grid"
        gap = 12px
        padding = 16px
        border = Look.border(1px, Look.rgb(224, 230, 240))
        borderLeft = Look.border(high ? 4px : 1px, high ? Look.rgb(229, 72, 77) : Look.rgb(224, 230, 240))
        borderRadius = 15px
        background = Look.rgb(255, 255, 255)
        boxShadow = Look.shadow(0px, 8px, 24px, Look.rgba(38, 54, 88, 0.06))
        opacity = done ? 0.72 : 1

const titleLook = look:
    margin = 0
    color = Look.rgb(23, 32, 51)
    fontSize = 16px

const descriptionLook = look:
    margin = 0
    color = Look.rgb(93, 104, 128)
    fontSize = 14px
    lineHeight = 1.45

const rowLook = look:
    display = "flex"
    alignItems = "center"
    justifyContent = "space-between"
    gap = 8px

const priorityLook = look:
    padding = Look.spacing(4px, 8px)
    borderRadius = 9999px
    color = Look.rgb(67, 80, 106)
    background = Look.rgb(237, 241, 248)
    fontSize = 12px
    fontWeight = 700
    textTransform = "capitalize"
const timeLook = look:
    color = Look.rgb(125, 135, 156)
    fontSize = 11px

def actionLook(dangerous: bool = false) -> Look:
    return look:
        border = Look.border(0px, Look.color("transparent"))
        padding = Look.spacing(7px, 10px)
        borderRadius = 9px
        color = dangerous ? Look.rgb(159, 45, 45) : Look.rgb(35, 69, 174)
        background = dangerous ? "transparent" : Look.rgb(233, 239, 255)
        fontSize = 13px
        fontWeight = 700
        cursor = "pointer"
export component TaskCard(task: Task, onAdvance: TaskIdHandler, onDelete: TaskIdHandler):
    return <article class="card" look={cardLook(task.priority == TaskPriority.high, task.status == TaskStatus.done)} data-task data-task-id={task.id}>
        <h3 look={titleLook} data-task-title>{task.title}</h3>
        <p class="description" look={descriptionLook}>{task.description}</p>
        <div class="meta" look={rowLook}>
            <span class="priority" look={priorityLook}>{task.priority}</span>
            <time look={timeLook}>{format(task.updatedAt)}</time>
        </div>
        <div class="actions" look={rowLook}>
            <button class="move" look={actionLook()} data-move-task type="button" on:click={() => onAdvance(task.id)}>
                {statusAction(task.status)}
            </button>
            <button
                class="delete"
                look={actionLook(true)}
                data-delete-task
                type="button"
                aria-label={f"Delete {task.title}"}
                on:click={() => onDelete(task.id)}
            >
                Delete
            </button>
        </div>
    </article>
