import {uuid} from "velar/id"
import {now} from "velar/time"

export enum TaskStatus:
    todo
    doing
    done

export enum TaskPriority:
    low
    normal
    high

export enum TaskFilter:
    all
    todo
    doing
    done

export type Task:
    id: string
    title: string
    description: string
    status: TaskStatus
    priority: TaskPriority
    createdAt: number
    updatedAt: number

export type BoardData:
    tasks: List<Task>

export type TaskDraft:
    title: string
    description: string
    priority: TaskPriority

export type TaskIdHandler = (string) -> null
export type CreateTaskHandler = (TaskDraft) -> null

export def seedTasks() -> List<Task>:
    return [
        {id: "seed-design", title: "Finish the component states", description: "Review empty, loading, and error states before handoff.", status: TaskStatus.todo, priority: TaskPriority.high, createdAt: 1785542400000, updatedAt: 1785542400000},
        {id: "seed-compiler", title: "Validate the new compiler build", description: "Run the browser suite in Chromium, Firefox, and WebKit.", status: TaskStatus.doing, priority: TaskPriority.normal, createdAt: 1785628800000, updatedAt: 1785628800000},
        {id: "seed-preview", title: "Share the preview with the team", description: "The verified preview is ready for product review.", status: TaskStatus.done, priority: TaskPriority.low, createdAt: 1785715200000, updatedAt: 1785715200000},
    ]

export def newTask(draft: TaskDraft) -> Task:
    const timestamp = now()
    match draft:
        case {title, description, priority}:
            return {
                id: uuid(),
                title: title.trim(),
                description: description.trim(),
                status: TaskStatus.todo,
                priority,
                createdAt: timestamp,
                updatedAt: timestamp,
            }

export def advanceStatus(status: TaskStatus) -> TaskStatus:
    match status:
        case TaskStatus.todo:
            return TaskStatus.doing
        case TaskStatus.doing:
            return TaskStatus.done
        case TaskStatus.done:
            return TaskStatus.todo

export def moveTask(tasks: List<Task>, id: string):
    const timestamp = now()
    const task = tasks.find(candidate => candidate.id == id)
    if task != null:
        task.status = advanceStatus(task.status)
        task.updatedAt = timestamp

export def removeTask(tasks: List<Task>, id: string) -> List<Task>:
    return tasks.filter(task => task.id != id)

def matchesFilter(task: Task, filter: TaskFilter) -> bool:
    match filter:
        case TaskFilter.all:
            return true
        case TaskFilter.todo:
            return task.status == TaskStatus.todo
        case TaskFilter.doing:
            return task.status == TaskStatus.doing
        case TaskFilter.done:
            return task.status == TaskStatus.done

export def filterTasks(tasks: List<Task>, query: string, filter: TaskFilter) -> List<Task>:
    const needle = query.trim().lower()
    return tasks.filter(task => matchesFilter(task, filter) and (needle.size == 0 or needle in task.title.lower() or needle in task.description.lower()))

export def countStatus(tasks: List<Task>, status: TaskStatus) -> number:
    return tasks.filter(task => task.status == status).size
