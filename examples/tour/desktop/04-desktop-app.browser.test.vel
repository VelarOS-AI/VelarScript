// Chapter 04 — the Desktop browser test, where the `velar/desktop-test`
// exports actually run.
//
// Authority: the same module interface chapter 03 lists, plus D57 rule 138 for
// why `velar/web-test` is imported here rather than anywhere else. Under
// `velar test --browser` the framework host answers the Desktop bridge, so this
// is the one place a fixture round is a call and not a description.
//
// The window half of the module is the same idea one level up: the fake window
// registry answers `velar/window` for the page, and the four event helpers let
// this test produce the host events a real window system would.

import {DesktopPlatform, PermissionStatus, PowerState, SystemPermission} from "velar/desktop"
import {activateNotification, appDataDirectory, closeWindow, dropFiles, focusWindow, makeDirectory, moveWindow, openWindows, openedLinks, projectDirectory, publishPower, readText, removeFile, secureStorageNames, setNotificationPermission, setPlatform, setSystemPermission, setWindowKind, shownNotifications, writeText} from "velar/desktop-test"
import {NotificationPermission} from "velar/notification"
import {browser} from "velar/web-test"
import {expect} from "velar/test"
import {fixturePath} from "./03-desktop-test.test.vel"
import {previewKey} from "./05-windows.vel"
import {buildTag} from "./06-notifications.vel"
import {sessionSlot} from "./07-secure-storage.vel"
import {guideUrl} from "./08-system.vel"

test "the explicit platform fixture selects an application branch before open":
    await setPlatform(DesktopPlatform.macos)
    await browser.open()
    await browser.click("[data-read-summary]")
    await browser.waitForText("[data-summary]", "macos|false")

test "the host directories the test process sees are absolute":
    await browser.open()
    const data = await appDataDirectory()
    const project = await projectDirectory()
    expect(data.startsWith("/")).toBe(true)
    expect(project.startsWith("/")).toBe(true)

test "a fixture round writes, reads back, and removes":
    await browser.open()
    const data = await appDataDirectory()
    const folder = fixturePath(data, "round")
    const file = f"{folder}/note.txt"
    await makeDirectory(folder)
    await writeText(file, "written by the tour")
    expect(await readText(file, 4096)).toBe("written by the tour")
    await writeText(file, "rewritten by the tour")
    expect(await readText(file, 4096)).toBe("rewritten by the tour")
    await removeFile(file)

test "the renderer is an ordinary Web page":
    await browser.open()
    expect(await browser.text("[data-chapter='01'] h2")).toBe("01 — the Desktop host")
    expect(await browser.text("[data-chapter='02'] h2")).toBe("02 — checked host capabilities")
    expect(await browser.text("[data-boundary]")).toBe("Product tooling stays outside the Desktop language framework.")
    await browser.click("[data-read-summary]")
    await browser.waitForText("[data-summary]", "|")

test "the window kind is chosen before the document exists, like the platform":
    await setWindowKind("note-preview")
    await browser.open()
    await browser.click("[data-read-kind]")
    await browser.waitForText("[data-window-kind]", "running as note-preview")

test "the launch window is the one the manifest always declares":
    await browser.open()
    const open = await openWindows()
    expect(open).toHaveLength(1)
    expect(open.get(0)?.kind).toBe("main")
    expect(open.get(0)?.key).toBe(null)
    expect(open.get(0)?.focused).toBe(true)

test "opening a second declared kind joins the registry and takes the focus":
    await browser.open()
    await browser.click("[data-open-preview]")
    await browser.waitForText("[data-window-summary]", "on velar-test-display")
    const open = await openWindows()
    expect(open).toHaveLength(2)
    expect(open.map(info => f"{info.kind}:{info.key ?? "-"}:{info.focused}").join(" "))
        .toBe(f"main:-:false note-preview:{previewKey("tour")}:true")
    await browser.click("[data-read-window-summary]")
    await browser.waitForText("[data-window-summary]", "note-preview")
    // Opening the same kind and key again focuses what is already open rather
    // than adding a second window.
    await focusWindow("main")
    await browser.click("[data-open-preview]")
    await browser.waitForText("[data-window-summary]", "on velar-test-display")
    expect(await openWindows()).toHaveLength(2)

test "releasing an owned window closes it":
    await browser.open()
    await browser.click("[data-measure-preview]")
    await browser.waitForText("[data-window-geometry]", "512x320")
    const open = await openWindows()
    expect(open).toHaveLength(1)
    expect(open.get(0)?.kind).toBe("main")

test "a window state stream is a bounded pull source that ends after closed":
    await browser.open()
    await browser.click("[data-watch-preview]")
    await browser.waitForText("[data-window-watched]", "watching")
    // A move that also changes the size is two states, not one, because the
    // two questions a consumer asks about them are different.
    await moveWindow("note-preview", previewKey("watched"), {x: 40, y: 60, width: 480, height: 300})
    await closeWindow("note-preview", previewKey("watched"))
    await browser.waitForText("[data-window-watched]", "3 states")
    expect(await openWindows()).toHaveLength(1)

test "this window's own bounds read back through the borrowed handle":
    await browser.open()
    await browser.click("[data-read-window-geometry]")
    await browser.waitForText("[data-window-geometry]", "1040x720")

// The operating system's answer is the second gate, and the fake notification
// centre answers it exactly as the real one does: undetermined until something
// says otherwise, and a notification it never authorized fails rather than
// vanishing.
test "a notification is delivered only once the operating system authorizes it":
    await browser.open()
    await browser.click("[data-deliver-notification]")
    await browser.waitForText("[data-notification-delivered]", "not notified: undetermined")
    expect(await shownNotifications()).toHaveLength(0)
    await setNotificationPermission(NotificationPermission.granted)
    await browser.click("[data-deliver-notification]")
    await browser.waitForText("[data-notification-delivered]", f"notified: {buildTag("42")}")
    const inbox = await shownNotifications()
    expect(inbox).toHaveLength(1)
    expect(inbox.get(0)?.title).toBe("Build finished")
    expect(inbox.get(0)?.body).toBe("3 packages")
    expect(inbox.get(0)?.tag).toBe(buildTag("42"))

test "an activation reports the notification the user clicked":
    await browser.open()
    await setNotificationPermission(NotificationPermission.granted)
    await browser.click("[data-ask-notification]")
    await browser.waitForText("[data-notification-permission]", "granted")
    await browser.click("[data-watch-activations]")
    await browser.waitForText("[data-notification-activated]", "watching")
    await activateNotification(buildTag("42"))
    await browser.waitForText("[data-notification-activated]", f"activated {buildTag("42")}")

// The keychain seam reports the names it holds and never the values it holds,
// which is the whole point of the module.
test "a stored credential is present until it is removed":
    await browser.open()
    await browser.click("[data-read-session]")
    await browser.waitForText("[data-session-presence]", "absent")
    expect(await secureStorageNames()).toHaveLength(0)
    await browser.click("[data-save-session]")
    await browser.waitForText("[data-session-presence]", "present")
    expect(await secureStorageNames()).toEqual([sessionSlot])
    await browser.click("[data-forget-session]")
    await browser.waitForText("[data-session-presence]", "absent")
    expect(await secureStorageNames()).toHaveLength(0)

test "power is a transition stream, so the state the machine is in publishes nothing":
    await browser.open()
    await browser.click("[data-watch-power]")
    await browser.waitForText("[data-power]", "watching")
    // The host starts awake, so waking is not a transition and the stream stays
    // where it was.
    await publishPower(PowerState.resumed)
    await publishPower(PowerState.suspended)
    await browser.waitForText("[data-power]", "suspended")

test "a link opens through a granted scheme, and the probes only read":
    await browser.open()
    await browser.click("[data-open-link]")
    await browser.waitForText("[data-opened-link]", f"opened {guideUrl}")
    expect(await openedLinks()).toEqual([guideUrl])
    await browser.click("[data-read-displays]")
    await browser.waitForText("[data-displays]", "velar-test-display:1440x875@2:true")
    await setSystemPermission(SystemPermission.microphone, PermissionStatus.granted)
    await browser.click("[data-read-probes]")
    await browser.waitForText("[data-probe]", "undetermined/granted")

test "a drag gesture reports its real paths in the order they were dropped":
    await browser.open()
    await browser.click("[data-watch-drops]")
    await browser.waitForText("[data-dropped]", "watching")
    await dropFiles(["/Users/ada/second.txt", "/Users/ada/first.txt"])
    await browser.waitForText("[data-dropped]", "second.txt first.txt")
