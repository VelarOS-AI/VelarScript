// The Desktop tour's entry module.
//
// Same rule as the Web tour: `velar check` does not check a `.vel` the entry
// cannot reach, so each chapter exports a name and this file imports it. The
// two test modules go through the CLI's second pass on their own.
//
// A Desktop project mounts one root into one system WebView; there is no
// renderer/main split, so this entry is the same shape a Web entry has.

import {HostPanel} from "./01-desktop-host.vel"
import {CapabilityPanel} from "./02-capabilities.vel"
import {WindowPanel} from "./05-windows.vel"
import {NotificationPanel} from "./06-notifications.vel"
import {SecureStoragePanel} from "./07-secure-storage.vel"
import {SystemPanel} from "./08-system.vel"
import {DropPanel} from "./09-dropped-files.vel"
import {UpdatePanel} from "./10-updates.vel"
import {ServicePanel} from "./11-services.vel"

component Tour:
    return <div id="tour">
        <HostPanel />
        <CapabilityPanel />
        <WindowPanel />
        <NotificationPanel />
        <SecureStoragePanel />
        <SystemPanel />
        <DropPanel />
        <UpdatePanel />
        <ServicePanel />
    </div>

mount(<Tour />, "#app")
