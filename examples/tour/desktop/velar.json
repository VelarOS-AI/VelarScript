{
  "formatVersion": 2,
  "kind": "application",
  "entry": "main.vel",
  "outDir": "dist/renderer",
  "publicDir": "public",
  "extensions": [
    "@velarscript/desktop"
  ],
  "surfaces": {
    "core": "0.3",
    "desktop": "0.10"
  },
  "desktop": {
    "productName": "VelarScript Desktop tour",
    "identifier": "dev.velarscript.tour",
    "windows": {
      "main": {
        "width": 1040,
        "height": 720,
        "minWidth": 640,
        "minHeight": 480
      },
      "note-preview": {
        "title": "Note preview",
        "style": "panel",
        "frame": false,
        "level": "floating",
        "material": "sidebar",
        "titleBar": "hidden-inset",
        "visibleOnAllWorkspaces": true,
        "aspectRatio": 1.6,
        "width": 512,
        "height": 320,
        "minWidth": 480,
        "minHeight": 300
      }
    },
    "services": {
      "notes-index": {
        "payload": "service-notes-index",
        "entry": "main.js",
        "restart": "always"
      }
    },
    "permissions": {
      "files": [
        "app-data",
        "project",
        "dropped"
      ],
      "processes": [],
      "network": [],
      "environment": [],
      "secrets": [],
      "links": [
        "https",
        "mailto"
      ],
      "notifications": true,
      "secureStorage": [
        "TOUR_SESSION"
      ]
    }
  }
}
