import {
    HttpProblem,
    HttpOutcome,
    Request,
    Provider,
    RouteDocumentation,
    RoutePattern,
    ServeApp,
    ServeResponse,
    Upload,
    background,
    bodyLimit,
    clearCookie,
    created,
    docs,
    file,
    input,
    json,
    lifecycle,
    middleware,
    noContent,
    openapi,
    prefix,
    provide,
    redirect,
    respond,
    security,
    setCookie,
    sse,
    staticFiles,
    stream,
    text,
    use,
} from "velar/serve"
import {sha256Text} from "velar/hash"
import {authenticate} from "velar/server"

type CreateArticle:
    title: string

type CurrentUser:
    id: string

type UploadMetadata:
    title: string

async def verifyTourToken(token: string) -> CurrentUser?:
    if token != "tour-token": return null
    return {id: "tour-user"}

const currentUser = authenticate(security.bearer(), verifyTourToken)
const requestContext = provide(inputs={}, resolve=async _values => {name: "tour"})
const providerContract = Provider.is(currentUser)
const healthDigest = sha256Text("openvoxel-catalog")
const articlePath: RoutePattern = p"/articles/{id:number}?{details:bool?}"

async def chunks(write: (chunk: string) -> Promise<null>):
    await write("first")
    await write("second")

async def events(send: (event: string) -> Promise<null>): await send("ready")

async def afterResponse(): return null

def uploadName(value: Upload) -> string: return value.filename

async def passThrough(request: Request, next: () -> Promise<ServeResponse>):
    print(request.path)
    return await next()

server routes:
    @get(path=p"/health") => respond({ok: true, digest: healthDigest}, headers=Map([["cache-control", "no-store"]]))

    @get(path=articlePath):
        const id = path.params.id
        if id < 1:
            throw HttpProblem({status: 404, code: "article.not_found", title: "Article not found"})
        return {id, details: path.query.details ?? false}

    @get(path=p"/tags?{tag:string?}") => {tag: path.query.tag}
    @post(path=p"/articles", input: CreateArticle) => created(input)
    @put(path=p"/articles/{id:number}", input: CreateArticle) => {id: path.params.id, title: input.title}
    @patch(path=p"/articles/{id:number}", input: CreateArticle) => {id: path.params.id, title: input.title}
    @delete(path=p"/articles/{id:number}") => noContent()
    @get(path=p"/previous") => redirect("/articles/1")
    @get(path=p"/plain") => text("plain response")
    @get(path=p"/events") => stream(chunks)
    @get(path=p"/sse") => sse(events)
    @get(path=p"/me",
        user = input.dependency(currentUser),
        session = input.cookie("session", default=null),
    ) => {id: user.id, session}
    @get(path=p"/provider", context=input.dependency(requestContext)) => context
    @post(path=p"/upload",
        metadata = input.form(UploadMetadata),
        image = input.upload("image", maxBytes=1_048_576),
    ) => {title: metadata.title, filename: uploadName(image)}
    @get(path=p"/session") => setCookie(background(json({ok: true}), afterResponse), "session", "tour")
    @delete(path=p"/session") => clearCookie(json({ok: true}), "session")
    @get(path=p"/asset") => file("/index.html", root="public")

server composed:
    ...prefix("/api", routes)
    ...staticFiles("/assets", root="public")
    @notFound(request: Request) => {error: "route_not_found", path: request.path}
    @response(outcome: HttpOutcome):
        // @response 中的 json 是最终响应，不会再被框架改写。这里显式沿用语义
        // 结果的状态和响应头，认证失败的 401、WWW-Authenticate 等信息才不会
        // 被统一外壳意外改成普通的 200 JSON。
        if outcome.problem != null:
            return json(
                {ok: false, error: outcome.problem.code},
                status = outcome.status,
                headers = outcome.problem.headers,
            )
        return json({ok: true, data: outcome.value}, status=outcome.status, headers=outcome.headers)

const guarded = use(bodyLimit(composed, 1_048_576), [
    passThrough,
    middleware.requestId(),
    middleware.securityHeaders(),
    middleware.concurrency(256),
])

const owned = lifecycle(guarded, startup=async () => null, shutdown=async () => null)
const articleDocs: RouteDocumentation = {summary: "Read article", tags: ["articles"], errors: Map([[404, "Article not found"]])}
const routeDocs: Map<string, RouteDocumentation> = Map([
    ["GET /api/articles/{id:number}", articleDocs],
])

export const app: ServeApp = docs(
    owned,
    title = "Article API",
    version = "1.0.0",
    routes = routeDocs,
)

export def describeApi(value: ServeApp): openapi(value, title="Article API", version="1.0.0")
