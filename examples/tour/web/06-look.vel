// Chapter 06 — the Look literal: builders, types, units, conditions, targets.
//
// Authority: charter section 17 and its appendix (the published Web visual
// vocabulary). The compiler's own tables are all in packages/web/src/look.ts:
// `LOOK_BUILDERS` (21), `LOOK_PUBLIC_TYPE_NAMES` (17), `LOOK_UNIT_TYPES` (13
// suffixes), `LOOK_HOOKS` (9), `LOOK_TARGETS` (7), `LOOK_MEDIA_SUBJECTS` (3
// subjects, 5 conditions), `LOOK_PROPERTY_GROUPS` (14 families, 225 properties),
// `LOOK_PROPERTY_VALUE_KINDS` (18 value kinds), `LOOK_PROPERTY_KEYWORDS` (a
// closed set per keyword property, 78 of them), and `LOOK_UNITLESS_PROPERTIES`.
//
// `keyframes:` and `animate(...)` are chapter 07; the CSS escape hatch is
// chapter 08.

import {alpha, animate, asset, border, clamp, color, darken, hsl, lighten, linearGradient, max, min, minmax, repeat, rgb, rgba, shadow, spacing, token, tracks, transition} from "velar/look"
import {Angle, Animation, Border, Color, Duration, Image, Keyframes, Length, LengthPercentage, Look, Percentage, Shadow, Spacing, Track, TrackFraction, TrackList, Transition} from "velar/look"

// Twenty of the 21 builders; `token(...)` is the twenty-first and has its own
// section below, because it belongs to no one value kind. `velar/look` exports
// them all as ordinary named values: a builder may be aliased, passed to
// another function, returned, and called outside a Look block like any other
// value. `ink` is exported because chapter 07 animates it: a design token
// declared once travels across modules into a `keyframes:` stop.
export const ink: Color = rgb(24, 31, 46)
const brand: Color = color("rebeccapurple")
const veiled: Color = rgba(24, 31, 46, 0.55)
const sky: Color = hsl(210, 70, 45)
const faded: Color = alpha(ink, 0.4)
const lifted: Color = lighten(ink, 0.2)
const sunk: Color = darken(ink, 0.2)

const hairline: Border = border(1px, faded)
const dashedEdge: Border = border(2px, ink, "dashed")
const raised: Shadow = shadow(0px, 12px, 32px, veiled)
const pressed: Shadow = shadow(0px, 1px, 2px, veiled, spread=0px, inset=true)
const wash: Image = linearGradient(180deg, lifted, sunk)
const mark: Image = asset("/tour-mark.svg")

const flexibleTrack: Track = minmax(120px, 1fr)
const threeUp: TrackList = repeat(3, flexibleTrack)
const explicitTracks: TrackList = tracks(200px, 1fr, minmax(80px, 240px))
const inset1: Spacing = spacing(16px)
const inset2: Spacing = spacing(16px, 20px)
const inset3: Spacing = spacing(16px, 20px, 24px)
const inset4: Spacing = spacing(16px, 20px, 24px, 28px)
const narrow: Length = min(16px, 2rem)
const wide: Length = max(16px, 2rem)
const fluid: Length = clamp(1rem, 4vw, 3rem)

const fade: Transition = transition("opacity", 200ms)
const fadeEased: Transition = transition("opacity", 200ms, "ease-in-out", 50ms)

// A builder is an ordinary value, so it can be aliased, passed to another
// function, and called outside a Look block.
const makeColor = rgb

def buildRamp(build: (number, number, number) -> Color) -> List<Color>: return [build(45, 79, 190), build(90, 120, 220)]

const ramp: Color = makeColor(45, 79, 190)
const rampColors: List<Color> = buildRamp(rgb)

// All 13 unit suffixes. They belong to the language and need no import, and
// they are ordinary reusable values outside Look.
const gutter: Length = 16px
const rootScale: Length = 1rem
const localScale: Length = 2em
const viewportPart: Length = 25vw
const viewportTall: Length = 40vh
const smallSide: Length = 10vmin
const largeSide: Length = 10vmax
const share: Percentage = 75%
const fraction: TrackFraction = 2fr
const quick: Duration = 200ms
const slow: Duration = 1s
const quarterTurn: Angle = 90deg
const halfTurn: Angle = 0.5turn

// Unit arithmetic: addition and subtraction require the same visual dimension,
// mixing Length and Percentage yields LengthPercentage, and a visual value may
// be multiplied or divided by a finite number in either order.
const mixedMetric: LengthPercentage = share - gutter * 2
const doubled: Length = gutter * 2
const preDoubled: Length = 2 * gutter
const halved: Length = gutter / 2
const settle: Duration = slow + quick
const swept: Angle = halfTurn + quarterTurn
const shrunk: Percentage = share - 25%

// Five of the seventeen public type names appear above only as annotations;
// `Look` and `Keyframes` name the two literal forms, and `Animation` names what
// `animate(...)` produces (chapter 07 spends it).
export const spinFrames: Keyframes = keyframes:
    from:
        rotate = 0deg
    to:
        rotate = 1turn

const spinning: Animation = animate(spinFrames, 1s, easing="linear", loop=true)

// One property from each of the 14 published families, and one property for
// each of the 18 value kinds the compiler assigns. CSS keyword values are
// strings because bare identifiers are real VelarScript variables.
export const vocabularyLook: Look = look:
    display = "grid"
    position = "relative"
    boxSizing = "border-box"
    visibility = "visible"
    overflow = "hidden"
    zIndex = 2
    aspectRatio = 1.5

    gridTemplateColumns = threeUp
    gridTemplateRows = explicitTracks
    gridAutoFlow = "row"
    gridColumn = "1 / -1"
    gridTemplateAreas = "
        head head
        side main
    "

    flexDirection = "row"
    flexGrow = 1
    flexShrink = 0
    flexBasis = 240px
    gap = gutter
    alignItems = "center"
    justifyContent = "space-between"

    width = fluid
    minWidth = narrow
    maxWidth = wide
    height = "auto"
    top = 8px

    padding = inset2
    paddingInline = inset1
    margin = inset4
    marginBlock = inset3

    backgroundColor = brand
    backgroundImage = mark
    backgroundSize = 100%
    backgroundPosition = 50%
    backgroundRepeat = "no-repeat"

    border = hairline
    borderRadius = 14px
    outline = dashedEdge
    outlineOffset = 2px

    boxShadow = raised
    textShadow = pressed
    opacity = 1
    filter = "saturate(1.1)"
    backdropFilter = "blur(4px)"

    color = ink
    fontFamily = "Inter, ui-sans-serif, system-ui, sans-serif"
    fontSize = rootScale
    fontWeight = 600
    lineHeight = 1.5
    letterSpacing = localScale / 32
    textAlign = "start"
    textTransform = "none"
    whiteSpace = "normal"

    listStyle = "none"

    fill = sky
    stroke = veiled
    strokeWidth = 2px

    translate = 0px
    scale = 1
    rotate = 0deg
    transform = "translateZ(0)"
    transformOrigin = 50%
    transitionDuration = quick
    transitionDelay = 0ms
    animation = spinning

    cursor = "pointer"
    userSelect = "none"
    accentColor = ramp
    caretColor = ink
    colorScheme = "light"

    scrollBehavior = "smooth"
    scrollMarginTop = 12px
    scrollSnapAlign = "start"
    scrollbarWidth = "thin"

// Every published property name that is not a CSS shorthand, once, grouped by
// the family the compiler assigns it. Nothing here is a design; it is the
// vocabulary, so that a formatter or property-table change has to walk the whole
// table before it can pass.
//
// The shorthands are in the two Looks below rather than here, and that split is
// the vocabulary too: D104 rule 2 refuses a shorthand beside a longhand it
// writes, because a Look entry lowers to its own CSS rule and those rules are
// ordered by where each property first appears in the module — so a block
// holding both has no winner it chose. `border` gets a third Look for the same
// reason it needs one: it writes `borderWidth` and the four side shorthands,
// which are themselves shorthands.
const everyPropertyLook: Look = look:
    // layout and containment
    display = "none"
    position = "static"
    boxSizing = "content-box"
    isolation = "isolate"
    contain = "layout"
    visibility = "visible"
    zIndex = 1
    overflowX = "visible"
    overflowY = "visible"
    resize = "none"
    clip = "auto"
    clipPath = "inset(0)"
    objectFit = "fill"
    objectPosition = "center"
    aspectRatio = 1

    // grid
    gridTemplateColumns = threeUp
    gridTemplateRows = threeUp
    gridTemplateAreas = "
        head head
        side main
    "
    gridAutoColumns = threeUp
    gridAutoRows = threeUp
    gridAutoFlow = "column"
    gridColumnStart = "1"
    gridColumnEnd = "-1"
    gridRowStart = "1"
    gridRowEnd = "2"

    // flex and alignment
    flexDirection = "row"
    flexGrow = 1
    flexShrink = 1
    flexBasis = 4px
    flexWrap = "nowrap"
    order = 1
    rowGap = 4px
    columnGap = 4px
    alignItems = "normal"
    justifyItems = "normal"
    justifyContent = "normal"
    alignContent = "normal"
    alignSelf = "auto"
    justifySelf = "auto"

    // size and inset
    width = 4px
    height = 4px
    minWidth = 4px
    maxWidth = 4px
    minHeight = 4px
    maxHeight = 4px
    inlineSize = 4px
    blockSize = 4px
    minInlineSize = 4px
    maxInlineSize = 4px
    minBlockSize = 4px
    maxBlockSize = 4px
    top = 4px
    right = 4px
    bottom = 4px
    left = 4px
    insetInlineStart = 4px
    insetInlineEnd = 4px
    insetBlockStart = 4px
    insetBlockEnd = 4px

    // spacing
    paddingTop = 4px
    paddingRight = 4px
    paddingBottom = 4px
    paddingLeft = 4px
    paddingInlineStart = 4px
    paddingInlineEnd = 4px
    paddingBlockStart = 4px
    paddingBlockEnd = 4px
    marginTop = 4px
    marginRight = 4px
    marginBottom = 4px
    marginLeft = 4px
    marginInlineStart = 4px
    marginInlineEnd = 4px
    marginBlockStart = 4px
    marginBlockEnd = 4px

    // background
    backgroundColor = ink
    backgroundImage = mark
    backgroundPosition = "center"
    backgroundSize = "cover"
    backgroundRepeat = "repeat"
    backgroundAttachment = "scroll"
    backgroundClip = "border-box"
    backgroundOrigin = "border-box"
    backgroundBlendMode = "normal"

    // border and outline
    borderTopWidth = 4px
    borderRightWidth = 4px
    borderBottomWidth = 4px
    borderLeftWidth = 4px
    borderTopStyle = "none"
    borderRightStyle = "none"
    borderBottomStyle = "none"
    borderLeftStyle = "none"
    borderTopColor = ink
    borderRightColor = ink
    borderBottomColor = ink
    borderLeftColor = ink
    borderTopLeftRadius = 4px
    borderTopRightRadius = 4px
    borderBottomRightRadius = 4px
    borderBottomLeftRadius = 4px
    outlineWidth = 4px
    outlineStyle = "none"
    outlineColor = ink
    outlineOffset = 4px

    // effects
    boxShadow = raised
    textShadow = raised
    opacity = 1
    filter = "saturate(1.1)"
    backdropFilter = "blur(4px)"
    content = ""

    // typography and international text
    color = ink
    fontFamily = "Inter, ui-sans-serif, system-ui, sans-serif"
    fontSize = 4px
    fontWeight = 1
    fontStyle = "normal"
    fontStretch = "normal"
    fontVariant = "none"
    fontKerning = "auto"
    fontOpticalSizing = "auto"
    fontFeatureSettings = "'liga' 1"
    fontVariationSettings = "'wght' 600"
    lineHeight = 1.5
    verticalAlign = "text-bottom"
    letterSpacing = 4px
    wordSpacing = 4px
    textAlign = "start"
    textIndent = 4px
    textDecorationColor = ink
    textDecorationLine = "none"
    textDecorationStyle = "solid"
    textDecorationThickness = 4px
    textUnderlineOffset = 4px
    textUnderlinePosition = "auto"
    textTransform = "none"
    textRendering = "auto"
    whiteSpace = "normal"
    textOverflow = "clip"
    textWrap = "wrap"
    overflowWrap = "normal"
    wordBreak = "normal"
    hyphens = "none"
    tabSize = 1
    writingMode = "horizontal-tb"
    textOrientation = "mixed"
    direction = "ltr"
    unicodeBidi = "normal"

    // lists
    listStyleType = "none"
    listStylePosition = "outside"
    listStyleImage = mark

    // SVG paint
    fill = ink
    stroke = ink
    strokeWidth = 4px
    strokeLinecap = "butt"
    strokeLinejoin = "miter"
    strokeDasharray = "4 2"
    strokeDashoffset = 4px

    // transform and transition
    translate = 4px
    scale = 1
    rotate = 0deg
    transform = "translateZ(0)"
    transformOrigin = "center"
    transitionProperty = "opacity"
    transitionDuration = 200ms
    transitionDelay = 200ms
    transitionTimingFunction = "ease-in-out"
    animation = spinning

    // interaction and form theme
    cursor = "auto"
    pointerEvents = "auto"
    userSelect = "auto"
    touchAction = "auto"
    appearance = "none"
    accentColor = ink
    caretColor = ink
    colorScheme = "normal"

    // scroll
    scrollBehavior = "auto"
    scrollMarginTop = 4px
    scrollMarginRight = 4px
    scrollMarginBottom = 4px
    scrollMarginLeft = 4px
    scrollPaddingTop = 4px
    scrollPaddingRight = 4px
    scrollPaddingBottom = 4px
    scrollPaddingLeft = 4px
    scrollSnapAlign = "none"
    scrollSnapStop = "normal"
    scrollSnapType = "none"
    overscrollBehaviorX = "none"
    overscrollBehaviorY = "none"
    scrollbarColor = "auto"
    scrollbarWidth = "auto"

// The published shorthands, apart from the two below. Each one writes longhands
// the Look above writes, which is why they cannot share a block.
const everyShorthandLook: Look = look:
    overflow = "visible"
    gridColumn = "1 / -1"
    gridRow = "1 / 2"
    flex = 1
    gap = 4px
    placeItems = "normal"
    placeContent = "normal"
    placeSelf = "auto"
    inset = 4px
    insetInline = 4px
    insetBlock = 4px
    padding = 4px
    paddingInline = 4px
    paddingBlock = 4px
    margin = 4px
    marginInline = 4px
    marginBlock = 4px
    background = wash
    borderWidth = 4px
    borderStyle = "none"
    borderColor = ink
    borderTop = hairline
    borderRight = hairline
    borderBottom = hairline
    borderLeft = hairline
    borderRadius = 4px
    outline = hairline
    textDecoration = "none"
    listStyle = "none"
    transition = fade
    scrollMargin = 4px
    scrollPadding = 4px
    overscrollBehavior = "none"

// The two shorthands whose parts are themselves shorthands: `border` writes
// `borderWidth`, `borderStyle`, `borderColor` and the four side shorthands, and
// `gridArea` writes `gridRow` and `gridColumn`.
const everyNestedShorthandLook: Look = look:
    border = hairline
    gridArea = "main"

export const propertyVocabulary: Look = everyPropertyLook

// Seven properties whose CSS keywords are part of the published vocabulary, not
// only their unit values. `isolation` and `contain` have nothing but keywords;
// the three position and size properties take a length, a percentage, or a
// placement word; and the two transition longhands take a property name and an
// easing from the same closed sets `transition(...)` and `animate(...)` use.
export const keywordValueLook: Look = look:
    isolation = "isolate"
    contain = "content"
    backgroundImage = mark
    backgroundSize = "contain"
    backgroundPosition = "top"
    transformOrigin = "left"
    transitionProperty = "background-color"
    transitionDuration = quick
    transitionTimingFunction = "ease-out"

// Every keyword property carries its own closed set, so the vocabulary above is
// each property's real CSS vocabulary rather than a shared list of common
// words. These spellings are the evidence: a shared list has no reason to hold
// `groove`, `upper-roman` or `optimizeLegibility`, and it would just as happily
// have taken `strokeLinecap = "none"` — a declaration the browser discards.
export const closedKeywordLook: Look = look:
    borderTopStyle = "ridge"
    borderRightStyle = "inset"
    borderBottomStyle = "outset"
    borderLeftStyle = "double"
    outlineStyle = "auto"
    backgroundBlendMode = "multiply"
    fontStretch = "semi-condensed"
    fontVariant = "tabular-nums"
    textDecorationStyle = "wavy"
    textRendering = "optimizeLegibility"
    listStyleType = "upper-roman"
    listStylePosition = "inside"
    strokeLinecap = "round"
    strokeLinejoin = "bevel"
    scrollSnapStop = "always"
    overscrollBehaviorX = "contain"
    overscrollBehaviorY = "auto"

// A closed set holds the whole CSS value, not a token of one: `y mandatory` is
// what an author knows this value as, so it is what he writes. Nothing here is
// a new syntax or a new builder — every value below is one string, and one CSS
// declaration.
export const multiTokenKeywordLook: Look = look:
    objectPosition = "top left"
    gridAutoFlow = "column dense"
    textDecorationLine = "underline line-through"
    textUnderlinePosition = "under left"
    listStyle = "lower-alpha"
    colorScheme = "light dark"
    scrollSnapType = "y mandatory"
    scrollSnapAlign = "start end"
    overscrollBehavior = "contain none"

// A property publishes its whole CSS vocabulary, and where it publishes only a
// part, the part it left out is named in the diagnostic that rejects it. These
// are the values that used to be refused: the one-way pans a scroll container
// really takes, the alignment positions that resolve against the box's own
// axis, the display type a list marker needs, the one-axis background repeat,
// and the resize cursor a pannable canvas uses.
export const wholeVocabularyLook: Look = look:
    touchAction = "pan-left"
    alignItems = "self-start"
    alignSelf = "first baseline"
    alignContent = "last baseline"
    justifyItems = "self-end"
    justifySelf = "baseline"
    display = "list-item"
    backgroundRepeat = "repeat no-repeat"
    cursor = "all-scroll"

// The shorthands the Looks above would otherwise carry, kept together because
// each of them writes a longhand one of those Looks writes. D104 rule 2 refuses
// that pair in one scope: a Look entry lowers to its own CSS rule, and the
// stylesheet orders those rules by where each property first appears in the
// module rather than by the block, so a scope holding both a shorthand and its
// longhand has no winner it chose. Nine values, one lesson — a shorthand is a
// whole declaration, and it belongs where nothing it writes is written again.
export const shorthandCompanionLook: Look = look:
    flex = 1
    inset = 0px
    background = wash
    transition = fade
    borderStyle = "groove"
    textDecoration = "underline overline"
    placeItems = "self-start"
    placeContent = "flex-end"
    placeSelf = "self-end"

// A design system's contract is a set of CSS custom properties, and `token()`
// is the one checked spelling that reads one. It is legal in every Look
// property — the metrics, the colour, the shadow, the transition and the font
// below are all the same call — and it lowers to `var(--name)` while the module
// compiles. What the compiler checks is the *reference*: the name is a literal
// CSS custom property identifier, or the declaration is refused. The value
// behind the name belongs to the design system, which is what makes a theme
// able to swap it without recompiling this module.
export const shellChromeLook: Look = look:
    width = token("--shell-sidebar-expanded-width")
    minWidth = token("--shell-sidebar-collapsed-width")
    padding = token("--ui-space-panel")
    borderRadius = token("--ui-radius-panel")
    boxShadow = token("--shell-sidebar-shadow")
    transition = token("--ui-transition-fast")
    color = token("--ui-color-foreground")
    background = token("--ui-color-surface")
    fontFamily = token("--ui-font-family")
    backdropFilter = token("--shell-sidebar-backdrop-filter")

    if scheme.dark:
        boxShadow = token("--shell-sidebar-shadow-dark")
    if @hover:
        background = token("--ui-color-surface-hover")

// The three properties whose CSS grammar is `<position>` read one table and
// take one kind of value: a length, a percentage, or any of the twenty-two
// placements. `backgroundPosition = "top left"` is the same value in the same
// spelling as `objectPosition = "top left"`.
export const positionLook: Look = look:
    objectPosition = 25%
    backgroundPosition = "top left"
    transformOrigin = "bottom right"

// The 9 element states and the 7 pseudo-element targets. Conditions may appear
// inside a target and a target may appear inside a condition; a target may not
// appear inside another target.
export const statefulLook: Look = look:
    ...vocabularyLook
    background = brand

    if @hover:
        background = lifted
    if @focus:
        outlineColor = sky
    if @focusVisible:
        outlineOffset = 3px
    if @active:
        opacity = 0.8
    if @current:
        fontWeight = 700
    if @disabled:
        opacity = 0.5
    if @checked:
        borderColor = sky
    if @invalid:
        borderColor = sunk
    if @open:
        maxHeight = "none"

    @before:
        content = "•"

        if @hover:
            content = "▸"

    @after:
        content = ""
        display = "block"
    @backdrop:
        background = veiled
    @placeholder:
        color = faded
    @selection:
        background = lifted
    @marker:
        color = ink
    @fileSelectorButton:
        cursor = "pointer"

// The whole media vocabulary: `viewport.width`, `viewport.height`,
// `scheme.dark`, `scheme.light`, and `motion.reduced`. Thresholds compare
// against compile-time px, rem, or em values, which may be a local or imported
// const unit token or a field of a const token record. Media subjects compose
// with element states and with each other, and `not scheme.dark` is the same
// condition as `scheme.light`.
const compact: Length = 720px
const breakpoints = {wide: 1200px}

export const responsiveLook: Look = look:
    padding = inset2

    if viewport.width <= compact:
        padding = 12px
    if viewport.height >= 600px:
        marginBlock = 8px
    if viewport.width > breakpoints.wide:
        gap = 24px
    if scheme.dark:
        color = lifted
        background = sunk
    if scheme.light:
        color = sunk
    if motion.reduced:
        transition = null
    else if scheme.dark and viewport.width <= compact:
        padding = 10px
    else:
        padding = inset3

    @before:
        if viewport.width <= compact:
            content = "compact"

// Composition happens once at the outer level, and later declarations follow
// normal CSS cascade order. A Look value has reference identity, so two
// separately written literals with identical bodies are not `==` equal even
// though they compile to one shared rule.
export const controlLook: Look = look:
    padding = spacing(10px, 14px)
    borderRadius = 10px

export const primaryControlLook: Look = look:
    ...controlLook
    color = rgb(255, 255, 255)
    background = ramp

// A `look:` literal is built once, where it is written, so it cannot read
// reactive state — the read would be a snapshot that never updates. Reactive
// visuals live on the element instead: `look={...}` chooses a whole Look and
// `look:property={...}` sets one property, and a `null` value removes the
// controlled property rather than emitting the text "null".
export component LookPanel:
    state hot = false

    def toggle(): hot = not hot

    return <section data-chapter="06">
        <h2>06 — Look</h2>
        <div data-vocabulary look={vocabularyLook}>every published family</div>
        <div data-property-vocabulary look={propertyVocabulary}></div>
        <div data-shorthand-vocabulary look={everyShorthandLook}></div>
        <div data-nested-shorthand-vocabulary look={everyNestedShorthandLook}></div>
        <div data-shorthand-companion look={shorthandCompanionLook}>a shorthand keeps its own scope</div>
        <div data-keyword-values look={keywordValueLook}>keyword values, not only units</div>
        <div data-closed-keywords look={closedKeywordLook}>each property's own closed set</div>
        <div data-multi-token-keywords look={multiTokenKeywordLook}>whole CSS values, not tokens</div>
        <div data-whole-vocabulary look={wholeVocabularyLook}>the whole vocabulary, or a named part of it</div>
        <div data-position look={positionLook}>one grammar, one kind, one table</div>
        <div data-shell-chrome look={shellChromeLook}>design tokens, checked</div>
        <div data-stateful look={statefulLook}>states and targets</div>
        <div data-responsive look={responsiveLook}>media conditions</div>
        <button type="button" data-control look={controlLook}>base control</button>
        <button type="button" data-primary-control look={primaryControlLook}>composed control</button>
        <p
            data-reactive-look
            look={hot ? primaryControlLook : controlLook}
            look:color={hot ? brand : ink}
            look:borderColor={hot ? sky : null}
        >
            reactive visuals
        </p>
        <p data-units>
            {f"{gutter} {share} {fraction} {quick} {quarterTurn} {doubled} {preDoubled} {halved} {settle} {swept} {shrunk} {rootScale} {localScale} {viewportPart} {viewportTall} {smallSide} {largeSide} {slow} {halfTurn}"}
        </p>
        <p data-composites look:width={mixedMetric} look:transition={fadeEased} look:boxShadow={pressed}>
            composite values have no text form
        </p>
        <button type="button" data-toggle-hot on:click={toggle}>Toggle</button>
    </section>
