// Chapter 03 — synchronous reactivity: `state`, `computed`, and `watch`.
//
// Authority: charter section 15, first half. `state`, `computed` and `watch`
// are three of the contextual keywords in packages/web/src/lexer.ts, and a
// derived value has exactly one spelling: the `computed` declaration.
//
// The four declaration words are one grid, and the whole chapter is an
// elaboration of it:
//
//                 not reactive        reactive
//     writable    let                 state
//     read-only   const               computed
//
// `state` is to `let` what `computed` is to `const`. Reading that grid is the
// point: `const` promises the value never changes, and `computed` is the word
// for a value that is derived and therefore does.
//
// Asynchronous data — `resource` and `action` — is chapter 04.

export type Task:
    id: string
    title: string
    done: bool

// Scope 1: module scope. A module `state` lives for the life of the page and
// every importer sees the same cell. Assigning an imported binding is
// forbidden; mutating the value inside one is legal and publishes to everyone.
export state visits = 0
export state tasks: List<Task> = [
    {id: "read", title: "Read the chapter", done: false},
    {id: "write", title: "Write a module", done: false},
]

// An exported `computed` crosses the module boundary as a live value, exactly
// as an exported `state` does: importers read `openTasks` bare and recompute
// together, and none of them can assign it.
export computed openTasks = tasks.filter(task => not task.done).size

// A module-scope watch is never disposed, so it is for application-wide facts
// rather than anything a component owns.
watch visits:
    print(f"visit {visits}")

export def recordVisit():
    visits += 1

// Helpers may mutate the value owned by a state binding; state does not copy,
// freeze, or claim linear ownership.
export def retitle(task: Task, title: string):
    task.title = title

export def completeFirst():
    tasks[0].done = true

export def appendTask(task: Task):
    tasks.append(task)

// The four cells of the grid, side by side, over one fact. `counted` is a plain
// number computed once; `draft` is the same number in a cell nobody watches;
// `selectedTask` is a watched cell; `liveFirstTask` is a formula that recomputes
// whenever the tasks change. Only the last two move on their own, and only the
// two on the writable column can be assigned.
component TheFourCells:
    let draft = tasks.size
    const counted = tasks.size
    state selectedTask = tasks[0]
    computed liveFirstTask = tasks[0]

    def selectSecond():
        selectedTask = tasks[1]
        draft += 1

    return <div data-snapshots>
        <p data-let-count>{draft}</p>
        <p data-const-count>{counted}</p>
        <p data-state-task>{selectedTask.title}</p>
        <p data-computed-task>{liveFirstTask.title}</p>
        <button type="button" data-select-second on:click={selectSecond}>Select the second task</button>
    </div>

// Scope 2: component scope, and scope 3: ordinary block or function scope. Each
// function execution creates a distinct cell, and closures capture that cell
// normally.
component ScopedState:
    state expanded = false
    computed label = expanded ? "Hide" : "Show"

    def counterFromBlock() -> () -> number:
        state local = 0

        def bump() -> number:
            local += 1
            return local

        return bump

    const bump = counterFromBlock()
    state bumped = 0

    def toggle():
        expanded = not expanded

    def bumpLocal():
        bumped = bump()

    return <div data-scoped-state>
        <p data-label>{label}</p>
        <p data-expanded>{expanded ? "expanded" : "collapsed"}</p>
        <p data-bumped>{bumped}</p>
        <button type="button" data-toggle-expanded on:click={toggle}>{label}</button>
        <button type="button" data-bump-local on:click={bumpLocal}>Bump the block cell</button>
    </div>

// The three `watch` spellings. The expression is evaluated immediately to
// establish the dependency and the baseline, and the body runs only for later
// changes. Both names are required when `as` is present, so a body that needs
// only the new value writes `as current, _`.
//
// A watch that writes state says which state, in its header: `writes name`,
// separated by commas for several. A watch with no `writes` clause only
// observes, and a write it performs anyway is refused — by the compiler where
// the compiler can see it, and by the runtime where it cannot.
component WatchSpellings:
    state query = ""
    state history: List<string> = []
    state changes = 0

    watch query writes changes:
        changes += 1

    watch query as current, previous writes history:
        history.append(f"{previous}→{current}")

    watch query as current, _:
        print(f"query is now {current}")

    // Record properties and collection keys are tracked independently, so a
    // watch on one field is not woken by a change to another.
    watch tasks[0].done:
        print("the first task changed its done flag")

    return <div data-watch-spellings>
        <input data-query type="search" bind:value={query} />
        <p data-changes>{changes}</p>
        <p data-history>{history.join(",")}</p>
    </div>

// A derived value that also mutates is a side effect hiding in a cache, and
// `watch` is the spelling that says so. These two stand side by side for
// exactly that comparison.
//
// A subject names what to watch: a `state` or a `computed`, or a read path out
// of one. The subjects that are refused, against the ones here that are not:
//
//     watch trimmed:         // accepted — a computed changes
//     watch term:            // accepted — a state changes
//     watch tasks[0].done:   // accepted — a read path names a place
//     watch 5:               // refused — a literal never changes
//     watch effectLabel:     // refused — a plain const never changes
//     watch term + "!":      // refused — an operator computes a value
//     watch term.trim():     // refused — so does a call
//
// The first two refusals used to compile clean and carry a body that could
// never run, and they have no correct spelling. The last two do, and it is the
// same one for both: give the value a name — `computed shouted = term + "!"` —
// and watch the name.
//
// The body is governed the same way, by the header rather than by inference:
//
//     watch trimmed writes effectRuns:   // accepted — the write is declared
//     watch trimmed:                     // refused — the body writes effectRuns
component DerivationVersusEffect:
    state term = ""
    state effectRuns = 0
    const effectLabel = "runs"

    computed trimmed = term.trim()
    computed shouted = trimmed.upper()

    watch trimmed writes effectRuns:
        effectRuns += 1

    return <div data-derivation>
        <input data-term type="text" bind:value={term} />
        <p data-trimmed>{trimmed}</p>
        <p data-shouted>{shouted}</p>
        <p data-effect-runs>{effectLabel}: {effectRuns}</p>
    </div>

// There is no second spelling of a derived value: `computed` declares it and
// it caches. Where a *callable* is what the receiver wants — a record of
// readers, a callback handed to another function — write an ordinary `def`
// over the derived value; the call is then visible at the reading site, and
// the cache is still the computed's.
//
// A reader is not the value it reads, which makes it the third refused
// subject — and the one whose body used to compile clean and never run:
//
//     watch readDoubled:     // refused — that names the reader, not its value
//     watch doubled:         // accepted — the value the reader reads
component DerivedAndCallable:
    state amount = 1
    computed doubled = amount * 2

    def readDoubled() -> number:
        return doubled

    const readers = {doubled: readDoubled}

    def raise():
        amount += 1

    return <div data-derived-callable>
        <p data-doubled>{readers.doubled()}</p>
        <button type="button" data-raise on:click={raise}>Raise</button>
    </div>

export component ReactivePanel:
    computed summary = f"{openTasks} of {tasks.size} open"

    def complete():
        completeFirst()

    def rename():
        retitle(tasks[1], "Write two modules")

    def add():
        appendTask({id: f"extra-{tasks.size}", title: "An appended task", done: false})

    return <section data-chapter="03">
        <h2>03 — state and derived values</h2>
        <p data-summary>{summary}</p>
        <p data-visits>{visits}</p>
        <button type="button" data-record-visit on:click={recordVisit}>Record a visit</button>
        <button type="button" data-complete-first on:click={complete}>Complete the first task</button>
        <button type="button" data-retitle on:click={rename}>Retitle through a helper</button>
        <button type="button" data-append on:click={add}>Append a task</button>
        <TheFourCells />
        <ScopedState />
        <WatchSpellings />
        <DerivationVersusEffect />
        <DerivedAndCallable />
    </section>
