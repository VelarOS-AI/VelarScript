{
  "formatVersion": 2,
  "kind": "application",
  "entry": "main.vel",
  "outDir": "dist",
  "publicDir": "public",
  "extensions": ["@velarscript/web"],
  "surfaces": {
    "core": "0.6",
    "web": "0.12"
  },
  "web": {
    "title": "VelarScript Web tour",
    "base": "/",
    "publicConfig": {
      "apiBase": "/api",
      "channel": "tour",
      "features": {
        "realtime": false
      }
    }
  }
}
