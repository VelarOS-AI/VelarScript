/// Chapter 11 — `try`/`catch`/`finally`, the nine error classes, the `try`
/// expression, and `assert`.
///
/// Charter section 11. Discrimination is the class; `code` is that same
/// identity in string form.

type Config:
    retries: number

// ---------------------------------------------------------------------------
// try / catch / finally
// ---------------------------------------------------------------------------

async def save(): print("saved")

def close(): print("closed")

export async def tryCatchFinally() -> string:
    try: await save()
    catch error: return error.message
    finally: close()
    return "ok"

// `catch` with no `finally`, and `try`/`finally` with no `catch`.
export def catchOnly(values: List<number>) -> number:
    try: return values[99]
    catch error: return -1

export def finallyOnly() -> string:
    try: return "body"
    finally: close()

// The Error contract's own members.
export def errorContract(error: Error) -> string:
    const message = error.message
    const name = error.name
    const code = error.code
    const stack = error.stack
    const cause = error.cause
    return f"{message} {name} {code} {stack} {cause == null}"

// ---------------------------------------------------------------------------
// The three compiler-raised classes
// ---------------------------------------------------------------------------

export def compilerRaised(untrusted: unknown, values: List<number>) -> string:
    try:
        const config = Config.parse(untrusted)
        return str(values[config.retries])
    catch error:
        if error is ValidationError:
            // `ValidationError` carries the detail its parse site reports.
            return f"{error.path} {error.field} {error.reason}"
        if error is NarrowingError: return "a stale flow fact"
        if error is IndexError: return "an out-of-range position"
        throw error

// Each may be constructed and thrown directly.
export def constructAndThrow(kind: string):
    if kind == "validation": throw ValidationError("bad shape")
    if kind == "narrowing": throw NarrowingError("stale fact")
    if kind == "index": throw IndexError("out of range")
    throw Error("ordinary")

// ---------------------------------------------------------------------------
// The five capability classes: reserved Core bindings, no import needed
// ---------------------------------------------------------------------------

export def capabilityRecovery(error: Error) -> string:
    if error is FileNotFoundError: return f"missing: {error.path}"
    else if error is PermissionError: return f"refused: {error.path}"
    else if error is NotADirectoryError: return f"not a directory: {error.path}"
    else if error is FileExistsError: return f"already there: {error.path}"
    else if error is AddressInUseError: return "bind another port, or port 0 for any free one"
    else: return error.message

// `code` is the class name in string form, and it always agrees with `is`.
export def crossesAJsonBoundary(error: Error) -> string:
    return Json.stringify({code: error.code, message: error.message})

// ---------------------------------------------------------------------------
// Custom hierarchies extend `Error`
// ---------------------------------------------------------------------------

class TimeoutError extends Error:
    constructor(message: string, const seconds: number): super(message)

class SlowTimeoutError extends TimeoutError:
    constructor(seconds: number): super("far too slow", seconds)

export def customHierarchy(error: Error) -> string:
    // An `Error` subclass reports under its declared name.
    if error is SlowTimeoutError: return f"{error.name} {error.code} {error.seconds}"
    if error is TimeoutError: return f"{error.name} after {error.seconds}"
    return error.name

// `finally` is cleanup, not a control-flow override: a loop wholly inside one
// may still use its own `break` and `continue`.
export def loopInsideFinally(values: List<number>) -> number:
    let seen = 0
    try: seen += 1
    finally:
        for value in values:
            if value < 0: continue
            if value > 10: break
            seen += value
    return seen

// ---------------------------------------------------------------------------
// Expected failure as an optional: the `try` expression
// ---------------------------------------------------------------------------

def readPort() -> number: return 8080

async def load(url: string) -> string: return url

export async def tryExpression(untrusted: unknown, url: string) -> string:
    const parsed = try Config.parse(untrusted)
    const port = try readPort() ?? 8080
    const body = try await load(url)
    // `try` reaches exactly as far as `await` does — over the whole postfix
    // chain — so a failure anywhere in the chain produces one `null`.
    const chained = try url.trim().upper().slice(0, 3)
    return f"{parsed?.retries} {port} {body} {chained}"

// The result must be consumed; a bare `try` statement is rejected.
export def consumedResult(untrusted: unknown) -> number:
    const config = try Config.parse(untrusted)
    if config == null: return 0
    return config.retries

// ---------------------------------------------------------------------------
// Assertions stay active in production
// ---------------------------------------------------------------------------

export def assertions(width: number, user: Config?) -> number:
    assert 0 < width <= 4096 else "Width is outside the supported range"
    // A successful assertion narrows checked optional and type facts.
    assert user != null else "A configuration is required"
    return user.retries + width

export def bareAssertion(flag: bool): assert flag

export const chapterEleven = {chapterName: "errors and assertions"}
