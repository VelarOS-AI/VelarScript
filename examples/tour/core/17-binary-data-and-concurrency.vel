/// Chapter 17 — the cross-target binary and structured-concurrency surface.
///
/// Host-affecting calls live behind exported functions that the tour does not
/// execute. Binary buffers and deterministic random values remain target-neutral;
/// codecs, compression, and domain algorithms belong to consuming projects.

import {ByteOrder, Bytes, Float32Buffer, Float32Builder, UInt8Buffer, UInt16Buffer, UInt32Buffer, UInt32Builder, float32Buffer, float32Builder, float32FromBytes, uint8Buffer, uint8FromBytes, uint16Buffer, uint16FromBytes, uint32Buffer, uint32Builder, uint32FromBytes} from "velar/binary"
import {Random, random} from "velar/random"
import {Cancellation, CancellationError, Channel, ChannelBackpressureError, ChannelClosedError, Task, TaskTimeoutError, channel, task, withTimeout} from "velar/task"
import {Worker, WorkerBackpressureError, WorkerCallError, WorkerClosedError, WorkerCrashedError, WorkerPool, serveWorker, worker, workerPool} from "velar/worker"
import {WebSocketBackpressureError, WebSocketClosedError, WebSocketConnection, WebSocketProtocolError, WebSocketServer, WebSocketTimeoutError, connect, listen} from "velar/websocket"
import {createBytes, readBytes, writeBytes} from "velar/fs"

type DataRequest:
    x: number
    y: number

type DataReply:
    checksum: number

const bufferType = UInt16Buffer
const bytesType = Bytes
const littleEndian = ByteOrder.little

export def binaryAndRandomSpellings() -> number:
    const values: UInt16Buffer = uint16Buffer(4096)
    values[0] = 0x7f
    const snapshot: Bytes = values.toBytes(littleEndian)
    const restored = uint16FromBytes(snapshot, ByteOrder.little)
    const source: Random = random("tour-data")
    const child = source.fork("partition:0:0")
    return restored[0] + snapshot.size + child.int(1)

export def numericBufferSpellings() -> number:
    const flags: UInt8Buffer = uint8Buffer(4)
    flags[0] = 0xff
    const flagCopy = uint8FromBytes(flags.toBytes())
    const samples = uint16Buffer(2).copy()
    const identifiers: UInt32Buffer = uint32Buffer(3)
    identifiers[0] = 0xffffffff
    const identifierCopy = uint32FromBytes(identifiers.slice(0, 1).toBytes(ByteOrder.little), ByteOrder.little)
    const measurements: Float32Buffer = float32Buffer(3)
    measurements[0] = 0.5
    const measurementCopy = float32FromBytes(measurements.copy().toBytes(ByteOrder.little), ByteOrder.little)
    const indexBuilder: UInt32Builder = uint32Builder(6)
    indexBuilder.push(0)
    indexBuilder.push(1)
    const builtIndices = indexBuilder.finish()
    const positionBuilder: Float32Builder = float32Builder(6)
    positionBuilder.push(1.25)
    const builtPositions = positionBuilder.finish()
    return flagCopy[0] + samples.size + identifierCopy[0] + Math.trunc(measurementCopy[0]) + builtIndices.size + builtPositions.size

async def cancellableWork(cancellation: Cancellation) -> number:
    await cancellation.checkpoint()
    return 17

def taskValue(owner: Task<number>) -> Task<number>: return owner

export async def taskSpellings(parent: Cancellation?) -> number:
    using owner = task(cancellableWork, parent)
    return await withTimeout(taskValue(owner), 2s)

def channelValue(value: Channel<DataRequest>) -> Channel<DataRequest>: return value

export async def channelSpellings(cancellation: Cancellation?) -> number:
    const requests = channel(DataRequest, capacity=8)
    if not requests.trySend({x: 1, y: 2}): return 0
    await requests.send({x: 3, y: 4}, cancellation)
    const first = await channelValue(requests).next(cancellation)
    requests.close()
    return first?.x ?? 0

async def generate(request: DataRequest, cancellation: Cancellation) -> DataReply:
    await cancellation.checkpoint()
    return {checksum: request.x ^ request.y}

def workerValue(value: Worker<DataRequest, DataReply>) -> Worker<DataRequest, DataReply>: return value

def poolValue(value: WorkerPool<DataRequest, DataReply>) -> WorkerPool<DataRequest, DataReply>: return value

export async def workerClientSpellings() -> number:
    using single = worker("tour-data", DataRequest, DataReply, 8)
    using pool = workerPool("tour-data", DataRequest, DataReply, 2, 16)
    const first = await workerValue(single).call({x: 1, y: 2})
    const second = await poolValue(pool).call({x: 3, y: 4})
    return first.checksum + second.checksum

export def workerServerSpelling(): serveWorker(DataRequest, DataReply, generate, 16)

def connectionValue(value: WebSocketConnection) -> WebSocketConnection: return value

def serverValue(value: WebSocketServer) -> WebSocketServer: return value

export async def websocketSpellings() -> number:
    using connection = await connect("ws://127.0.0.1:8080/socket", {timeout: 2s})
    using server = await listen({port: 0, path: "/socket"})
    await connectionValue(connection).send("tour")
    return serverValue(server).port

export async def persistenceSpellings(path: string, snapshot: Bytes) -> number:
    await createBytes(f"{path}.new", snapshot)
    await writeBytes(path, snapshot)
    const restored = await readBytes(path, 64 * 1024 * 1024)
    return restored.size

export def concurrencyFailure(error: Error) -> string:
    if error is CancellationError: return "cancelled"
    if error is TaskTimeoutError: return "task timeout"
    if error is ChannelBackpressureError: return "channel backpressure"
    if error is ChannelClosedError: return "channel closed"
    if error is WorkerBackpressureError: return "worker backpressure"
    if error is WorkerCallError: return "worker call"
    if error is WorkerClosedError: return "worker closed"
    if error is WorkerCrashedError: return "worker crashed"
    if error is WebSocketBackpressureError: return "socket backpressure"
    if error is WebSocketClosedError: return "socket closed"
    if error is WebSocketProtocolError: return "socket protocol"
    if error is WebSocketTimeoutError: return "socket timeout"
    return "other"

export const chapterSeventeen = {bytesType, bufferType, littleEndian}
