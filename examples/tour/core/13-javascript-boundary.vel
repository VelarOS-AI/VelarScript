/// Chapter 13 — the JavaScript boundary: `extern module`, `import js`,
/// `import js unsafe`, the two inline `js` blocks, and how an undeclared
/// value enters the typed world.
///
/// Charter section 12's tail and section 18. The specifier is `node:crypto`
/// so the four keywords `extern`, `module`, `js`, and `unsafe` need no
/// third-party dependency: a project compile skips the existence probe for
/// `node:` specifiers.

// ---------------------------------------------------------------------------
// `extern module` — a checked, manual adapter
// ---------------------------------------------------------------------------

// A manual adapter describes only runtime exports and never executes
// declarations. Extern functions and getters have no body to infer, so they
// always declare their result — `-> null` included.
extern module "node:crypto":
    export const webcrypto: unknown

    // A default-export-only package is declared with the export name
    // `default`; `default` is not a VelarScript keyword, so it names the
    // extern export directly.
    export const default: unknown

    export def randomUUID() -> string
    export def randomInt(maximum: number) -> number
    export def timingSafeEqual(left: unknown, right: unknown) -> bool
    export def checkPrimeSync(candidate: unknown) -> bool

    export class Hash:
        def update(data: string) -> Hash
        def digest(encoding: string) -> string
        def copy() -> Hash

    export def createHash(algorithm: string) -> Hash

// `import js` brings a declared name across the checked bridge. The emitted
// bridge verifies at module initialization that each imported name exists on
// the JavaScript module.
import js {createHash, randomUUID, webcrypto} from "node:crypto"
import js {timingSafeEqual as constantTimeEqual} from "node:crypto"
import js * as crypto from "node:crypto"

// The bare form is the canonical default import; `{default as ...}` is the
// equivalent explicit spelling. Both lower through the same presence-checked
// bridge, and the binding always carries another local name because
// JavaScript reserves the word.
import js nodeCrypto from "node:crypto"
import js {default as explicitDefault} from "node:crypto"

// `import js unsafe` admits a value as `unknown` — no declaration, no
// promise, and therefore no access: members, calls, indexing, and operators
// all refuse an unknown until it is validated into a concrete type.
import js unsafe {createHash as rawCreateHash} from "node:crypto"
import js unsafe {webcrypto as rawWebcrypto} from "node:crypto"
import js unsafe rawDefault from "node:crypto"

// ---------------------------------------------------------------------------
// Inline blocks — the JavaScript that has no module to come from
// ---------------------------------------------------------------------------

// Everything above names a package: `extern module` declares what one
// exports and `import js` brings a name across. A JavaScript global has no
// package, so there is nothing to declare and nothing to import — and
// `globalThis.crypto.getRandomValues` is a global. That is what an inline
// block is for. The JavaScript rides in a backtick string, so this file's
// parser never has to know JavaScript; the compiler emits the block as a
// sibling `.js` module whose source map points back at these lines.
const tokenBytes = 16

extern js(tokenBytes: number)`
    export function randomToken() {
        const buffer = new Uint8Array(tokenBytes)
        globalThis.crypto.getRandomValues(buffer)
        return Array.from(buffer, (byte) => byte.toString(16).padStart(2, "0")).join("")
    }
`:
    export def randomToken() -> string

// The block is the *more* checked way to reach raw JavaScript, not the looser
// one. Here the contract is the one line under the backticks, and
// `randomToken` is an ordinary checked function from this line on — no
// import, because there is no other module to name it from.

// The parenthesised list is the injection channel, and it binds rather than
// substitutes: `tokenBytes` becomes a real parameter of the emitted module and
// is checked against `number` on this side. Nothing is interpolated — the
// payload is raw bytes, so `${...}` and `{...}` inside a block are literal
// JavaScript text. Values cross through the contract; they are never spliced
// into source.
//
// Because captures are handed to a synchronous factory, a block that takes
// them cannot use top-level `await`. Await on this side and capture the result.

// A block with no contract is the other form, and it must say `unsafe` — the
// same word as `import js unsafe` and `unsafe:html`, never a second one.
// Everything it exports arrives as `unknown`: readable right here, honest
// about carrying no promise, and unusable until the edge validates it.
unsafe js`
    export const engineRecord = { arch: globalThis.process.arch, node: globalThis.process.versions.node }
`

// ---------------------------------------------------------------------------
// Using the checked side
// ---------------------------------------------------------------------------

export def digest(text: string) -> string:
    return createHash("sha256").update(text).digest("hex")

export def identifier() -> string:
    return randomUUID()

export def sameLength(left: unknown, right: unknown) -> bool:
    return constantTimeEqual(left, right)

export def throughNamespace(text: string) -> string:
    // A namespace import of an extern module reads the same declared contract.
    return crypto.createHash("sha512").update(text).digest("hex")

// A contracted block's export is checked like any other function: the result is
// `string` because the contract says so, not because the JavaScript looked like
// it returned one.
export def sessionToken() -> string:
    return digest(randomToken())

// A declared `const` export has no VelarScript initializer, and an `unknown`
// must be validated before use.
type CryptoSubtle:
    subtle: unknown

export def readDeclaredConstant() -> bool:
    return webcrypto is CryptoSubtle

export def readDefaultExport() -> bool:
    return nodeCrypto == null and explicitDefault == null

// ---------------------------------------------------------------------------
// How a boundary value enters the typed world
// ---------------------------------------------------------------------------

type Config:
    retries: number

// 1. An undeclared foreign value arrives as `unknown`, and nothing can be
//    read off it: `rawWebcrypto.subtle`, `rawWebcrypto["subtle"]`, and
//    `rawCreateHash("sha256")` are all compile errors, and each one teaches
//    the same way in. The only questions an unvalidated unknown answers are
//    the ones that need no promise, like a null comparison.
export def stillOpaque() -> bool:
    return rawCreateHash != null and rawWebcrypto != null and rawDefault != null

// 2. `Type.parse` is the entry ritual: declare a type naming the fields you
//    rely on, validate at the import site, and let only checked values
//    inward. The edge is the whole correctness boundary.
export def validatedAtTheEdge(candidate: unknown) -> number:
    const config = Config.parse(candidate)
    return config.retries

// 3. A block without a contract lands in exactly the same place:
//    `engineRecord` was never declared, so it is `unknown` here, and the
//    edge validates it like any other arrival.
type EngineReport:
    arch: string
    node: string

export def engineDescription() -> string:
    const report = EngineReport.parse(engineRecord)
    return f"{report.arch} on Node {report.node}"

// 4. Primitives and declared shapes also narrow with `is`; an undeclared
//    callable has no shape to narrow into, so calling across the boundary
//    always goes through a declaration — an `extern module` contract or a
//    contracted `extern js` block. `any` cannot be written as an annotation
//    ("'any' is not a VelarScript type"), and since this ruling no boundary
//    produces one either.
export def validatesUnknown(value: unknown) -> string:
    if value is Config:
        return str(value.retries)
    if value is string:
        return value
    return "unusable"

export const chapterThirteen = {chapterName: "the JavaScript boundary"}
