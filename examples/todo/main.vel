type Todo:
    id: number
    title: string
    done: bool

component TodoApp:
    state draft: string = ""
    state todos: List<Todo> = [
        {id: 1, title: "Learn VelarScript", done: true},
        {id: 2, title: "Build a Web app", done: false},
    ]
    let nextId = 3
    computed remaining = todos.filter(todo => not todo.done).length

    def addTodo():
        if draft != "":
            todos.append({id: nextId, title: draft, done: false})
            nextId += 1
            draft = ""

    def addTodoOnKey(event: KeyboardEvent):
        if event.key == "Enter":
            event.preventDefault()
            addTodo()

    def toggleTodo(id: number):
        todos = todos.map(todo => todo.id == id ? {...todo, done: not todo.done} : todo)

    def removeTodo(id: number):
        todos = todos.filter(todo => todo.id != id)

    style global:
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;
            background: #f4f7fb;
            color: #172033;
            font-family: Inter, ui-sans-serif, system-ui, sans-serif;
        }

    style:
        .todo-app {
            width: min(680px, calc(100% - 32px));
            margin: 64px auto;
            padding: 28px;
            border: 1px solid #dce4f0;
            border-radius: 20px;
            background: white;
            box-shadow: 0 18px 60px #1f3a5f18;
        }

        .composer {
            display: grid;
            grid-template-columns: 1fr auto;
            gap: 10px;
        }

        .composer input {
            min-width: 0;
            padding: 12px 14px;
            border: 1px solid #c9d5e5;
            border-radius: 10px;
            font: inherit;
        }

        button {
            border: 0;
            border-radius: 10px;
            padding: 10px 14px;
            background: #2357d9;
            color: white;
            font: inherit;
            cursor: pointer;
        }

        button:disabled {
            cursor: default;
            opacity: .45;
        }

        .todos {
            display: grid;
            gap: 10px;
            padding: 0;
            list-style: none;
        }

        .todo {
            display: grid;
            grid-template-columns: auto 1fr auto;
            align-items: center;
            gap: 12px;
            padding: 12px;
            border-radius: 12px;
            background: #f7f9fd;
        }

        .todo.done .title {
            color: #748198;
            text-decoration: line-through;
        }

        .remove {
            background: #e24b4b;
        }

    return <main class="todo-app">
            <h1>Velar Todo App</h1>
        <p>{remaining} task(s) remaining</p>
        <form class="composer">
            <input aria-label="New task" placeholder="What needs doing?" bind:value={draft} on:keydown={addTodoOnKey} />
            <button type="button" disabled={draft == ""} on:click={addTodo}>Add task</button>
        </form>
        <ul class="todos">
            {todos.map(todo => <li key={todo.id} class="todo" class:done={todo.done}>
                <button type="button" on:click={() => toggleTodo(todo.id)}>{todo.done ? "Undo" : "Done"}</button>
                <span class="title">{todo.title}</span>
                <button type="button" class="remove" on:click={() => removeTodo(todo.id)}>Remove</button>
            </li>)}
        </ul>
    </main>

mount(<TodoApp />, "#app")
