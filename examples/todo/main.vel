type Todo:
    id: number
    title: string
    done: bool

const ink = Look.rgb(23, 32, 51)
const inkSoft = Look.rgb(116, 129, 152)
const paper = Look.rgb(244, 247, 251)
const surface = Look.rgb(255, 255, 255)
const surfaceSoft = Look.rgb(247, 249, 253)
const rule = Look.rgb(220, 228, 240)
const fieldRule = Look.rgb(201, 213, 229)
const primary = Look.rgb(35, 87, 217)
const danger = Look.rgb(226, 75, 75)

const pageLook = look:
    minHeight = 100vh
    padding = Look.spacing(64px, 16px)
    color = ink
    background = paper
    fontFamily = "Inter, ui-sans-serif, system-ui, sans-serif"

const cardLook = look:
    width = 100%
    maxWidth = 680px
    marginInline = "auto"
    padding = 28px
    border = Look.border(1px, rule)
    borderRadius = 20px
    background = surface
    boxShadow = Look.shadow(0px, 18px, 60px, Look.rgba(31, 58, 95, 0.1))

const composerLook = look:
    display = "grid"
    gridTemplateColumns = Look.tracks(1fr, "auto")
    gap = 10px

const inputLook = look:
    minWidth = 0
    padding = Look.spacing(12px, 14px)
    border = Look.border(1px, fieldRule)
    borderRadius = 10px

def buttonLook(dangerous: bool = false) -> Look:
    return look:
        padding = Look.spacing(10px, 14px)
        border = Look.border(0px, Look.color("transparent"))
        borderRadius = 10px
        color = surface
        background = dangerous ? danger : primary
        cursor = "pointer"
        if @disabled:
            cursor = "default"
            opacity = 0.45

const todosLook = look:
    display = "grid"
    gap = 10px
    padding = 0
    listStyle = "none"
const todoLook = look:
    display = "grid"
    gridTemplateColumns = Look.tracks("auto", 1fr, "auto")
    alignItems = "center"
    gap = 12px
    padding = 12px
    borderRadius = 12px
    background = surfaceSoft

def titleLook(done: bool) -> Look:
    return look:
        if done:
            color = inkSoft
            textDecoration = "line-through"
component TodoApp:
    state draft: string = ""
    state todos: List<Todo> = [
        {id: 1, title: "Learn VelarScript", done: true},
        {id: 2, title: "Build a Web app", done: false},
    ]
    let nextId = 3
    const remaining = computed(() => todos.filter(todo => not todo.done).size)

    def addTodo() -> null:
        if draft != "":
            todos = [...todos, {id: nextId, title: draft, done: false}]
            nextId += 1
            draft = ""

    def addTodoOnKey(event: KeyboardEvent) -> null:
        if event.key == "Enter":
            event.preventDefault()
            addTodo()

    def toggleTodo(id: number) -> null:
        todos = todos.map(todo => todo.id == id ? {...todo, done: not todo.done} : todo)

    def removeTodo(id: number) -> null:
        todos = todos.filter(todo => todo.id != id)

    return <main look={pageLook}><section class="todo-app" look={cardLook}>
        <h1>VelarScript Todo App</h1>
        <p>{remaining()} task(s) remaining</p>
        <form class="composer" look={composerLook}>
            <input
                look={inputLook}
                aria-label="New task"
                placeholder="What needs doing?"
                bind:value={draft}
                on:keydown={addTodoOnKey}
            />
            <button look={buttonLook()} type="button" disabled={draft == ""} on:click={addTodo}>Add task</button>
        </form>
        <ul class="todos" look={todosLook}>
            {todos.map(todo => <li key={todo.id} class="todo" look={todoLook}>
                <button look={buttonLook()} type="button" on:click={() => toggleTodo(todo.id)}>
                    {todo.done ? "Undo" : "Done"}
                </button>
                <span class="title" look={titleLook(todo.done)}>{todo.title}</span>
                <button
                    look={buttonLook(dangerous = true)}
                    type="button"
                    class="remove"
                    on:click={() => removeTodo(todo.id)}
                >
                    Remove
                </button>
            </li>)}
        </ul>
    </section></main>

mount(<TodoApp />, "#app")
