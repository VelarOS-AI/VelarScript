import {groupBy, range} from "velar/collections"
import {title} from "velar/text"
import {pi} from "velar/math"
import {parse as parseJson} from "velar/json"
import {sleep} from "velar/async"
import {withQuery} from "velar/url"
import {iso, utc} from "velar/time"

type User:
    name: string
    role: string

const users: List<User> = [
    {name: "Ada", role: "admin"},
    {name: "Lin", role: "member"},
    {name: "Bea", role: "admin"},
]

const grouped = groupBy(users, user => user.role)
const scores = Map({Ada: 9, Lin: 7})
const parsed = parseJson("{\"name\":\"Nova\",\"role\":\"admin\"}", User)
const banner = "
    VelarScript
    standard library
"

await sleep(1)
print(title("velar standard library"))
print(grouped.get("admin")?.size ?? 0)
print(range(1, 5).sum())
for name, score in scores:
    print(f"{name}: {score}")
print(pi.toFixed(2))
print(parsed.name)
print(banner)
print(withQuery("/users", {role: "admin"}))
print(iso(utc(2026, 8, 1)))
