abstract class Entity:
    const id: string

    constructor(id: string): self.id = id

    abstract def describe() -> string

class Player extends Entity:
    let score: number

    constructor(id: string, score: number = 0):
        super(id)
        self.score = score

    override def describe() -> string: return f"{self.id}: {self.score}"

    static def guest() -> Player: return Player("guest", 1)

class FormError extends Error:
    const field: string

    constructor(field: string, message: string):
        super(message)
        self.field = field

const entity: Entity = Player.guest()
const error: Error = FormError("name", "Required")
print(entity.describe())
print(entity is Entity)
print(error.message)
