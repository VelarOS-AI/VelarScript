import {Bytes} from "velar/binary"
import {deflate, inflate} from "velar/compression"
import {publicConfig} from "velar/config"
import {http} from "velar/http"
import {encode, parse} from "velar/msgpack"
import {database} from "velar/storage"
import {connect} from "velar/websocket"
import {workerPool} from "velar/worker"
import {ChunkRequest, chunkChecksum} from "./world-core.vel"

type ReadinessConfig:
    socketUrl: string

type ChunkPacket:
    bytes: Bytes

const config = publicConfig(ReadinessConfig)

component App:
    state report = "pending"

    async def generate():
        using workers = workerPool("terrain", ChunkRequest, Bytes, 2, 8)
        const chunk = await workers.call({seed: "velar-minecraft", chunkX: -3, chunkZ: 5}, null, 5s)
        const wire = deflate(encode({bytes: chunk}))
        using socket = await connect(config.socketUrl, {maxPendingSendBytes: 1048576})
        await socket.send(wire)
        const echoed = await socket.next()
        if not (echoed is Bytes):
            throw Error("Browser WebSocket did not preserve binary data")
        const packet = parse(inflate(echoed), ChunkPacket)
        const workerAsset = await http.get("/terrain-worker.js").bytes()
        if workerAsset.size == 0:
            throw Error("Browser HTTP did not return Bytes")
        const chunks = database("minecraft-readiness")
        await chunks.setBytes("chunk", packet.bytes)
        const restored = await chunks.getBytes("chunk", null, 1048576)
        if restored == null:
            throw Error("IndexedDB did not restore the chunk")
        await chunks.batch([
            {key: "chunk-copy", bytes: restored},
            {key: "obsolete", bytes: null},
        ])
        report = f"{chunkChecksum(restored)}:{restored.size}"

    @mounted:
        await generate()

    return <main data-minecraft-readiness={report}>{report}</main>

mount(<App />, "#app")
