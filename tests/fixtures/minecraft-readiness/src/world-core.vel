import {ByteOrder, Bytes, uint16Buffer} from "velar/binary"
import {simplex3} from "velar/noise"
import {random} from "velar/random"
import {Cancellation} from "velar/task"

export type ChunkRequest:
    seed: string
    chunkX: number
    chunkZ: number

export async def generateChunk(request: ChunkRequest, cancellation: Cancellation) -> Bytes:
    const blocks = uint16Buffer(16 ** 3)
    const terrain = simplex3(request.seed)
    const variation = random(request.seed).fork(f"chunk:{request.chunkX}:{request.chunkZ}")
    for index in range(16 ** 3):
        if (index & 0x7f) == 0:
            await cancellation.checkpoint()
        const x = index & 0x0f
        const y = (index >> 4) & 0x0f
        const z = (index >> 8) & 0x0f
        const worldX = request.chunkX * 16 + x
        const worldZ = request.chunkZ * 16 + z
        const density = terrain(worldX / 48, y / 32, worldZ / 48)
        const blockId = density + variation.number() * 0.2 > -0.05 ? 0x021 : 0x003
        const light = y > 11 ? 0x0f : y
        blocks[index] = ((light & 0x0f) << 12) | (blockId & 0x0fff)
    return blocks.toBytes(ByteOrder.little)

export def chunkChecksum(bytes: Bytes) -> number:
    let value = 0x6d2b79f5
    for index in range(bytes.size):
        value = ((value << 5) ^ (value >>> 2) ^ bytes[index]) & 0xffffffff
    return value >>> 0
