import {Bytes} from "velar/binary"
import {deflate, inflate} from "velar/compression"
import {writeBytes} from "velar/fs"
import {http} from "velar/http"
import {encode, parse} from "velar/msgpack"
import {ServeRequest, ServeResponse} from "velar/serve"
import {open} from "velar/sqlite"
import {CancellationError, task} from "velar/task"
import {WebSocketBackpressureError, connect, listen} from "velar/websocket"
import {workerPool} from "velar/worker"
import {ChunkRequest, chunkChecksum} from "./world-core.vel"

type ChunkPacket:
    key: string
    bytes: Bytes

type ChunkRow:
    key: string
    bytes: Bytes

async def health(request: ServeRequest) -> ServeResponse:
    return {status: 200, text: f"ready:{request.path}"}

async def main():
    using workers = workerPool("terrain", ChunkRequest, Bytes, 2, 8)
    const request: ChunkRequest = {seed: "velar-minecraft", chunkX: -3, chunkZ: 5}

    using cancelled = task(async cancellation => await workers.call(request, cancellation, 5s))
    await cancelled.cancel("chunk left loading range")
    let cancellationObserved = false
    try:
        await cancelled.result()
    catch error:
        if error is CancellationError:
            cancellationObserved = true
    if not cancellationObserved:
        throw Error("Worker cancellation did not reach the caller")

    const chunk = await workers.call(request, null, 5s)
    await writeBytes("chunk.bin", chunk)
    const wire = deflate(encode({key: "-3,5", bytes: chunk}))

    using sockets = await listen({port: 0, path: "/chunks", http: health, maxPendingSendBytes: 8192})
    const ready = await http.get(f"http://127.0.0.1:{sockets.port}/health").text()
    const readyBytes = await http.post(f"http://127.0.0.1:{sockets.port}/health", {body: chunk}).bytes()
    if readyBytes.size != 13:
        throw Error("Node HTTP did not preserve a Bytes request and response")
    using client = await connect(f"ws://127.0.0.1:{sockets.port}/chunks")
    const accepted = await sockets.next()
    if accepted == null:
        throw Error("WebSocket connection was not accepted")
    using peer = accepted
    await client.send(wire)
    const received = await peer.next()
    if not (received is Bytes):
        throw Error("WebSocket did not preserve binary data")
    const packet = parse(inflate(received), ChunkPacket)

    const firstSlowSend = peer.send(chunk)
    let backpressureObserved = false
    try:
        await peer.send(chunk)
    catch error:
        if error is WebSocketBackpressureError:
            backpressureObserved = true
    await firstSlowSend
    if not backpressureObserved:
        throw Error("A slow WebSocket client did not apply send backpressure")
    await client.close()
    if await peer.next() != null or peer.state() != "closed":
        throw Error("A disconnected WebSocket did not release its pull connection")

    using database = await open("world.sqlite", {queueCapacity: 16, maxRows: 4, maxResultBytes: 1048576})
    await database.execute("CREATE TABLE IF NOT EXISTS chunks (key TEXT PRIMARY KEY, bytes BLOB NOT NULL)")
    using transaction = await database.transaction()
    await transaction.execute("INSERT OR REPLACE INTO chunks (key, bytes) VALUES (?, ?)", [packet.key, packet.bytes])
    await transaction.commit()
    const restored = await database.one("SELECT key, bytes FROM chunks WHERE key = ?", [packet.key], ChunkRow)
    if restored == null:
        throw Error("SQLite did not restore the chunk")
    print(f"{ready}:{chunkChecksum(restored.bytes)}:{restored.bytes.size}")

await main()
