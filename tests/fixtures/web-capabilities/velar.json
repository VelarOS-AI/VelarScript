{
  "formatVersion": 2,
  "entry": "src/main.vel",
  "workers": {
    "capability-probe": "src/capability-worker.vel"
  },
  "outDir": "dist",
  "publicDir": "public",
  "build": {
    "sourceMaps": true
  },
  "extensions": ["@velarscript/web"],
  "surfaces": {
    "core": "0.5",
    "web": "0.11"
  },
  "web": {
    "title": "VelarScript Web capabilities",
    "base": "/app/",
    "publicConfig": {
      "apiBase": "/api",
      "releaseChannel": "preview",
      "canonicalUrl": "https://velar.example/app/",
      "socialImage": "/app/share.svg",
      "features": {
        "recovery": true
      }
    },
    "security": {
      "contentSecurityPolicy": true,
      "connectSources": [],
      "imageSources": []
    },
    "deployment": {
      "spaFallback": true
    }
  }
}
