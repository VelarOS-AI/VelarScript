export type ProjectSummary:
    id: string
    name: string
    status: string
    progress: number
    children: List<ProjectSummary>

export const projects: List<ProjectSummary> = [
    {
        id: "compiler",
        name: "VelarScript Compiler",
        status: "Healthy",
        progress: 92,
        children: [
            {id: "parser", name: "Parser", status: "Healthy", progress: 96, children: []},
            {id: "emitter", name: "JavaScript Emitter", status: "Healthy", progress: 91, children: []},
        ],
    },
    {
        id: "web",
        name: "VelarScript Web",
        status: "Healthy",
        progress: 84,
        children: [
            {id: "web-runtime", name: "Web Runtime", status: "Healthy", progress: 88, children: []},
            {id: "web-tooling", name: "Web Tooling", status: "Integrating", progress: 80, children: []},
        ],
    },
    {
        id: "workbench",
        name: "Workbench Host",
        status: "Integrating",
        progress: 76,
        children: [
            {id: "velar-integration", name: "VelarScript Integration", status: "Healthy", progress: 82, children: []},
        ],
    },
]

def countProjects(items: List<ProjectSummary>) -> number:
    let total = 0
    for {children} in items: total += 1 + countProjects(children)
    return total

export def projectCount() -> number: return countProjects(projects)
