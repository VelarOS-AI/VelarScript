import {after, copyText, environment, every, frame, location, measure, media, watchMedia, watchOnline, watchVisibility} from "velar/browser"
import {download, pick, readText} from "velar/files"
import {database, session} from "velar/storage"
import {iso, now} from "velar/time"
import {currentRoute} from "velar/web"
import {onError} from "velar/app"
import {publicConfig} from "velar/config"
import {logger, useSink} from "velar/log"

import {formBody, http} from "velar/http"
import {eventStream} from "velar/realtime"
import {worker} from "velar/worker"
import {WebSocketConnection, connect} from "velar/websocket"
import {border, rgb, spacing} from "velar/look"
import {CapabilityWorkerReply, CapabilityWorkerRequest} from "../capability-worker-contract.vel"

type CapabilityStatus:
    label: string

class CapabilityError extends Error:
    constructor(message: string): super(message)

type RuntimeFeatures:
    recovery: bool

type RuntimeConfig:
    apiBase: string
    releaseChannel: string
    features: RuntimeFeatures

type UploadResponse:
    fileName: string
    label: string
    size: number

let resourceAttempts = 0
let actionAttempts = 0

async def loadResourceLabel() -> string:
    resourceAttempts += 1
    if resourceAttempts == 1: throw CapabilityError("Resource recovery ready")
    return "resource-ready"

async def loadWorkerLabel() -> string:
    using probe = worker("capability-probe", CapabilityWorkerRequest, CapabilityWorkerReply, 4)
    const reply = await probe.call({value: 17})
    return reply.label

const capabilitiesLook = look:
    display = "grid"
    gap = 12px
    padding = 16px
    border = border(1px, rgb(66, 82, 143))
    borderRadius = 12px
    background = rgb(17, 24, 46)

const capabilityRowLook = look:
    display = "flex"
    flexWrap = "wrap"
    gap = spacing(8px, 16px)

const summaryItemLook = look:
    color = rgb(189, 199, 255)

const actionButtonLook = look:
    padding = spacing(8px, 11px)
    border = border(1px, rgb(82, 99, 165))
    borderRadius = 8px
    color = "inherit"
    background = rgb(21, 28, 54)
    cursor = "pointer"
const eventInputLook = look:
    padding = spacing(8px, 11px)
    border = border(1px, rgb(82, 99, 165))
    borderRadius = 8px
    color = "inherit"
    background = rgb(21, 28, 54)

// D90 R20: the WebSocket half of this probe reads `velar/websocket`, the one
// WebSocket client. It is pull-based, so the connection is drained by a loop
// in `@mounted` instead of by a `message` handler; the event stream keeps its
// handlers, because `velar/realtime` is unchanged.
component RealtimeProbe(socketUrl: string, eventsUrl: string):
    state socketLabel = "connecting"
    state eventLabel = "connecting"
    state connection: WebSocketConnection? = null

    def eventOpened(): eventLabel = "open"

    def eventMessage(value: string, id: string): eventLabel = f"{id}:{value}"

    def eventFailed(message: string): eventLabel = f"error:{message}"

    const events = eventStream(eventsUrl, {
        open: eventOpened,
        message: eventMessage,
        error: eventFailed,
    })

    @mounted:
        try:
            const live = await connect(socketUrl)
            connection = live
            socketLabel = "open"
            while true:
                const message = await live.next()
                if message == null: break
                if message is string: socketLabel = message
        catch failure: socketLabel = f"error:{failure.message}"

    @cleanup:
        const live = connection
        if live != null: async live.close()
        events.close()

    return <span data-realtime>{socketLabel}/{eventLabel}</span>

export component WebCapabilities:
    const initialEnvironment = environment()
    const initialLocation = location()
    const initialRoute = currentRoute()
    const cache = database("release-studio")
    const config = publicConfig(RuntimeConfig)
    assert Text.matches(config.releaseChannel, "^[a-z][a-z0-9-]*$") else "Release channel must use a lowercase Web-safe name"
    const runtimeLog = logger("release-studio")
    const capabilityNames = Set(["http", "storage", "files"])
    capabilityNames.add("realtime")
    resource recoveryResource = loadResourceLabel()
    computed resourceFailure = recoveryResource.error
    state online = initialEnvironment.online
    state visible = initialEnvironment.visible
    state darkScheme = media("(prefers-color-scheme: dark)")
    state sessionLabel = "pending"
    state databaseLabel = "pending"
    state fileName = "No file selected"
    state fileText = ""
    state uploadLabel = "No upload"
    state clipboardLabel = "Copy status"
    state layoutWidth = 0
    state frameReady = false
    state errorLabel = "pending"
    state recoveryLabel = "pending"
    state actionLabel = "pending"
    state runtimeErrorLabel = "none"
    state logLabel = "none"
    state keyboardLabel = "none"
    state inputLabel = "none"
    state pointerLabel = "none"
    state timerLabel = "timer-pending"
    state timerTicks = 0
    state renderFails = false
    state socketUrl = ""
    state eventsUrl = ""
    state realtimeEnabled = false
    state workerLabel = "worker-pending"
    let panel: Element? = null

    def onlineChanged(value: bool): online = value

    def visibilityChanged(value: bool): visible = value

    def mediaChanged(value: bool): darkScheme = value

    def sessionChanged(value: CapabilityStatus?, previous: CapabilityStatus?): sessionLabel = value?.label ?? "missing"

    def captureRuntimeError(phase: string, message: string): runtimeErrorLabel = f"{phase}:{message}"

    def captureLog(message: string): logLabel = message

    def captureKey(event: KeyboardEvent): keyboardLabel = event.key

    def captureInput(event: InputEvent):
        event.preventDefault()
        inputLabel = event.inputType

    def capturePointer(event: PointerEvent): pointerLabel = event.pointerType

    def timerReady(): timerLabel = "after-ready"

    def timerTick(): timerTicks += 1

    def renderStatus() -> string:
        if renderFails: throw CapabilityError("Render recovery ready")
        else: return "render-stable"

    def failRender(): renderFails = true

    async def failEvent(): throw CapabilityError("Event recovery ready")

    action recoverAction():
        actionAttempts += 1
        if actionAttempts == 1: throw CapabilityError("Action recovery ready")
        actionLabel = "action-ready"

    computed actionFailure = recoverAction.error

    def resourceStatus() -> string:
        const current = resourceFailure
        return current != null ? current.message : recoveryResource.value ?? (recoveryResource.loading ? "resource-loading" : "resource-empty")

    def actionStatus() -> string:
        const current = actionFailure
        return current != null ? current.message : recoverAction.pending ? "action-pending" : actionLabel

    const stopOnline = watchOnline(onlineChanged)
    const stopVisibility = watchVisibility(visibilityChanged)
    const stopMedia = watchMedia("(prefers-color-scheme: dark)", mediaChanged)
    const stopReadyTimer = after(25ms, timerReady)
    const stopHeartbeat = every(25ms, timerTick)
    const stopSession = session.watch("capability", CapabilityStatus, sessionChanged)
    const stopErrors = onError(report => captureRuntimeError(report.phase, report.error.message))
    const stopLog = useSink(record => captureLog(record.message))

    async def loadCapabilities():
        session.set("capability", {label: "session-ready"})
        await cache.set("capability", {label: "database-ready"})
        const stored = await cache.get("capability", CapabilityStatus)
        databaseLabel = stored?.label ?? "missing"
        await frame()
        frameReady = true
        if panel != null: layoutWidth = measure(panel).width

    async def verifyRecovery():
        try: throw CapabilityError("VelarScript recovery ready")
        catch error: errorLabel = error.message
        finally: recoveryLabel = "finalized"

    action chooseFile():
        const selected = await pick({accept: ".txt", multiple: false})
        const file = selected.get(0)
        if file != null:
            fileName = file.name
            fileText = await readText(file)
            const body = formBody()
            body.field("label", "release-studio")
            body.file("asset", file)
            const uploaded = await http.post(f"{config.apiBase}/upload", {body: body}).parse(UploadResponse)
            uploadLabel = f"{uploaded.label}:{uploaded.fileName}:{uploaded.size}"

    action copyStatus():
        await copyText("VelarScript Web API 0.11")
        clipboardLabel = "Copied"

    def saveStatus(): download("velar-status.txt", f"{sessionLabel}/{databaseLabel}")

    def connectRealtime(): realtimeEnabled = true

    @mounted:
        await loadCapabilities()
        await verifyRecovery()
        workerLabel = await loadWorkerLabel()
        runtimeLog.info("Runtime configured")

    @cleanup:
        stopOnline()
        stopVisibility()
        stopMedia()
        stopSession()
        throw CapabilityError("Cleanup recovery ready")
        stopReadyTimer()
        stopHeartbeat()
        session.set("cleanup", {label: "continued"})
        stopLog()
        stopErrors()

    return <section class="capabilities" look={capabilitiesLook} ref={panel} aria-label="Web platform capabilities">
        <strong>Typed browser platform</strong>
        <div class="summary" look={capabilityRowLook}>
            <span look={summaryItemLook} data-browser>{initialLocation.path}</span>
            <span look={summaryItemLook} data-route>{initialRoute.path}</span>
            <span look={summaryItemLook} data-environment>
                {online ? "online" : "offline"}
                /
                {visible ? "visible" : "hidden"}
                /
                {darkScheme ? "dark" : "light"}
            </span>
            <span look={summaryItemLook} data-session>{sessionLabel}</span>
            <span look={summaryItemLook} data-database>{databaseLabel}</span>
            <span look={summaryItemLook} data-time>{iso(now())}</span>
            <span look={summaryItemLook} data-frame>{frameReady ? "frame-ready" : "frame-pending"}</span>
            <span look={summaryItemLook} data-layout>{layoutWidth > 0 ? "measured" : "pending"}</span>
            <span look={summaryItemLook} data-error>{errorLabel}</span>
            <span look={summaryItemLook} data-recovery>{recoveryLabel}</span>
            <span look={summaryItemLook} data-remainder>{11 % 4}</span>
            <span look={summaryItemLook} data-set>
                {capabilityNames.size}
                :
                {capabilityNames.has("files") ? "set-ready" : "set-missing"}
            </span>
            <span look={summaryItemLook} data-config>
                {config.apiBase}
                :
                {config.releaseChannel}
                :
                {config.features.recovery ? "recovery" : "disabled"}
            </span>
            <span look={summaryItemLook} data-runtime-error>{runtimeErrorLabel}</span>
            <span look={summaryItemLook} data-resource>{resourceStatus()}</span>
            <span look={summaryItemLook} data-action>{actionStatus()}</span>
            <span look={summaryItemLook} data-log>{logLabel}</span>
            <span look={summaryItemLook} data-worker>{workerLabel}</span>
            <span look={summaryItemLook} data-keyboard-event>{keyboardLabel}</span>
            <span look={summaryItemLook} data-input-event>{inputLabel}</span>
            <span look={summaryItemLook} data-pointer-event>{pointerLabel}</span>
            <span look={summaryItemLook} data-timer>
                {timerLabel}
                :
                {timerTicks > 0 ? "every-ready" : "every-pending"}
            </span>
            <span look={summaryItemLook} data-render-stable>{renderStatus()}</span>
        </div>
        <div class="actions" look={capabilityRowLook}>
            <input
                look={eventInputLook}
                data-event-input
                aria-label="Native event probe"
                on:keydown={captureKey}
                on:beforeinput={captureInput}
            />
            <button look={actionButtonLook} data-pointer-probe type="button" on:pointerdown={capturePointer}>
                Check pointer event
            </button>
            <button look={actionButtonLook} type="button" disabled={chooseFile.pending} on:click={chooseFile}>
                Choose text file
            </button>
            <button look={actionButtonLook} type="button" on:click={saveStatus}>Download status</button>
            <button look={actionButtonLook} type="button" disabled={copyStatus.pending} on:click={copyStatus}>
                Copy status
            </button>
            <button look={actionButtonLook} type="button" data-test-event on:click={failEvent}>
                Fail event safely
            </button>
            <button look={actionButtonLook} type="button" data-test-render on:click={failRender}>
                Fail render safely
            </button>
            <button look={actionButtonLook} type="button" data-resource-retry on:click={recoveryResource.reload}>
                Retry resource
            </button>
            <button
                look={actionButtonLook}
                type="button"
                data-action-retry
                disabled={recoverAction.pending}
                on:click={recoverAction}
            >
                Run action
            </button>
            <input
                look={eventInputLook}
                data-realtime-socket-url
                aria-label="WebSocket test URL"
                bind:value={socketUrl}
            />
            <input
                look={eventInputLook}
                data-realtime-events-url
                aria-label="Event stream test URL"
                bind:value={eventsUrl}
            />
            <button look={actionButtonLook} data-realtime-connect type="button" on:click={connectRealtime}>
                Connect realtime
            </button>
        </div>
        {realtimeEnabled ? <RealtimeProbe socketUrl={socketUrl} eventsUrl={eventsUrl} /> : <span data-realtime>idle</span>}
        <span data-file>{fileName}</span>
        <span data-file-text>{fileText}</span>
        <span data-upload>{uploadLabel}</span>
        <span data-clipboard>{clipboardLabel}</span>
    </section>
