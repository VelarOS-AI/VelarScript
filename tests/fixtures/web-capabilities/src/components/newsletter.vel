import {clearError, focusFirstError, setError} from "velar/forms"
import {frame} from "velar/browser"

import {announce} from "velar/web"
import {border, rgb, spacing, tracks} from "velar/look"

const formLook = look:
    display = "grid"
    gridTemplateColumns = tracks(1fr, "auto")
    gap = 8px

const labelLook = look:
    gridColumn = "1 / -1"
    color = rgb(170, 181, 222)

const inputLook = look:
    minWidth = 0
    padding = spacing(10px, 12px)
    border = border(1px, rgb(66, 82, 143))
    borderRadius = 9px

const buttonLook = look:
    ...inputLook
    color = rgb(8, 16, 34)
    background = rgb(157, 172, 255)
    cursor = "pointer"
export component Newsletter:
    state email = ""
    let form: Element? = null

    action submit():
        if form != null:
            const currentForm = form
            const domain = Text.findMatch(email, "@([a-z0-9-]+(?:[.][a-z0-9-]+)+)$", {ignoreCase: true})?.groups?.[0]
            if email == "":
                setError(currentForm, "email", "Email is required")
                focusFirstError(currentForm)
                announce("Email is required", "assertive")
            else if domain == null:
                setError(currentForm, "email", "Enter a complete email address")
                focusFirstError(currentForm)
                announce("Email is incomplete", "assertive")
            else:
                await frame()
                clearError(currentForm, "email")
                announce("Subscription ready")

    computed submitFailure = submit.error

    def failureView() -> WebNode:
        const current = submitFailure
        return current != null ? <p role="alert">{current.message}</p> : <></>

    return <form look={formLook} ref={form} on:submit.prevent={submit} aria-busy={submit.pending}>
        <label look={labelLook} for="newsletter-email">Release newsletter</label>
        <input look={inputLook} id="newsletter-email" name="email" type="email" bind:value={email} />
        <button look={buttonLook} type="submit" disabled={submit.pending}>Subscribe</button>
        {failureView()}
    </form>
