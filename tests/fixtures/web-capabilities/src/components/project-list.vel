import {ProjectSummary} from "../data.vel"
import {rgb, spacing, tracks} from "velar/look"

def isHealthy(status: string) -> bool:
    match status:
        case "Healthy": return true
        case _: return false

const projectsLook = look:
    display = "grid"
    gap = 10px
    padding = 0
    listStyle = "none"
def projectLook(nested: bool) -> Look:
    return look:
        overflow = "hidden"
        borderRadius = 12px
        background = nested ? rgb(24, 33, 61) : rgb(17, 24, 46)

const summaryLook = look:
    display = "grid"
    gridTemplateColumns = tracks(1fr, "auto")
    gap = spacing(8px, 18px)
    padding = spacing(14px, 16px)

const childrenLook = look:
    display = "grid"
    gap = 8px
    margin = 0
    padding = spacing(0px, 10px, 10px, 26px)
    listStyle = "none"
const progressLook = look:
    gridColumn = "1 / -1"
    height = 5px
    overflow = "hidden"
    borderRadius = 9999px
    background = rgb(39, 50, 84)

def progressFillLook(progress: number) -> Look:
    return look:
        width = progress * 1%
        height = 100%
        background = rgb(130, 151, 255)

def statusLook(healthy: bool) -> Look:
    return look:
        color = healthy ? rgb(125, 230, 178) : rgb(170, 181, 222)

export component ProjectList(items: List<ProjectSummary>):
    component ProjectBranch(project: ProjectSummary, nested: bool = false):
        return <li class="project" look={projectLook(nested)} data-project={project.id}>
            <div class="project-summary" look={summaryLook}>
                <strong>{project.name}</strong>
                <span class="status" look={statusLook(isHealthy(project.status))}>{project.status}</span>
                <div class="progress" look={progressLook} role="progressbar" aria-label={project.name} aria-valuemin="0" aria-valuemax="100" aria-valuenow={project.progress}>
                    <div class="progress-fill" look={progressFillLook(project.progress)}></div>
                </div>
            </div>
            {project.children.size > 0 ? <ul class="project-children" look={childrenLook}>
                {project.children.map(child => <ProjectBranch key={child.id} project={child} nested={true} />)}
            </ul> : null}
        </li>

    return <ul class="projects" look={projectsLook} data-project-tree>
        {items.map(project => <ProjectBranch key={project.id} project={project} />)}
    </ul>
