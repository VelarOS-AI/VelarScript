import {Head} from "velar/web"
import {spacing} from "velar/look"

const pageLook = look:
    display = "grid"
    gap = 16px
    width = 100%
    maxWidth = 752px
    marginInline = "auto"
    padding = spacing(64px, 16px)

export component About:
    return <main class="page" look={pageLook}>
        <Head title="About · VelarScript Web capabilities" description="About the VelarScript production application" />
        <h1>About</h1>
        <p>A routed VelarScript application built from independent compiler, Web, package, and Workbench boundaries.</p>
    </main>
