{
  "formatVersion": 2,
  "entry": "src/web-main.vel",
  "workers": {
    "processor": "src/data-worker.vel"
  },
  "extensions": ["@velarscript/web"],
  "web": {
    "title": "Binary data pipeline acceptance",
    "base": "/",
    "publicConfig": {"socketUrl": "ws://127.0.0.1:1"},
    "build": {"sourceMaps": true},
    "security": {"contentSecurityPolicy": true, "connectSources": [], "imageSources": []},
    "deployment": {"spaFallback": true}
  }
}
