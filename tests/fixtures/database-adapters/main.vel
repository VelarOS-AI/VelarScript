import {column, createModelStep, databaseSchema, filter, index, migration, model, order, select} from "@velarscript/database"
import {gunzip, gzip} from "@velarscript/compression"
import {encode, parse} from "@velarscript/msgpack"
import {simplex3} from "@velarscript/noise"
import {SqliteBackpressureError, SqliteConcurrencyError, SqliteError, open} from "@velarscript/sqlite"
import {Bytes} from "velar/binary"

type Profile:
    score: number

type User:
    id: string
    email: string
    enabled: bool
    profile: Profile

type Packet:
    label: string
    count: number

type CountRow:
    count: number

type LargeRow:
    payload: Bytes

const users = model("users", User, {
    id: column.text(primary=true),
    email: column.text(unique=true),
    enabled: column.boolean(defaultValue=true),
    profile: column.json(),
}, [index("users_email", ["email"], unique=true)])

const schema = databaseSchema("adapter_test", 1, [users.definition], [
    migration(1, [createModelStep(users)]),
])

async def main():
    const packed = encode({label: "adapter", count: 3})
    const packet = parse(gunzip(gzip(packed), 1024 * 1024), Packet)
    const firstNoise = simplex3("database-adapter")(1, 2, 3)
    const secondNoise = simplex3("database-adapter")(1, 2, 3)
    if firstNoise != secondNoise:
        throw Error("Noise adapter changed deterministic output")

    using database = await open(":memory:", {
        queueCapacity: 1,
        maxRows: 2,
        maxResultBytes: 1048576,
        streamBatchRows: 1,
        maxRowBytes: 65536,
        statementCacheCapacity: 2,
    })
    const migrated = await database.migrate(schema)
    await database.insert(users, {id: "u-1", email: "one@example.test", enabled: true, profile: {score: 1}})
    await database.insert(users, {id: "u-2", email: "two@example.test", enabled: false, profile: {score: 2}})
    await database.insert(users, {id: "u-3", email: "three@example.test", enabled: true, profile: {score: 3}})

    const selected = await database.findOne(select(users, where=filter.equal(users, "id", "u-2"), limit=1))
    if selected == null or selected.profile.score != 2:
        throw Error("SQLite adapter did not decode the selected model")
    await database.update(users, {email: "updated@example.test"}, filter.equal(users, "id", "u-2"))

    let streamed: List<string> = []
    async def consume(user: User):
        streamed.append(user.id)
    await database.stream(select(users, orderBy=[order(users, "id")]), consume)
    if streamed.join(",") != "u-1,u-2,u-3":
        throw Error("SQLite streaming lost order or rows")

    let resultLimitObserved = false
    try:
        await database.find(select(users))
    catch error:
        if error is SqliteError:
            resultLimitObserved = true
    if not resultLimitObserved:
        throw Error("SQLite all-result limit was not enforced")

    using rolledBack = await database.transaction()
    await rolledBack.insert(users, {id: "u-4", email: "four@example.test", enabled: true, profile: {score: 4}})
    await rolledBack.rollback()
    if await database.findOne(select(users, where=filter.equal(users, "id", "u-4"), limit=1)) != null:
        throw Error("SQLite rollback did not restore the transaction")

    using raw = await database.begin()
    await raw.execute("INSERT INTO users (id, email, enabled, profile) VALUES (?, ?, ?, ?)", ["u-5", "five@example.test", 1, `{"score":5}`])
    await raw.commit()

    using statement = await database.prepare("SELECT COUNT(*) AS count FROM users")
    const count = await statement.one([], CountRow)
    if count == null or count.count != 4:
        throw Error("SQLite prepared statement returned the wrong row")
    const firstStatementClose = statement.close()
    const secondStatementClose = statement.close()
    await firstStatementClose
    await secondStatementClose

    let rowLimitObserved = false
    try:
        await database.one("SELECT zeroblob(70000) AS payload", [], LargeRow)
    catch error:
        if error is SqliteError:
            rowLimitObserved = true
    if not rowLimitObserved:
        throw Error("SQLite maxRowBytes was not enforced before publishing a row")

    const pending = database.execute("SELECT 1")
    let backpressureObserved = false
    try:
        await database.execute("SELECT 2")
    catch error:
        if error is SqliteBackpressureError:
            backpressureObserved = true
    await pending
    if not backpressureObserved:
        throw Error("SQLite queue did not report backpressure")

    using exclusive = await database.begin()
    const first = exclusive.execute("SELECT 1")
    let concurrencyObserved = false
    try:
        await exclusive.execute("SELECT 2")
    catch error:
        if error is SqliteConcurrencyError:
            concurrencyObserved = true
    await first
    await exclusive.rollback()
    if not concurrencyObserved:
        throw Error("SQLite transaction allowed concurrent use")

    const firstClose = database.close()
    const secondClose = database.close()
    await secondClose
    await firstClose
    print(f"{packet.label}:{packet.count}:{migrated.applied}:{streamed.size}:{count.count}")

await main()
