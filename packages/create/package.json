{
  "name": "create-velar",
  "version": "0.28.1",
  "description": "Create reproducible VelarScript Web, Server, and Desktop applications plus documentation sites and source packages.",
  "license": "Apache-2.0",
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "clean": "node ../../scripts/clean-package-dist.mjs",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "postbuild": "node ../../scripts/mark-package-bin.mjs dist/cli.js",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VelarOS-AI/VelarScript.git",
    "directory": "packages/create"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "create-velar": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  }
}
