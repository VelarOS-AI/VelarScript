/// A stable zero-based line and Unicode code-point column.
export type TextPosition:
    line: number
    column: number

/// One selection expressed with Unicode code-point offsets.
export type TextSelection:
    anchor: number
    head: number

/// One replacement range. Transaction ranges belong to the same pre-revision.
export type TextEdit:
    start: number
    end: number
    inserted: string

/// One committed replacement with the removed text required for inversion.
export type TextChange:
    start: number
    removed: string
    inserted: string
    beforeRevision: number
    afterRevision: number

/// One atomic ordered set of replacements.
export type TextTransaction:
    changes: List<TextChange>
    beforeRevision: number
    afterRevision: number

/// A line-aligned viewport slice with absolute document offsets.
export type TextLineSlice:
    startLine: number
    endLine: number
    start: number
    end: number
    text: string

type RopeSplit:
    left: RopeNode?
    right: RopeNode?

type PrefixMetrics:
    newlines: number
    tail: number

type HistoryStep:
    forward: List<TextEdit>
    inverse: List<TextEdit>
    bytes: number

type HistoryEntry:
    steps: List<HistoryStep>
    beforeSelection: TextSelection?
    afterSelection: TextSelection?
    bytes: number

class RopeNode:
    const text: string?
    const left: RopeNode?
    const right: RopeNode?
    const length: number
    const bytes: number
    const newlines: number
    const height: number
    const leaves: number
    const tail: number
    const starts: List<number>

    constructor(text: string?, left: RopeNode?, right: RopeNode?, length: number, bytes: number, newlines: number, height: number, leaves: number, tail: number, starts: List<number>):
        self.text = text
        self.left = left
        self.right = right
        self.length = length
        self.bytes = bytes
        self.newlines = newlines
        self.height = height
        self.leaves = leaves
        self.tail = tail
        self.starts = starts

def leafNode(text: string) -> RopeNode?:
    if text == "":
        return null
    const starts = Text.lineStarts(text)
    const newlines = starts.size - 1
    const tail = text.size - starts[-1]
    return RopeNode(text, null, null, text.size, Text.utf8Size(text), newlines, 1, 1, tail, starts)

def requiredLeft(node: RopeNode) -> RopeNode:
    const value = node.left
    assert value != null else "Invalid TextBuffer rope left branch"
    return value

def requiredRight(node: RopeNode) -> RopeNode:
    const value = node.right
    assert value != null else "Invalid TextBuffer rope right branch"
    return value

def branchNode(left: RopeNode, right: RopeNode) -> RopeNode:
    const height = left.height > right.height ? left.height + 1 : right.height + 1
    const tail = right.newlines > 0 ? right.tail : left.tail + right.length
    return RopeNode(null, left, right, left.length + right.length, left.bytes + right.bytes, left.newlines + right.newlines, height, left.leaves + right.leaves, tail, [])

def rotateLeft(node: RopeNode) -> RopeNode:
    const left = requiredLeft(node)
    const right = requiredRight(node)
    const rightLeft = requiredLeft(right)
    const rightRight = requiredRight(right)
    return branchNode(branchNode(left, rightLeft), rightRight)

def rotateRight(node: RopeNode) -> RopeNode:
    const left = requiredLeft(node)
    const right = requiredRight(node)
    const leftLeft = requiredLeft(left)
    const leftRight = requiredRight(left)
    return branchNode(leftLeft, branchNode(leftRight, right))

def balanceNode(node: RopeNode) -> RopeNode:
    const left = requiredLeft(node)
    const right = requiredRight(node)
    if left.height > right.height + 1:
        let next = node
        if requiredLeft(left).height < requiredRight(left).height:
            next = branchNode(rotateLeft(left), right)
        return rotateRight(next)
    if right.height > left.height + 1:
        let next = node
        if requiredRight(right).height < requiredLeft(right).height:
            next = branchNode(left, rotateRight(right))
        return rotateLeft(next)
    return node

def joinNonEmpty(left: RopeNode, right: RopeNode) -> RopeNode:
    const leftText = left.text
    const rightText = right.text
    if leftText != null and rightText != null and left.length + right.length <= 4096:
        return leafNode(leftText + rightText) ?? left
    if left.height > right.height + 1:
        const leftLeft = requiredLeft(left)
        const leftRight = requiredRight(left)
        return balanceNode(branchNode(leftLeft, joinNonEmpty(leftRight, right)))
    if right.height > left.height + 1:
        const rightLeft = requiredLeft(right)
        const rightRight = requiredRight(right)
        return balanceNode(branchNode(joinNonEmpty(left, rightLeft), rightRight))
    return branchNode(left, right)

def joinNodes(left: RopeNode?, right: RopeNode?) -> RopeNode?:
    if left == null:
        return right
    if right == null:
        return left
    return joinNonEmpty(left, right)

def buildNodes(parts: List<string>, start: number, end: number) -> RopeNode?:
    if start >= end:
        return null
    if start + 1 == end:
        return leafNode(parts[start])
    const middle = ((start + end) / 2).floor()
    return joinNodes(buildNodes(parts, start, middle), buildNodes(parts, middle, end))

def ropeFromText(text: string) -> RopeNode?:
    const parts = Text.chunks(text, 4096)
    return buildNodes(parts, 0, parts.size)

def splitNode(node: RopeNode?, offset: number) -> RopeSplit:
    if node == null:
        return {left: null, right: null}
    if offset <= 0:
        return {left: null, right: node}
    if offset >= node.length:
        return {left: node, right: null}
    const text = node.text
    if text != null:
        return {left: leafNode(text.slice(0, offset)), right: leafNode(text.slice(offset))}
    const left = requiredLeft(node)
    const right = requiredRight(node)
    if offset < left.length:
        const split = splitNode(left, offset)
        return {left: split.left, right: joinNodes(split.right, right)}
    if offset == left.length:
        return {left, right}
    const split = splitNode(right, offset - left.length)
    return {left: joinNodes(left, split.left), right: split.right}

def replaceNode(root: RopeNode?, start: number, end: number, inserted: string) -> RopeNode?:
    const prefix = splitNode(root, start)
    const suffix = splitNode(prefix.right, end - start)
    return joinNodes(joinNodes(prefix.left, ropeFromText(inserted)), suffix.right)

def appendNodeSlice(node: RopeNode?, start: number, end: number, output: List<string>):
    if node == null or start >= end:
        return null
    const text = node.text
    if text != null:
        output.append(text.slice(start, end))
        return null
    const left = requiredLeft(node)
    const right = requiredRight(node)
    if start < left.length:
        appendNodeSlice(left, start, end < left.length ? end : left.length, output)
    if end > left.length:
        appendNodeSlice(right, start > left.length ? start - left.length : 0, end - left.length, output)

def prefixMetrics(node: RopeNode, offset: number) -> PrefixMetrics:
    if offset <= 0:
        return {newlines: 0, tail: 0}
    if offset >= node.length:
        return {newlines: node.newlines, tail: node.tail}
    const text = node.text
    if text != null:
        const starts = Text.lineStarts(text.slice(0, offset))
        return {newlines: starts.size - 1, tail: offset - starts[-1]}
    const left = requiredLeft(node)
    const right = requiredRight(node)
    if offset <= left.length:
        return prefixMetrics(left, offset)
    const suffix = prefixMetrics(right, offset - left.length)
    return {
        newlines: left.newlines + suffix.newlines,
        tail: suffix.newlines > 0 ? suffix.tail : left.tail + suffix.tail,
    }

def lineStartIn(node: RopeNode, line: number) -> number:
    if line == 0:
        return 0
    const text = node.text
    if text != null:
        return node.starts[line]
    const left = requiredLeft(node)
    const right = requiredRight(node)
    if line <= left.newlines:
        return lineStartIn(left, line)
    return left.length + lineStartIn(right, line - left.newlines)

def copySelection(selection: TextSelection?) -> TextSelection?:
    if selection == null:
        return null
    return {anchor: selection.anchor, head: selection.head}

def copyEdits(changes: List<TextChange>) -> HistoryStep:
    let forward: List<TextEdit> = []
    let inverse: List<TextEdit> = []
    let delta = 0
    let bytes = 0
    for change in changes:
        forward.append({start: change.start, end: change.start + change.removed.size, inserted: change.inserted})
        const postStart = change.start + delta
        inverse.append({start: postStart, end: postStart + change.inserted.size, inserted: change.removed})
        delta += change.inserted.size - change.removed.size
        bytes += Text.utf8Size(change.inserted) + Text.utf8Size(change.removed)
    return {forward, inverse, bytes}

/// A balanced immutable-node text rope with Unicode code-point offsets.
export class TextBuffer:
    private static const maxBytes: number = 16 * 1024 * 1024
    private static const maxLeaves: number = 1000000
    private static const maxTransactionEdits: number = 100000
    private let root: RopeNode?
    private let version: number = 0

    constructor(text: string = ""):
        assert Text.utf8Size(text) <= TextBuffer.maxBytes else "TextBuffer content cannot exceed 16 MiB of UTF-8 text"
        self.root = ropeFromText(text)

    /// Current Unicode code-point length.
    get size() -> number:
        return self.root?.length ?? 0

    /// Current UTF-8 byte length.
    get byteSize() -> number:
        return self.root?.bytes ?? 0

    /// Current number of logical lines, including a final empty line.
    get lineCount() -> number:
        return (self.root?.newlines ?? 0) + 1

    /// Monotonic revision incremented once by every successful transaction.
    get revision() -> number:
        return self.version

    /// Materializes the current text without exposing rope storage.
    def text() -> string:
        const root = self.root
        if root == null:
            return ""
        const text = root.text
        if text != null:
            return text
        return self.slice(0, root.length)

    /// Reads one Unicode code-point range without materializing unrelated leaves.
    def slice(start: number, end: number) -> string:
        self.requireRange(start, end)
        if start == end:
            return ""
        let output: List<string> = []
        appendNodeSlice(self.root, start, end, output)
        return output.join("")

    /// Applies ordered, non-overlapping pre-revision edits as one atomic revision.
    def apply(edits: List<TextEdit>) -> TextTransaction:
        assert edits.size > 0 else "TextBuffer transaction must contain at least one edit"
        assert edits.size <= TextBuffer.maxTransactionEdits else "TextBuffer transaction cannot exceed 100000 edits"
        const beforeRevision = self.version
        let previousEnd = 0
        let first = true
        let removedBytes = 0
        let insertedBytes = 0
        let changes: List<TextChange> = []
        for edit in edits:
            self.requireRange(edit.start, edit.end)
            assert first or edit.start >= previousEnd else "TextBuffer transaction edits must be ordered and non-overlapping"
            const removed = self.slice(edit.start, edit.end)
            removedBytes += Text.utf8Size(removed)
            insertedBytes += Text.utf8Size(edit.inserted)
            changes.append({start: edit.start, removed, inserted: edit.inserted, beforeRevision, afterRevision: beforeRevision + 1})
            previousEnd = edit.end
            first = false
        assert self.byteSize - removedBytes + insertedBytes <= TextBuffer.maxBytes else "TextBuffer content cannot exceed 16 MiB of UTF-8 text"
        let nextRoot = self.root
        let index = edits.size
        while index > 0:
            index -= 1
            const edit = edits[index]
            nextRoot = replaceNode(nextRoot, edit.start, edit.end, edit.inserted)
        assert (nextRoot?.leaves ?? 0) <= TextBuffer.maxLeaves else "TextBuffer cannot exceed 1000000 leaves"
        self.root = nextRoot
        self.version += 1
        return {changes, beforeRevision, afterRevision: self.version}

    /// Replaces one range and returns its committed revision record.
    def replace(start: number, end: number, inserted: string) -> TextChange:
        return self.apply([{start, end, inserted}]).changes[0]

    /// Inserts text at one Unicode code-point offset.
    def insert(offset: number, text: string) -> TextChange:
        return self.replace(offset, offset, text)

    /// Deletes one Unicode code-point range.
    def delete(start: number, end: number) -> TextChange:
        return self.replace(start, end, "")

    /// Maps one Unicode code-point offset to a zero-based line and column.
    def positionAt(offset: number) -> TextPosition:
        self.requireOffset(offset)
        const root = self.root
        if root == null:
            return {line: 0, column: 0}
        const metrics = prefixMetrics(root, offset)
        const insideCrLf = offset > 0 and offset < self.size and self.slice(offset - 1, offset) == "\r" and self.slice(offset, offset + 1) == "\n"
        return {line: metrics.newlines, column: insideCrLf ? metrics.tail - 1 : metrics.tail}

    /// Maps one zero-based line and Unicode code-point column to an offset.
    def offsetAt(line: number, column: number) -> number:
        self.requireLine(line)
        assert column.floor() == column and column >= 0 else "TextBuffer column must be a non-negative integer"
        const content = self.lineText(line)
        assert column <= content.size else "TextBuffer column is outside the line"
        return self.lineStart(line) + column

    /// Returns one line without its line terminator.
    def lineText(line: number) -> string:
        self.requireLine(line)
        const start = self.lineStart(line)
        let end = line + 1 < self.lineCount ? self.lineStart(line + 1) - 1 : self.size
        if end > start and self.slice(end - 1, end) == "\r":
            end -= 1
        return self.slice(start, end)

    /// Reads a line-aligned viewport; endLine is exclusive and may equal lineCount.
    def lineSlice(startLine: number, endLine: number) -> TextLineSlice:
        self.requireLineBoundary(startLine)
        self.requireLineBoundary(endLine)
        assert startLine <= endLine else "TextBuffer line slice start must not exceed its end"
        const start = startLine == self.lineCount ? self.size : self.lineStart(startLine)
        const end = endLine == self.lineCount ? self.size : self.lineStart(endLine)
        return {startLine, endLine, start, end, text: self.slice(start, end)}

    private def lineStart(line: number) -> number:
        if line == 0:
            return 0
        const root = self.root
        assert root != null else "TextBuffer line is outside the document"
        return lineStartIn(root, line)

    private def requireOffset(offset: number):
        assert offset.floor() == offset and offset >= 0 and offset <= self.size else "TextBuffer offset is outside the document"

    private def requireRange(start: number, end: number):
        self.requireOffset(start)
        self.requireOffset(end)
        assert start <= end else "TextBuffer range start must not exceed its end"

    private def requireLine(line: number):
        assert line.floor() == line and line >= 0 and line < self.lineCount else "TextBuffer line is outside the document"

    private def requireLineBoundary(line: number):
        assert line.floor() == line and line >= 0 and line <= self.lineCount else "TextBuffer line boundary is outside the document"

/// Bounded undo and redo ownership for one TextBuffer, including IME edit groups.
export class TextHistory:
    private static const maxAllowedBytes: number = 256 * 1024 * 1024
    private const buffer: TextBuffer
    private const entryLimit: number
    private const byteLimit: number
    private let expectedRevision: number
    private let undoEntries: List<HistoryEntry> = []
    private let redoEntries: List<HistoryEntry> = []
    private let undoBytes: number = 0
    private let groupSteps: List<HistoryStep>? = null
    private let groupBeforeSelection: TextSelection? = null
    private let groupAfterSelection: TextSelection? = null

    constructor(buffer: TextBuffer, maxEntries: number = 1000, maxBytes: number = 32 * 1024 * 1024):
        assert maxEntries.floor() == maxEntries and maxEntries > 0 and maxEntries <= 1000000 else "TextHistory maxEntries must be an integer from 1 to 1000000"
        assert maxBytes.floor() == maxBytes and maxBytes > 0 and maxBytes <= TextHistory.maxAllowedBytes else "TextHistory maxBytes must be an integer from 1 to 256 MiB"
        self.buffer = buffer
        self.entryLimit = maxEntries
        self.byteLimit = maxBytes
        self.expectedRevision = buffer.revision

    get canUndo() -> bool:
        return self.groupSteps == null and self.undoEntries.size > 0

    get canRedo() -> bool:
        return self.groupSteps == null and self.redoEntries.size > 0

    /// Applies one edit transaction and records it, or appends it to the active group.
    def apply(edits: List<TextEdit>, beforeSelection: TextSelection? = null, afterSelection: TextSelection? = null) -> TextTransaction:
        self.requireAttached()
        self.requireSelection(beforeSelection, self.buffer.size)
        let nextSize = self.buffer.size
        for edit in edits:
            nextSize += edit.inserted.size - (edit.end - edit.start)
        self.requireSelection(afterSelection, nextSize)
        const transaction = self.buffer.apply(edits)
        const step = copyEdits(transaction.changes)
        self.expectedRevision = transaction.afterRevision
        const group = self.groupSteps
        if group != null:
            group.append(step)
            self.groupAfterSelection = copySelection(afterSelection)
            self.redoEntries = []
        else:
            self.redoEntries = []
            self.pushUndo({steps: [step], beforeSelection: copySelection(beforeSelection), afterSelection: copySelection(afterSelection), bytes: step.bytes})
        return transaction

    /// Starts a group whose edits remain individually committed but undo as one command.
    def begin(beforeSelection: TextSelection? = null):
        self.requireAttached()
        assert self.groupSteps == null else "TextHistory already has an active group"
        self.requireSelection(beforeSelection, self.buffer.size)
        self.groupSteps = []
        self.groupBeforeSelection = copySelection(beforeSelection)
        self.groupAfterSelection = copySelection(beforeSelection)

    /// Commits the active group as one bounded history entry.
    def commit(afterSelection: TextSelection? = null):
        self.requireAttached()
        const steps = self.groupSteps
        assert steps != null else "TextHistory has no active group"
        const committedSelection = afterSelection ?? self.groupAfterSelection
        self.requireSelection(committedSelection, self.buffer.size)
        const beforeSelection = self.groupBeforeSelection
        let bytes = 0
        for step in steps:
            bytes += step.bytes
        self.groupSteps = null
        self.groupBeforeSelection = null
        self.groupAfterSelection = null
        if steps.size > 0:
            self.redoEntries = []
            self.pushUndo({steps, beforeSelection, afterSelection: copySelection(committedSelection), bytes})

    /// Reverts every edit in the active group without creating an undo entry.
    def cancel() -> TextSelection?:
        self.requireAttached()
        const steps = self.groupSteps
        assert steps != null else "TextHistory has no active group"
        const selection = copySelection(self.groupBeforeSelection)
        self.revertSteps(steps)
        self.groupSteps = null
        self.groupBeforeSelection = null
        self.groupAfterSelection = null
        return selection

    /// Undoes one normal edit or one committed group.
    def undo() -> TextSelection?:
        self.requireReady()
        assert self.undoEntries.size > 0 else "TextHistory has no edit to undo"
        const entry = self.undoEntries.pop()
        self.undoBytes -= entry.bytes
        self.revertSteps(entry.steps)
        self.redoEntries.append(entry)
        return copySelection(entry.beforeSelection)

    /// Redoes one previously undone edit or group.
    def redo() -> TextSelection?:
        self.requireReady()
        assert self.redoEntries.size > 0 else "TextHistory has no edit to redo"
        const entry = self.redoEntries.pop()
        for step in entry.steps:
            const transaction = self.buffer.apply(step.forward)
            self.expectedRevision = transaction.afterRevision
        self.pushUndo(entry)
        return copySelection(entry.afterSelection)

    /// Drops history while keeping attachment to the current buffer revision.
    def clear():
        self.requireReady()
        self.undoEntries = []
        self.redoEntries = []
        self.undoBytes = 0

    private def revertSteps(steps: List<HistoryStep>):
        let index = steps.size
        while index > 0:
            index -= 1
            const transaction = self.buffer.apply(steps[index].inverse)
            self.expectedRevision = transaction.afterRevision

    private def pushUndo(entry: HistoryEntry):
        self.undoEntries.append(entry)
        self.undoBytes += entry.bytes
        while self.undoEntries.size > self.entryLimit or self.undoBytes > self.byteLimit:
            const removed = self.undoEntries.pop(0)
            self.undoBytes -= removed.bytes

    private def requireAttached():
        assert self.buffer.revision == self.expectedRevision else "TextHistory buffer revision changed outside this history"

    private def requireReady():
        self.requireAttached()
        assert self.groupSteps == null else "TextHistory cannot undo, redo, or clear an active group"

    private def requireSelection(selection: TextSelection?, size: number):
        if selection == null:
            return null
        assert selection.anchor.floor() == selection.anchor and selection.anchor >= 0 and selection.anchor <= size else "TextHistory selection anchor is outside the document"
        assert selection.head.floor() == selection.head and selection.head >= 0 and selection.head <= size else "TextHistory selection head is outside the document"
