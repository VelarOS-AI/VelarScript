import {themeLabel} from "./format.vel"
import {PanelFrame} from "./panel.vel"

export type ThemeInfo:
    name: string
    label: string

export def describeTheme(theme: string) -> ThemeInfo:
    return {name: theme, label: themeLabel(theme)}

export component StatusBadge(theme: string):
    const info = describeTheme(theme)
    return <strong class="status-badge">{info.label}</strong>

export component Panel(title: string, children: WebNode):
    return <PanelFrame title={title}>{children}</PanelFrame>
