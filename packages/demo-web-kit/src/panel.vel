const panelLook = look:
    display = grid
    gap = 12px
    padding = 20px
    border = line(1px, alpha(currentColor, 0.2))
    radius = 14px

const panelTitleLook = look:
    margin = 0
    fontSize = 1.1rem

export component PanelFrame(title: string, children: WebNode):
    return <section class="panel" look={panelLook}>
        <h2 class="panel-title" look={panelTitleLook}>{title}</h2>
        {children}
    </section>
