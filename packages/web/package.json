{
  "name": "@velarscript/web",
  "version": "0.23.1",
  "description": "The official VelarScript Web framework contract and browser runtime.",
  "license": "Apache-2.0",
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "clean": "node ../../scripts/clean-package-dist.mjs",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VelarOS-AI/VelarScript.git",
    "directory": "packages/web"
  },
  "publishConfig": {
    "access": "public"
  },
  "velar": {
    "extension": {
      "kind": "application",
      "apiVersion": "0.11",
      "manifestKey": "web",
      "extends": {}
    }
  },
  "dependencies": {
    "@velarscript/compiler": "0.23.1"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./compiler": {
      "types": "./dist/compiler.d.ts",
      "default": "./dist/compiler.js"
    },
    "./host": {
      "types": "./dist/host.d.ts",
      "default": "./dist/host.js"
    }
  }
}
