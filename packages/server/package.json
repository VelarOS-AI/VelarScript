{
  "name": "@velarscript/server",
  "version": "0.27.4",
  "description": "The official explicit-configuration VelarScript server application framework.",
  "license": "Apache-2.0",
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "clean": "node ../../scripts/clean-package-dist.mjs",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VelarOS-AI/VelarScript.git",
    "directory": "packages/server"
  },
  "publishConfig": {
    "access": "public"
  },
  "velar": {
    "extension": {
      "kind": "application",
      "apiVersion": "0.15",
      "manifestKey": "server",
      "composes": {
        "@velarscript/node": "0.16"
      }
    }
  },
  "dependencies": {
    "@velarscript/compiler": "0.27.4",
    "@velarscript/node": "0.27.4",
    "yaml": "^2.9.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./compiler": {
      "types": "./dist/compiler.d.ts",
      "default": "./dist/compiler.js"
    }
  }
}
