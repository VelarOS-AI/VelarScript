import {chunks, matches} from "velar/text"
import {TextBuffer, TextEdit} from "velar/text-buffer"

/// The source grammar selected for one ECMAScript document.
export enum ScriptLanguage:
    javascript
    typescript

/// Stable lexical categories used by syntax decoration and semantic services.
export enum ScriptTokenKind:
    identifier
    keyword
    number
    string
    template
    regexp
    comment
    punctuation
    operator

/// A diagnostic severity independent of any editor protocol.
export enum ScriptDiagnosticSeverity:
    error
    warning

/// A source-level declaration category.
export enum ScriptSymbolKind:
    variable
    constant
    function
    parameter
    class
    interface
    type
    enum
    import

/// One half-open Unicode code-point range.
export type ScriptSpan:
    start: number
    end: number

/// One lexical token. Whitespace is intentionally absent.
export type ScriptToken:
    kind: ScriptTokenKind
    start: number
    end: number
    text: string

/// One syntax or local-semantic diagnostic.
export type ScriptDiagnostic:
    code: string
    message: string
    severity: ScriptDiagnosticSeverity
    start: number
    end: number

/// One declaration with its lexical scope and lightweight inferred type.
export type ScriptSymbol:
    id: number
    name: string
    kind: ScriptSymbolKind
    start: number
    end: number
    scopeStart: number
    scopeEnd: number
    type: string

/// One resolved identifier occurrence.
export type ScriptReference:
    symbolId: number
    start: number
    end: number
    write: bool

/// One completion candidate from the visible lexical scope.
export type ScriptCompletion:
    label: string
    kind: ScriptSymbolKind
    detail: string

/// One hover result.
export type ScriptHover:
    contents: string
    start: number
    end: number

/// One rename replacement.
export type ScriptEdit:
    start: number
    end: number
    replacement: string

/// A checked rename result. Invalid names and unresolved positions are explicit.
export type ScriptRename:
    placeholder: string?
    edits: List<ScriptEdit>
    error: string?

/// The immutable-by-contract analysis snapshot for one document revision.
export type ScriptAnalysis:
    tokens: List<ScriptToken>
    diagnostics: List<ScriptDiagnostic>
    symbols: List<ScriptSymbol>
    references: List<ScriptReference>

/// Observable incremental-work evidence for one document update.
export type ScriptActivity:
    revision: number
    incremental: bool
    restartOffset: number
    codePointsRead: number
    tokensReused: number
    totalTokens: number

type ScopeInfo:
    start: number
    end: number
    parent: number?

type ScriptStructure:
    scopes: List<ScopeInfo>
    tokenScopes: List<number>
    braceScopes: Map<number, number>
    pairs: Map<number, number>

type DeclarationResult:
    symbols: List<ScriptSymbol>
    declarations: Set<number>
    names: List<Map<string, number>>

type ScriptCharacters:
    parts: List<List<string>>
    size: number

const keywords = Set([
    "as", "async", "await", "break", "case", "catch", "class", "const", "continue", "debugger",
    "default", "delete", "do", "else", "enum", "export", "extends", "false", "finally", "for", "from",
    "function", "get", "if", "implements", "import", "in", "instanceof", "interface", "let", "namespace",
    "new", "null", "of", "package", "private", "protected", "public", "readonly", "return", "satisfies",
    "set", "static", "super", "switch", "this", "throw", "true", "try", "type", "typeof", "undefined",
    "var", "void", "while", "with", "yield",
])

def isTypeScriptDeclarationKeyword(value: string) -> bool:
    return value == "interface" or value == "type" or value == "enum" or value == "namespace"

def isAssignmentOperator(value: string) -> bool:
    return value == "=" or value == "+=" or value == "-=" or value == "*=" or value == "/=" or value == "%=" or value == "&&=" or value == "||=" or value == "??=" or value == "**="

def isPunctuation(value: string) -> bool:
    return value == "(" or value == ")" or value == "[" or value == "]" or value == "{" or value == "}" or value == "," or value == ";" or value == ":" or value == "."

def isMultiOperator(value: string) -> bool:
    if value == "===" or value == "!==" or value == ">>>" or value == "**=" or value == "&&=" or value == "||=" or value == "??=" or value == "..." or value == ">>>=":
        return true
    return value == "=>" or value == "==" or value == "!=" or value == "<=" or value == ">=" or value == "++" or value == "--" or value == "&&" or value == "||" or value == "??" or value == "?." or value == "**" or value == "<<" or value == ">>" or value == "+=" or value == "-=" or value == "*=" or value == "/=" or value == "%=" or value == "&=" or value == "|=" or value == "^=" or value == "<<=" or value == ">>="

def isAsciiLetter(value: string) -> bool:
    return (value >= "A" and value <= "Z") or (value >= "a" and value <= "z")

def isAscii(value: string) -> bool:
    return value.size == 1 and value < ""

def isDigit(value: string) -> bool:
    return value >= "0" and value <= "9"

def isIdentifierStart(value: string) -> bool:
    if value == "$" or value == "_" or isAsciiLetter(value):
        return true
    if isAscii(value):
        return false
    return value.size == 1 and matches(value, "^\\p{ID_Start}$")

def isIdentifierPart(value: string) -> bool:
    if isIdentifierStart(value) or isDigit(value):
        return true
    if isAscii(value):
        return false
    return value.size == 1 and matches(value, r"^[\p{ID_Continue}\u200c\u200d]$")

def isLineBreak(value: string) -> bool:
    if value == "\r" or value == "\n":
        return true
    if isAscii(value):
        return false
    return value.size == 1 and matches(value, r"^[\u2028\u2029]$")

def isSpace(value: string) -> bool:
    if value == " " or value == "\t" or value == "\r" or value == "\n":
        return true
    if isAscii(value):
        return false
    return value.size == 1 and matches(value, r"^\s$")

def requiredChar(value: string, index: number) -> string:
    const result = value.char(index)
    assert result != null else "Script character offset is outside the source"
    return result

// A character list spells as split(""): the empty separator splits per
// Unicode code point. The 4096-per-chunk layer stays only for capacity —
// one List is bounded to 1,000,000 items while a ScriptDocument accepts
// 16 million code points (4096 chunks of 4096 characters). Extending a
// fresh List materializes each chunk once so the hot per-character reads
// stay O(1).
def sourceCharacters(source: string) -> ScriptCharacters:
    let output: List<List<string>> = []
    for part in chunks(source, 4096):
        let values: List<string> = []
        values.extend(part.split(""))
        output.append(values)
    return {parts: output, size: source.size}

def sourceAt(source: ScriptCharacters, index: number) -> string:
    assert index.isInteger() and index >= 0 and index < source.size else "Script character offset is outside the source"
    const part = source.parts[(index / 4096).floor()]
    return part[index % 4096]

def sourceText(source: ScriptCharacters, start: number, end: number) -> string:
    assert start.isInteger() and end.isInteger() and start >= 0 and start <= end and end <= source.size else "Script character range is outside the source"
    let output: List<string> = []
    let cursor = start
    while cursor < end:
        const part = source.parts[(cursor / 4096).floor()]
        const local = cursor % 4096
        const available = part.size - local
        const count = end - cursor < available ? end - cursor : available
        output.append(part.slice(local, local + count).join(""))
        cursor += count
    return output.join("")

def appendToken(output: List<ScriptToken>, characters: ScriptCharacters, kind: ScriptTokenKind, start: number, end: number, base: number) -> null:
    output.append({kind, start: base + start, end: base + end, text: sourceText(characters, start, end)})

def appendDiagnostic(output: List<ScriptDiagnostic>, code: string, message: string, start: number, end: number, base: number = 0) -> null:
    output.append({code, message, severity: ScriptDiagnosticSeverity.error, start: base + start, end: base + end})

def tokenText(token: ScriptToken) -> string:
    return token.text

def previousAllowsRegexp(tokens: List<ScriptToken>) -> bool:
    if tokens.size == 0:
        return true
    const token = tokens[-1]
    const value = tokenText(token)
    if token.kind == ScriptTokenKind.identifier or token.kind == ScriptTokenKind.number or token.kind == ScriptTokenKind.string or token.kind == ScriptTokenKind.template or token.kind == ScriptTokenKind.regexp:
        return false
    if value == ")" or value == "]" or value == "}" or value == "++" or value == "--":
        return false
    return true

def scanRegexp(source: ScriptCharacters, start: number) -> number:
    let index = start + 1
    let escaped = false
    let characterClass = false
    while index < source.size:
        const value = sourceAt(source, index)
        if isLineBreak(value):
            return start
        if escaped:
            escaped = false
        else if value == "\\":
            escaped = true
        else if value == "[":
            characterClass = true
        else if value == "]":
            characterClass = false
        else if value == "/" and not characterClass:
            index += 1
            while index < source.size and isIdentifierPart(sourceAt(source, index)):
                index += 1
            return index
        index += 1
    return start

def lexScript(source: ScriptCharacters, base: number, diagnostics: List<ScriptDiagnostic>) -> List<ScriptToken>:
    let output: List<ScriptToken> = []
    let index = 0
    while index < source.size:
        const value = sourceAt(source, index)
        if isSpace(value):
            index += 1
            continue
        if value == "/" and index + 1 < source.size and sourceAt(source, index + 1) == "/":
            const start = index
            index += 2
            while index < source.size and not isLineBreak(sourceAt(source, index)):
                index += 1
            appendToken(output, source, ScriptTokenKind.comment, start, index, base)
            continue
        if value == "/" and index + 1 < source.size and sourceAt(source, index + 1) == "*":
            const start = index
            index += 2
            let closed = false
            while index + 1 < source.size:
                if sourceAt(source, index) == "*" and sourceAt(source, index + 1) == "/":
                    index += 2
                    closed = true
                    break
                index += 1
            if not closed:
                index = source.size
                appendDiagnostic(diagnostics, "SCRIPT1001", "Unterminated block comment", start, index, base)
            appendToken(output, source, ScriptTokenKind.comment, start, index, base)
            continue
        if value == "\"" or value == "'":
            const start = index
            const quote = value
            index += 1
            let escaped = false
            let closed = false
            while index < source.size:
                const current = sourceAt(source, index)
                if isLineBreak(current) and not escaped:
                    break
                if escaped:
                    escaped = false
                else if current == "\\":
                    escaped = true
                else if current == quote:
                    index += 1
                    closed = true
                    break
                index += 1
            if not closed:
                appendDiagnostic(diagnostics, "SCRIPT1002", "Unterminated string literal", start, index > start ? index : start + 1, base)
            appendToken(output, source, ScriptTokenKind.string, start, index, base)
            continue
        if value == "`":
            const start = index
            index += 1
            let escaped = false
            let closed = false
            while index < source.size:
                const current = sourceAt(source, index)
                if escaped:
                    escaped = false
                else if current == "\\":
                    escaped = true
                else if current == "`":
                    index += 1
                    closed = true
                    break
                index += 1
            if not closed:
                appendDiagnostic(diagnostics, "SCRIPT1003", "Unterminated template literal", start, index, base)
            appendToken(output, source, ScriptTokenKind.template, start, index, base)
            continue
        if isDigit(value) or (value == "." and index + 1 < source.size and isDigit(sourceAt(source, index + 1))):
            const start = index
            index += 1
            while index < source.size:
                const current = sourceAt(source, index)
                if isIdentifierPart(current) or isDigit(current) or current == "." or current == "_":
                    index += 1
                else:
                    break
            appendToken(output, source, ScriptTokenKind.number, start, index, base)
            continue
        if isIdentifierStart(value) or (value == "#" and index + 1 < source.size and isIdentifierStart(sourceAt(source, index + 1))):
            const start = index
            index += 1
            while index < source.size and isIdentifierPart(sourceAt(source, index)):
                index += 1
            const text = sourceText(source, start, index)
            appendToken(output, source, text in keywords ? ScriptTokenKind.keyword : ScriptTokenKind.identifier, start, index, base)
            continue
        if value == "/" and previousAllowsRegexp(output):
            const end = scanRegexp(source, index)
            if end > index:
                appendToken(output, source, ScriptTokenKind.regexp, index, end, base)
                index = end
                continue
        let end = index + 1
        if index + 4 <= source.size and isMultiOperator(sourceText(source, index, index + 4)):
            end = index + 4
        else if index + 3 <= source.size and isMultiOperator(sourceText(source, index, index + 3)):
            end = index + 3
        else if index + 2 <= source.size and isMultiOperator(sourceText(source, index, index + 2)):
            end = index + 2
        const text = sourceText(source, index, end)
        appendToken(output, source, isPunctuation(text) ? ScriptTokenKind.punctuation : ScriptTokenKind.operator, index, end, base)
        index = end
    return output

def openingFor(value: string) -> string?:
    if value == ")":
        return "("
    if value == "]":
        return "["
    if value == "}":
        return "{"
    return null

def matchingClose(value: string) -> string:
    if value == "(":
        return ")"
    if value == "[":
        return "]"
    return "}"

def buildStructure(sourceSize: number, tokens: List<ScriptToken>, diagnostics: List<ScriptDiagnostic>) -> ScriptStructure:
    let scopes: List<ScopeInfo> = [{start: 0, end: sourceSize, parent: null}]
    let tokenScopes: List<number> = []
    let braceScopes: Map<number, number> = Map()
    let pairs: Map<number, number> = Map()
    let scopeStack: List<number> = [0]
    let delimiterTokens: List<number> = []
    let delimiterValues: List<string> = []
    let tokenIndex = 0
    for token in tokens:
        const value = tokenText(token)
        const currentScope = scopeStack[-1]
        tokenScopes.append(currentScope)
        if value == "(" or value == "[" or value == "{":
            delimiterTokens.append(tokenIndex)
            delimiterValues.append(value)
            if value == "{":
                const scopeId = scopes.size
                scopes.append({start: token.end, end: sourceSize, parent: currentScope})
                braceScopes.set(tokenIndex, scopeId)
                scopeStack.append(scopeId)
        else:
            const expected = openingFor(value)
            if expected != null:
                if delimiterValues.size == 0:
                    appendDiagnostic(diagnostics, "SCRIPT1101", f"Unexpected closing delimiter '{value}'", token.start, token.end)
                else if delimiterValues[-1] != expected:
                    appendDiagnostic(diagnostics, "SCRIPT1102", f"Expected '{matchingClose(delimiterValues[-1])}' before '{value}'", token.start, token.end)
                else:
                    const openingIndex = delimiterTokens.removeLast()
                    pairs.set(openingIndex, tokenIndex)
                    pairs.set(tokenIndex, openingIndex)
                    delimiterValues.removeLast()
                    if value == "}" and scopeStack.size > 1:
                        const scopeId = scopeStack.removeLast()
                        scopes[scopeId].end = token.start
        tokenIndex += 1
    for openingIndex in delimiterTokens:
        const opening = tokens[openingIndex]
        appendDiagnostic(diagnostics, "SCRIPT1103", f"Unterminated delimiter '{tokenText(opening)}'", opening.start, opening.end)
    return {scopes, tokenScopes, braceScopes, pairs}

def symbolTypeFromInitializer(tokens: List<ScriptToken>, index: number) -> string:
    if index >= tokens.size:
        return "unknown"
    const token = tokens[index]
    const value = tokenText(token)
    if token.kind == ScriptTokenKind.string or token.kind == ScriptTokenKind.template:
        return "string"
    if token.kind == ScriptTokenKind.number:
        return "number"
    if value == "true" or value == "false":
        return "boolean"
    if value == "null":
        return "null"
    if value == "[":
        return "unknown[]"
    if value == "{":
        return "object"
    if value == "function" or value == "async" or value == "(":
        return "function"
    if value == "new" and index + 1 < tokens.size:
        return tokenText(tokens[index + 1])
    return "unknown"

def annotatedType(tokens: List<ScriptToken>, index: number) -> string?:
    if index >= tokens.size or tokenText(tokens[index]) != ":":
        return null
    let parts: List<string> = []
    let cursor = index + 1
    let depth = 0
    while cursor < tokens.size:
        const value = tokenText(tokens[cursor])
        if depth == 0 and (value == "=" or value == "," or value == ";" or value == ")" or value == "{"):
            break
        if value == "<" or value == "(" or value == "[":
            depth += 1
        else if (value == ">" or value == ")" or value == "]") and depth > 0:
            depth -= 1
        parts.append(value)
        cursor += 1
    return parts.size == 0 ? null : parts.join(" ")

def declareSymbol(symbols: List<ScriptSymbol>, names: List<Map<string, number>>, diagnostics: List<ScriptDiagnostic>, scopes: List<ScopeInfo>, name: string, kind: ScriptSymbolKind, token: ScriptToken, scopeId: number, typeName: string) -> number:
    const existing = names[scopeId].get(name)
    if existing != null:
        appendDiagnostic(diagnostics, "SCRIPT2001", f"Duplicate declaration '{name}' in the same scope", token.start, token.end)
    const id = symbols.size
    const scope = scopes[scopeId]
    symbols.append({id, name, kind, start: token.start, end: token.end, scopeStart: scope.start, scopeEnd: scope.end, type: typeName})
    names[scopeId].set(name, id)
    return id

def bindingKind(value: string) -> ScriptSymbolKind:
    return value == "const" ? ScriptSymbolKind.constant : ScriptSymbolKind.variable

def declarationType(tokens: List<ScriptToken>, nameIndex: number) -> string:
    const annotation = annotatedType(tokens, nameIndex + 1)
    if annotation != null:
        return annotation
    let cursor = nameIndex + 1
    while cursor < tokens.size and tokenText(tokens[cursor]) != "," and tokenText(tokens[cursor]) != ";":
        if tokenText(tokens[cursor]) == "=":
            return symbolTypeFromInitializer(tokens, cursor + 1)
        cursor += 1
    return "unknown"

def declareParameters(tokens: List<ScriptToken>, structure: ScriptStructure, openIndex: number, closeIndex: number, scopeId: number, symbols: List<ScriptSymbol>, names: List<Map<string, number>>, declarations: Set<number>, diagnostics: List<ScriptDiagnostic>) -> null:
    let index = openIndex + 1
    let expectName = true
    while index < closeIndex:
        const token = tokens[index]
        const value = tokenText(token)
        if expectName and token.kind == ScriptTokenKind.identifier:
            const typeName = annotatedType(tokens, index + 1) ?? "unknown"
            declareSymbol(symbols, names, diagnostics, structure.scopes, value, ScriptSymbolKind.parameter, token, scopeId, typeName)
            declarations.add(index)
            expectName = false
        else if value == ",":
            expectName = true
        index += 1

def buildDeclarations(language: ScriptLanguage, tokens: List<ScriptToken>, structure: ScriptStructure, diagnostics: List<ScriptDiagnostic>) -> DeclarationResult:
    let symbols: List<ScriptSymbol> = []
    let declarations: Set<number> = Set()
    let names: List<Map<string, number>> = []
    for scope in structure.scopes:
        let values: Map<string, number> = Map()
        names.append(values)
    let index = 0
    while index < tokens.size:
        const token = tokens[index]
        const value = tokenText(token)
        const scopeId = structure.tokenScopes[index]
        if language == ScriptLanguage.javascript and isTypeScriptDeclarationKeyword(value):
            appendDiagnostic(diagnostics, "SCRIPT1201", f"'{value}' declarations require a TypeScript document", token.start, token.end)
        if value == "const" or value == "let" or value == "var":
            let cursor = index + 1
            let expectName = true
            while cursor < tokens.size:
                const current = tokens[cursor]
                const currentValue = tokenText(current)
                if currentValue == ";" or currentValue == ")" or currentValue == "in" or currentValue == "of":
                    break
                if expectName and current.kind == ScriptTokenKind.identifier:
                    declareSymbol(symbols, names, diagnostics, structure.scopes, currentValue, bindingKind(value), current, scopeId, declarationType(tokens, cursor))
                    declarations.add(cursor)
                    expectName = false
                else if currentValue == ",":
                    expectName = true
                cursor += 1
        else if value == "function" and index + 1 < tokens.size:
            let nameIndex = index + 1
            if tokenText(tokens[nameIndex]) == "*":
                nameIndex += 1
            if nameIndex < tokens.size and tokens[nameIndex].kind == ScriptTokenKind.identifier:
                const nameToken = tokens[nameIndex]
                const name = tokenText(nameToken)
                declareSymbol(symbols, names, diagnostics, structure.scopes, name, ScriptSymbolKind.function, nameToken, scopeId, "function")
                declarations.add(nameIndex)
                let openIndex = nameIndex + 1
                while openIndex < tokens.size and tokenText(tokens[openIndex]) != "(":
                    openIndex += 1
                const closeIndex = structure.pairs.get(openIndex)
                if closeIndex != null:
                    let bodyIndex = closeIndex + 1
                    while bodyIndex < tokens.size and tokenText(tokens[bodyIndex]) != "{":
                        bodyIndex += 1
                    const bodyScope = structure.braceScopes.get(bodyIndex)
                    if bodyScope != null:
                        declareParameters(tokens, structure, openIndex, closeIndex, bodyScope, symbols, names, declarations, diagnostics)
        else if value == "class" or value == "interface" or value == "type" or value == "enum":
            if index + 1 < tokens.size and tokens[index + 1].kind == ScriptTokenKind.identifier:
                const nameToken = tokens[index + 1]
                const name = tokenText(nameToken)
                const kind = value == "class" ? ScriptSymbolKind.class : value == "interface" ? ScriptSymbolKind.interface : value == "enum" ? ScriptSymbolKind.enum : ScriptSymbolKind.type
                declareSymbol(symbols, names, diagnostics, structure.scopes, name, kind, nameToken, scopeId, name)
                declarations.add(index + 1)
        else if value == "import":
            let cursor = index + 1
            while cursor < tokens.size and tokenText(tokens[cursor]) != ";" and tokenText(tokens[cursor]) != "from":
                const current = tokens[cursor]
                const currentValue = tokenText(current)
                const previous = cursor > index + 1 ? tokenText(tokens[cursor - 1]) : ""
                if current.kind == ScriptTokenKind.identifier and previous != "as" and previous != ".":
                    let localIndex = cursor
                    if cursor + 2 < tokens.size and tokenText(tokens[cursor + 1]) == "as" and tokens[cursor + 2].kind == ScriptTokenKind.identifier:
                        localIndex = cursor + 2
                        cursor += 2
                    const local = tokens[localIndex]
                    const localName = tokenText(local)
                    declareSymbol(symbols, names, diagnostics, structure.scopes, localName, ScriptSymbolKind.import, local, scopeId, "import")
                    declarations.add(localIndex)
                cursor += 1
        index += 1
    return {symbols, declarations, names}

def visibleSymbol(name: string, useScope: number, symbols: List<ScriptSymbol>, scopes: List<ScopeInfo>, names: List<Map<string, number>>) -> ScriptSymbol?:
    let current: number? = useScope
    while current != null:
        const id = names[current].get(name)
        if id != null:
            return symbols[id]
        current = scopes[current].parent
    return null

def buildReferences(tokens: List<ScriptToken>, structure: ScriptStructure, declarations: Set<number>, symbols: List<ScriptSymbol>, names: List<Map<string, number>>) -> List<ScriptReference>:
    let output: List<ScriptReference> = []
    let index = 0
    while index < tokens.size:
        const token = tokens[index]
        if token.kind == ScriptTokenKind.identifier and not declarations.has(index):
            const previous = index > 0 ? tokenText(tokens[index - 1]) : ""
            const next = index + 1 < tokens.size ? tokenText(tokens[index + 1]) : ""
            if previous != "." and previous != "?." and not (next == ":" and previous != "?"):
                const name = tokenText(token)
                const symbol = visibleSymbol(name, structure.tokenScopes[index], symbols, structure.scopes, names)
                if symbol != null:
                    output.append({symbolId: symbol.id, start: token.start, end: token.end, write: isAssignmentOperator(next)})
        index += 1
    return output

def analyzeScript(language: ScriptLanguage, sourceSize: number, tokens: List<ScriptToken>, lexicalDiagnostics: List<ScriptDiagnostic>) -> ScriptAnalysis:
    let diagnostics = lexicalDiagnostics.slice()
    const structure = buildStructure(sourceSize, tokens, diagnostics)
    const declarations = buildDeclarations(language, tokens, structure, diagnostics)
    const references = buildReferences(tokens, structure, declarations.declarations, declarations.symbols, declarations.names)
    return {tokens: tokens.slice(), diagnostics, symbols: declarations.symbols, references}

def isIdentifierName(value: string) -> bool:
    if value.size == 0 or not isIdentifierStart(requiredChar(value, 0)) or value in keywords:
        return false
    let index = 1
    while index < value.size:
        if not isIdentifierPart(requiredChar(value, index)):
            return false
        index += 1
    return true

/// A pure VelarScript incremental lexical and local-semantic owner for one JS/TS document.
export class ScriptDocument:
    const language: ScriptLanguage
    private const buffer: TextBuffer
    private let revisionValue: number = 1
    private let tokenCache: List<ScriptToken>
    private let lexicalDiagnostics: List<ScriptDiagnostic>
    private let analysisCache: ScriptAnalysis
    private let activityCache: ScriptActivity

    constructor(language: ScriptLanguage, source: string):
        assert source.size <= 16 * 1024 * 1024 else "ScriptDocument cannot exceed 16 million code points"
        self.language = language
        self.buffer = TextBuffer(source)
        self.lexicalDiagnostics = []
        self.tokenCache = lexScript(sourceCharacters(source), 0, self.lexicalDiagnostics)
        self.analysisCache = analyzeScript(language, self.buffer.size, self.tokenCache, self.lexicalDiagnostics)
        self.activityCache = {revision: 1, incremental: false, restartOffset: 0, codePointsRead: source.size, tokensReused: 0, totalTokens: self.tokenCache.size}

    get revision() -> number:
        return self.revisionValue

    get text() -> string:
        return self.buffer.text()

    def analysis() -> readonly ScriptAnalysis:
        return self.analysisCache

    def activity() -> readonly ScriptActivity:
        return self.activityCache

    /// Computes one bounded replacement and delegates to the edit-native owner.
    def update(source: string) -> readonly ScriptActivity:
        assert source.size <= 16 * 1024 * 1024 else "ScriptDocument cannot exceed 16 million code points"
        const previous = sourceCharacters(self.buffer.text())
        const next = sourceCharacters(source)
        let prefix = 0
        const limit = next.size < previous.size ? next.size : previous.size
        while prefix < limit and sourceAt(next, prefix) == sourceAt(previous, prefix):
            prefix += 1
        let suffix = 0
        while suffix < limit - prefix and sourceAt(next, next.size - suffix - 1) == sourceAt(previous, previous.size - suffix - 1):
            suffix += 1
        if prefix == previous.size and prefix == next.size:
            return self.activityCache
        return self.apply([{start: prefix, end: previous.size - suffix, replacement: sourceText(next, prefix, next.size - suffix)}])

    /// Applies ordered pre-revision edits atomically and only materializes the affected suffix.
    def apply(edits: readonly List<ScriptEdit>) -> readonly ScriptActivity:
        assert edits.size > 0 else "ScriptDocument update must contain at least one edit"
        let bufferEdits: List<TextEdit> = []
        let previousEnd = 0
        let first = true
        for edit in edits:
            assert edit.start.floor() == edit.start and edit.end.floor() == edit.end and edit.start >= 0 and edit.end <= self.buffer.size else "Script edit is outside the document"
            assert edit.start <= edit.end else "Script edit start must not exceed its end"
            assert first or edit.start >= previousEnd else "Script edits must be ordered and non-overlapping"
            bufferEdits.append({start: edit.start, end: edit.end, inserted: edit.replacement})
            previousEnd = edit.end
            first = false

        const earliest = edits[0].start
        let restart = earliest
        let previousToken: number? = null
        let index = 0
        for token in self.tokenCache:
            if token.end < earliest:
                previousToken = index
            else if token.end == earliest:
                if earliest > 0 and not isSpace(self.buffer.slice(earliest - 1, earliest)):
                    restart = token.start
                break
            else if token.start < earliest:
                restart = token.start
                break
            else:
                if earliest > 0 and not isSpace(self.buffer.slice(earliest - 1, earliest)) and previousToken != null:
                    restart = self.tokenCache[previousToken].start
                break
            index += 1

        let reused = 0
        for token in self.tokenCache:
            if token.end <= restart:
                reused += 1
            else:
                break
        let tokens = self.tokenCache.slice(0, reused)
        let diagnostics = self.lexicalDiagnostics.filter(item => item.end <= restart)
        self.buffer.apply(bufferEdits)
        assert self.buffer.size <= 16 * 1024 * 1024 else "ScriptDocument cannot exceed 16 million code points"
        const suffixSource = self.buffer.slice(restart, self.buffer.size)
        for token in lexScript(sourceCharacters(suffixSource), restart, diagnostics):
            tokens.append(token)
        self.tokenCache = tokens
        self.lexicalDiagnostics = diagnostics
        self.revisionValue += 1
        self.analysisCache = analyzeScript(self.language, self.buffer.size, tokens, diagnostics)
        self.activityCache = {
            revision: self.revisionValue,
            incremental: restart > 0,
            restartOffset: restart,
            codePointsRead: self.buffer.size - restart,
            tokensReused: reused,
            totalTokens: tokens.size,
        }
        return self.activityCache

    def tokenAt(offset: number) -> readonly ScriptToken?:
        assert offset.floor() == offset and offset >= 0 and offset <= self.buffer.size else "Script offset is outside the document"
        for token in self.tokenCache:
            if offset >= token.start and offset < token.end:
                return token
        return null

    def symbolAt(offset: number) -> readonly ScriptSymbol?:
        assert offset.floor() == offset and offset >= 0 and offset <= self.buffer.size else "Script offset is outside the document"
        for symbol in self.analysisCache.symbols:
            if offset >= symbol.start and offset < symbol.end:
                return symbol
        for reference in self.analysisCache.references:
            if offset >= reference.start and offset < reference.end:
                return self.analysisCache.symbols[reference.symbolId]
        return null

    def definitionAt(offset: number) -> readonly ScriptSpan?:
        const symbol = self.symbolAt(offset)
        return symbol == null ? null : {start: symbol.start, end: symbol.end}

    def referencesAt(offset: number, includeDeclaration: bool = true) -> readonly List<ScriptSpan>:
        const symbol = self.symbolAt(offset)
        if symbol == null:
            return []
        let output: List<ScriptSpan> = includeDeclaration ? [{start: symbol.start, end: symbol.end}] : []
        for reference in self.analysisCache.references:
            if reference.symbolId == symbol.id:
                output.append({start: reference.start, end: reference.end})
        return output

    def hoverAt(offset: number) -> readonly ScriptHover?:
        const symbol = self.symbolAt(offset)
        if symbol == null:
            return null
        return {contents: f"{symbol.kind} {symbol.name}: {symbol.type}", start: symbol.start, end: symbol.end}

    def completionsAt(offset: number) -> readonly List<ScriptCompletion>:
        assert offset.floor() == offset and offset >= 0 and offset <= self.buffer.size else "Script offset is outside the document"
        let output: List<ScriptCompletion> = []
        let seen: Set<string> = Set()
        for symbol in self.analysisCache.symbols:
            if offset >= symbol.scopeStart and offset <= symbol.scopeEnd and not seen.has(symbol.name):
                output.append({label: symbol.name, kind: symbol.kind, detail: symbol.type})
                seen.add(symbol.name)
        return output.sorted(by = item => item.label)

    def renameAt(offset: number, replacement: string) -> readonly ScriptRename:
        const symbol = self.symbolAt(offset)
        if symbol == null:
            return {placeholder: null, edits: [], error: "No resolvable local symbol exists at this position"}
        if not isIdentifierName(replacement):
            return {placeholder: symbol.name, edits: [], error: f"'{replacement}' is not a valid JavaScript identifier"}
        let edits: List<ScriptEdit> = [{start: symbol.start, end: symbol.end, replacement}]
        for reference in self.analysisCache.references:
            if reference.symbolId == symbol.id:
                edits.append({start: reference.start, end: reference.end, replacement})
        return {placeholder: symbol.name, edits, error: null}
