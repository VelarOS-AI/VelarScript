{
  "name": "@velarscript/cli",
  "version": "0.26.0",
  "description": "The VelarScript command-line compiler, dev server, test runner, and language server.",
  "license": "Apache-2.0",
  "type": "module",
  "files": [
    "dist",
    "skill",
    "README.md"
  ],
  "scripts": {
    "clean": "node ../../scripts/clean-package-dist.mjs",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "postbuild": "node ../../scripts/mark-package-bin.mjs dist/cli.js",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VelarOS-AI/VelarScript.git",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "velar": "./dist/cli.js"
  },
  "dependencies": {
    "@velarscript/compiler": "0.26.0",
    "@velarscript/core": "0.26.0",
    "@velarscript/node": "0.26.0",
    "create-velar": "0.26.0",
    "esbuild": "^0.28.1"
  },
  "peerDependencies": {
    "@velarscript/desktop": "0.26.0",
    "@velarscript/server": "0.26.0",
    "@velarscript/web": "0.26.0",
    "playwright": "^1.58.2"
  },
  "peerDependenciesMeta": {
    "@velarscript/desktop": {
      "optional": true
    },
    "@velarscript/server": {
      "optional": true
    },
    "@velarscript/web": {
      "optional": true
    },
    "playwright": {
      "optional": true
    }
  }
}
