{
  "name": "velarscript-workspace",
  "version": "0.10.3",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build:packages": "node scripts/gate-lock.mjs npm run gate:build:packages",
    "check": "node scripts/gate-lock.mjs npm run gate:check",
    "check:boundaries": "node scripts/check-runtime-boundary.mjs",
    "check:format": "node scripts/check-velar-format.mjs",
    "check:docs": "node scripts/check-documentation-examples.mjs",
    "check:projects": "node scripts/check-project-builds.mjs",
    "check:tour-coverage": "node scripts/check-tour-coverage.mjs",
    "test": "node scripts/gate-lock.mjs npm run gate:test",
    "test:browser": "node scripts/gate-lock.mjs npm run gate:test:browser",
    "test:packages": "node scripts/gate-lock.mjs npm run gate:test:packages",
    "release:rehearse": "node scripts/release-toolchain.mjs rehearse",
    "release:verify": "node scripts/release-toolchain.mjs verify",
    "release:publish": "node scripts/publish-toolchain.mjs",
    "preview:prepare": "node scripts/prepare-external-preview.mjs",
    "velar": "node scripts/gate-lock.mjs npm run --silent gate:velar --",
    "gate:build:packages": "node scripts/build-packages.mjs",
    "gate:check": "npm run build:packages && npm run check:format && npm run check:docs && npm run check:boundaries && npm run check:projects && npm run check:tour-coverage && tsc -p tsconfig.json",
    "gate:test": "npm run build:packages && node --test --test-concurrency=1 --test-timeout=120000 tests/*.test.ts tests/ci.acceptance.ts tests/release.acceptance.ts && node scripts/run-project-gate.mjs unit",
    "gate:test:browser": "npm run build:packages && node tests/browser.acceptance.ts && node scripts/run-project-gate.mjs browser && node tests/installed-browser.acceptance.ts",
    "gate:test:packages": "npm run build:packages && node tests/package.acceptance.ts",
    "gate:velar": "npm run build:packages --silent && node packages/cli/dist/cli.js"
  },
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VelarOS-AI/VelarScript.git"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/ws": "^8.18.1",
    "@velaros-ai/project": "2.0.1",
    "playwright": "^1.58.2",
    "typescript": "^7.0.2"
  }
}
